<% if (scene === 'analyse') { %>
<div class="tactics-board">
  <div class="art-topline"><span><i></i> MATCH INSIGHTS</span><span>AVANT-MATCH</span></div>
  <div class="tactics-pitch"><svg viewBox="0 0 400 240"><g class="pitch-lines"><rect x="12" y="12" width="376" height="216" rx="2"/><path d="M200 12V228M12 67H70V173H12M388 67H330V173H388"/><circle cx="200" cy="120" r="40"/></g><path class="tactics-route" d="M65 120L140 62L203 130L275 61L348 120"/><g class="pitch-players"><circle cx="65" cy="120" r="9"/><circle cx="140" cy="62" r="9"/><circle cx="203" cy="130" r="9"/><circle cx="275" cy="61" r="9"/><circle cx="348" cy="120" r="9"/></g><g class="pitch-opponents"><circle cx="100" cy="177" r="7"/><circle cx="175" cy="87" r="7"/><circle cx="247" cy="177" r="7"/><circle cx="302" cy="133" r="7"/></g></svg></div>
  <div class="art-data-row"><span>Compositions<strong>Le collectif</strong></span><span>Forme récente<strong>La dynamique</strong></span><span>Face-à-face<strong>Le contexte</strong></span></div>
</div>
<div class="art-floating-tag"><span class="mini-spark">✳</span> Chaque détail compte.</div>
<% } else if (scene === 'direct') { %>
<div class="match-radar"><span></span><span></span><span></span></div>
<div class="live-demo-card"><div class="art-topline"><span><i></i> SUIVI DU MATCH</span><span>ILLUSTRATION</span></div><div class="demo-match"><div class="demo-team"><span>A</span>Équipe A</div><div class="demo-score">2 <span>:</span> 1<small>2e mi-temps</small></div><div class="demo-team"><span>B</span>Équipe B</div></div><div class="match-timeline"><span></span><i></i></div><div class="demo-event"><span class="note-icon"><%- include('icon', { name: 'ball', size: 21 }) %></span><div><strong>Au plus près du match</strong><small>Scores actualisés dans l’application</small></div></div></div>
<div class="art-floating-tag"><%- include('icon', { name: 'bell', size: 18 }) %> Le résultat. Directement notifié.</div>
<% } else { %>
<div class="balance-demo"><div class="art-topline"><span>VOTRE SUIVI PERSONNEL</span><%- include('icon', { name: 'wallet', size: 21 }) %></div><div class="balance-heading">Du recul.<br><span>À chaque match.</span></div><div class="balance-chart"><svg viewBox="0 0 400 140"><defs><linearGradient id="balance-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ff8a45" stop-opacity=".2"/><stop offset="1" stop-color="#ff8a45" stop-opacity="0"/></linearGradient></defs><path d="M0 90H400M0 45H400" class="chart-grid"/><path d="M0 90L40 70L80 84L120 40L160 65L200 55L240 75L280 49L320 64L360 81L400 71V140H0Z" fill="url(#balance-fill)"/><path d="M0 90L40 70L80 84L120 40L160 65L200 55L240 75L280 49L320 64L360 81L400 71" class="chart-line"/></svg></div><div class="balance-pills"><span>Budget</span><span>Mises</span><span>Historique</span></div></div>
<div class="art-floating-tag"><%- include('icon', { name: 'shield', size: 18 }) %> Votre budget reste votre repère.</div>
<% } %>
