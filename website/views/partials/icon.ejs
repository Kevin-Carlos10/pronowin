  const _cls = typeof cls !== 'undefined' ? cls : '';
  const icons = {
    chart: '<path d="M4 19V10M11 19V5M18 19v-7"/><path d="M2 19h20"/>',
    crown: '<path d="M3 8l4 3 5-6 5 6 4-3-2 10H5L3 8z"/><path d="M5 21h14"/>',
    wallet: '<path d="M3 7a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v1h1a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/><circle cx="16.5" cy="13.5" r="1.2" fill="currentColor" stroke="none"/>',
    users: '<circle cx="8.5" cy="8" r="3.2"/><path d="M2.5 20c0-3.6 2.9-6 6-6s6 2.4 6 6"/><circle cx="17" cy="9" r="2.4"/><path d="M15.3 14.2c2.4.3 4.2 2.4 4.2 5.8"/>',
