    arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
    facebook: '<path d="M14 9h3V5h-3c-2.2 0-4 1.8-4 4v2H8v4h2v6h4v-6h3l1-4h-4V9c0-.6.4-1 1-1z"/>',
    x: '<path d="M4 4l16 16M20 4L4 20"/>',
    instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/>',
    whatsapp: '<path d="M4 20l1.4-4.1A8 8 0 1 1 9 18.6L4 20z"/><path d="M9 10c0 3 2 5 5 5"/>',
    linkedin: '<rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8" cy="8.5" r="1" fill="currentColor" stroke="none"/><path d="M8 11v6M12 17v-4c0-1.4 1-2.3 2.2-2.3S16 11.6 16 13v4"/>',
    // Marque Apple : elle doit etre pleine. Tracee en contour comme le reste
    // des icones, elle donnait une forme meconnaissable.
    apple: '<path d="M17.05 12.53c-.02-2.2 1.8-3.26 1.88-3.31-1.03-1.5-2.62-1.71-3.19-1.73-1.36-.14-2.65.8-3.34.8-.69 0-1.75-.78-2.88-.76-1.48.02-2.85.86-3.61 2.18-1.54 2.67-.39 6.62 1.11 8.79.73 1.06 1.6 2.25 2.74 2.21 1.1-.04 1.52-.71 2.85-.71 1.33 0 1.71.71 2.88.69 1.19-.02 1.94-1.08 2.67-2.14.84-1.23 1.19-2.42 1.21-2.48-.03-.01-2.32-.89-2.34-3.54z"/><path d="M14.86 5.72c.61-.74 1.02-1.77.91-2.8-.88.04-1.94.59-2.57 1.32-.56.65-1.05 1.7-.92 2.7.98.08 1.98-.5 2.58-1.22z"/>',
