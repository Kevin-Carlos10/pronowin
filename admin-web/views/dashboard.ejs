<%- include('layout_top', {page:'dashboard'}) %>

<style>
/* ══════════════════════════════════════════════════════════
   KPI CARDS — design glassmorphism avec icône badge
══════════════════════════════════════════════════════════ */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  margin-bottom: 1.5rem;
}
.kpi-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 1.4rem 1.5rem 1.2rem;
  position: relative; overflow: hidden;
  transition: transform .2s, box-shadow .2s;
  text-decoration: none; color: inherit; display: block;
}
.kpi-card::after {
  content: '';
  position: absolute; inset: 0;
  border-radius: 16px;
  opacity: 0;
  transition: opacity .2s;
  pointer-events: none;
}
.kpi-card:hover { transform: translateY(-3px); box-shadow: 0 12px 40px rgba(0,0,0,.2); }
.kpi-card:hover::after { opacity: 1; }

/* Bande colorée gauche */
.kpi-card::before {
  content: '';
  position: absolute; top: 0; left: 0; bottom: 0;
  width: 3px; border-radius: 16px 0 0 16px;
}
.kpi-card.blue::before   { background: var(--info); box-shadow: 0 0 12px var(--info); }
.kpi-card.orange::before { background: var(--primary); box-shadow: 0 0 12px rgba(var(--primary-rgb),.5); }
.kpi-card.green::before  { background: var(--success); box-shadow: 0 0 12px var(--success); }
.kpi-card.teal::before   { background: #14B8A6; box-shadow: 0 0 12px #14B8A6; }

/* Icône badge en haut à droite */
.kpi-icon-badge {
  position: absolute; top: 1.1rem; right: 1.2rem;
  width: 38px; height: 38px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.1rem;
}
.kpi-card.blue   .kpi-icon-badge { background: rgba(59,130,246,.12); }
.kpi-card.orange .kpi-icon-badge { background: rgba(var(--primary-rgb),.12); }
.kpi-card.green  .kpi-icon-badge { background: rgba(34,197,94,.12); }
.kpi-card.teal   .kpi-icon-badge { background: rgba(20,184,166,.12); }

.kpi-val {
  font-size: 2.2rem; font-weight: 900; line-height: 1; letter-spacing: -.03em;
  margin-bottom: .3rem; margin-top: .2rem;
}
.kpi-lbl {
  font-size: .72rem; color: var(--text-dim);
  text-transform: uppercase; letter-spacing: .07em; font-weight: 700;
}
.kpi-delta { font-size: .78rem; margin-top: .55rem; font-weight: 500; display: flex; align-items: center; gap: .3rem; }
.kpi-delta.up   { color: var(--success); }
.kpi-delta.down { color: var(--error); }
.kpi-delta.neu  { color: var(--text-dim); }
.kpi-delta::before { content:''; display:inline-block; width:5px; height:5px; border-radius:50%; background:currentColor; flex-shrink:0; }

/* Pulse pour "connectés" */
@keyframes kpi-pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(.7)} }
.kpi-pulse-dot { animation: kpi-pulse 2s ease-in-out infinite; }

/* ══════════════════════════════════════════════════════════
   ALERTES
══════════════════════════════════════════════════════════ */
.alerts-list { display: flex; flex-direction: column; gap: .5rem; margin-bottom: 1.25rem; }
/* Alertes : voir .alert dans style.css (socle partagé). Les couleurs pastel
   qui étaient écrites ici tombaient à 1,2–1,7:1 en thème clair, soit sous le
   seuil WCAG AA de 4,5:1 — elles étaient purement et simplement illisibles. */

/* ══════════════════════════════════════════════════════════
   GRILLE CHARTS
══════════════════════════════════════════════════════════ */
.charts-main  { display: grid; grid-template-columns: 1.8fr 1fr; gap: 1rem; margin-bottom: 1rem; }
.charts-row   { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
.bottom-grid  { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

.chart-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 1.35rem 1.4rem;
}
.chart-card-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 1.1rem;
}
.chart-card-title {
  font-size: .9rem; font-weight: 700; display: flex; align-items: center; gap: .4rem;
}
.chart-card-sub { font-size: .75rem; color: var(--text-dim); font-weight: 400; }
.chart-stat-badge {
  background: var(--surface-d); border: 1px solid var(--border);
  border-radius: 8px; padding: .25rem .65rem;
  font-size: .78rem; font-weight: 700; color: var(--text);
}

/* ══════════════════════════════════════════════════════════
   TABLES
══════════════════════════════════════════════════════════ */
.dash-table  { width: 100%; border-collapse: collapse; }
.dash-table th { text-align:left; padding: .5rem .75rem; font-size: .72rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: .04em; border-bottom: 1px solid var(--border); }
.dash-table td { padding: .65rem .75rem; border-bottom: 1px solid var(--border); font-size: .83rem; vertical-align: middle; }
.dash-table tr:last-child td { border-bottom: 0; }
.dash-table tr:hover td { background: var(--surface-d); }

/* ══════════════════════════════════════════════════════════
   ACTIVITÉ
══════════════════════════════════════════════════════════ */
.activity-feed { display: flex; flex-direction: column; }
.activity-item {
  display: flex; align-items: center; gap: .75rem;
  padding: .75rem 1rem; border-bottom: 1px solid var(--border); font-size: .82rem;
  transition: background .12s;
}
.activity-item:last-child { border-bottom: 0; }
.activity-item:hover { background: var(--surface-d); }
.activity-avatar {
  width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: .78rem; font-weight: 700;
  background: rgba(var(--primary-rgb),.12); color: var(--primary);
}
.activity-body { flex: 1; min-width: 0; }
.activity-action { font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.activity-meta   { color: var(--text-dim); margin-top: .08rem; font-size: .76rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.activity-time   { font-size: .72rem; color: var(--text-dim); white-space: nowrap; flex-shrink: 0; }

/* ══════════════════════════════════════════════════════════
   ACCÈS RAPIDES
══════════════════════════════════════════════════════════ */
.quick-actions { display: flex; flex-direction: column; gap: .4rem; }
.qa-btn {
  display: flex; align-items: center; gap: .7rem;
  padding: .72rem 1rem;
  background: var(--surface-d); border: 1px solid var(--border);
  border-radius: 12px; color: var(--text); text-decoration: none;
  font-size: .83rem; font-weight: 500;
  transition: all .15s; cursor: pointer; width: 100%; text-align: left; font-family: inherit;
}
.qa-btn:hover { background: var(--surface-h); border-color: var(--primary); color: var(--primary); transform: translateX(3px); }
.qa-icon-wrap {
  width: 28px; height: 28px; border-radius: 8px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: .9rem;
  background: rgba(var(--primary-rgb),.08);
}

/* ══════════════════════════════════════════════════════════
   CARD HEADER
══════════════════════════════════════════════════════════ */
.card-header { padding: 1rem 1.25rem; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
.card-header h3 { margin: 0; font-size: .9rem; font-weight: 700; }

/* ══════════════════════════════════════════════════════════
   RESPONSIVE
══════════════════════════════════════════════════════════ */
@media (max-width: 1100px) { .kpi-grid { grid-template-columns: repeat(2,1fr); } }
@media (max-width: 900px)  { .charts-main, .charts-row, .bottom-grid { grid-template-columns: 1fr; } }
@media (max-width: 600px)  { .kpi-grid { grid-template-columns: 1fr 1fr; } }
</style>

<div class="topbar">
  <div>
    <h2>Dashboard</h2>
    <small>Bonjour, <strong><%= adminName %></strong> 👋 — <span id="dash-date" style="color:var(--text-dim)"></span></small>
  </div>
  <div style="display:flex;gap:.5rem;align-items:center">
    <span id="live-indicator" style="font-size:.75rem;color:var(--success);font-weight:600;display:flex;align-items:center;gap:.3rem">
      <span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--success);animation:pulse-live 2s ease-in-out infinite"></span> LIVE
    </span>
    <button class="btn btn-outline btn-sm" onclick="refreshAll()" id="refresh-btn"><svg class="ic" aria-hidden="true"><use href="#ic-refresh"/></svg> Actualiser</button>
  </div>
</div>

<!-- ── Alertes intelligentes ──────────────────────────────────────────────── -->
<%
  const _alerts = [];
  const _pendingTotal = pending.total ?? 0;
  const _proofsTotal  = proofs.total  ?? 0;
  if (_proofsTotal >= 5)  _alerts.push({ type:'warning', icon:'crown', msg:`<strong>${_proofsTotal} preuves Premium</strong> en attente de vérification.`, link:'/admin/abonnements', linkTxt:'Vérifier →' });
  if (activeBansCount > 0) _alerts.push({ type:'info',    icon:'ban', msg:`<strong>${activeBansCount} utilisateur${activeBansCount>1?'s':''}</strong> actuellement banni${activeBansCount>1?'s':''}.`, link:'/admin/bans', linkTxt:'Voir les bans →' });
  if (locals.settings?.maintenanceMode) _alerts.push({ type:'danger', icon:'settings', msg:'<strong>Mode maintenance actif</strong> — ceci n\'est qu\'un avertissement interne aux admins, ça ne bloque pas les utilisateurs (géré séparément via Firebase Remote Config).', link:'/admin/settings', linkTxt:'Désactiver →' });
%>
<% if (_alerts.length) { %>
<div class="alerts-list">
  <% _alerts.forEach(al => { %>
  <div class="alert <%= al.type %>">
    <span class="alert-icon"><%- (al.icon) ? '<svg class="ic" aria-hidden="true"><use href="#ic-' + (al.icon) + '"/></svg>' : '' %></span>
    <span class="alert-text"><%- al.msg %></span>
    <a href="<%= al.link %>" class="btn btn-sm btn-outline" style="flex-shrink:0"><%= al.linkTxt %></a>
  </div>
  <% }) %>
</div>
<% } %>

<!-- ── KPIs ───────────────────────────────────────────────────────────────── -->
<div class="kpi-grid">
  <a href="/admin/users" class="kpi-card blue">
    <span class="kpi-icon-badge"><svg class="ic" aria-hidden="true"><use href="#ic-users"/></svg></span>
    <div class="kpi-lbl">Utilisateurs totaux</div>
    <div class="kpi-val" id="kpi-users"><%= stats.totalUsers ?? 0 %></div>
    <div class="kpi-delta neu" id="kpi-users-delta">— cette semaine</div>
  </a>
  <a href="/admin/users?plan=premium" class="kpi-card orange">
    <span class="kpi-icon-badge"><svg class="ic" aria-hidden="true"><use href="#ic-crown"/></svg></span>
    <div class="kpi-lbl">Membres Premium</div>
    <div class="kpi-val" id="kpi-premium"><%= stats.premiumUsers ?? 0 %></div>
    <div class="kpi-delta neu" id="kpi-conv-rate">— taux de conversion</div>
  </a>
  <a href="/admin/pronostics" class="kpi-card green">
    <span class="kpi-icon-badge"><svg class="ic" aria-hidden="true"><use href="#ic-ball"/></svg></span>
    <div class="kpi-lbl">Pronostics publiés auj.</div>
    <div class="kpi-val" id="kpi-prono"><%= stats.publishedToday ?? 0 %></div>
    <div class="kpi-delta neu" id="kpi-prono-delta">— taux de succès</div>
  </a>
  <div class="kpi-card teal" id="kpi-active-card" style="cursor:pointer" title="Voir les utilisateurs connectés">
    <span class="kpi-icon-badge"><span class="kpi-pulse-dot"><svg class="ic ic-sm" aria-hidden="true" style="color:var(--on-success)"><use href="#ic-dot"/></svg></span></span>
    <div class="kpi-lbl">Connectés maintenant</div>
    <div class="kpi-val" id="kpi-active"><%= stats.activeUsers ?? 0 %></div>
    <div class="kpi-delta neu">ces 2 dernières minutes</div>
  </div>
</div>

<!-- ── Graphiques ─────────────────────────────────────────────────────────── -->
<div class="charts-main">
  <div class="chart-card">
    <div class="chart-card-header">
      <div class="chart-card-title"><svg class="ic" aria-hidden="true"><use href="#ic-chart"/></svg> Inscriptions <span class="chart-card-sub">— 14 derniers jours</span></div>
      <span class="chart-stat-badge" id="badge-signups">…</span>
    </div>
    <div class="chart-wrap" style="height:200px"><canvas id="chart-signups"></canvas></div>
  </div>
  <div class="chart-card">
    <div class="chart-card-header">
      <div class="chart-card-title"><svg class="ic" aria-hidden="true"><use href="#ic-target"/></svg> Conversion</div>
      <span class="chart-stat-badge" id="badge-conv">…</span>
    </div>
    <div class="chart-wrap" style="height:200px;display:flex;align-items:center;justify-content:center">
      <canvas id="chart-conversion" style="max-height:190px"></canvas>
    </div>
  </div>
</div>

<div class="charts-row">
  <div class="chart-card">
    <div class="chart-card-header">
      <div class="chart-card-title"><svg class="ic" aria-hidden="true"><use href="#ic-ball"/></svg> Taux de succès pronostics</div>
      <span class="chart-stat-badge" id="badge-pronos">…</span>
    </div>
    <div class="chart-wrap" style="height:180px;display:flex;align-items:center;justify-content:center">
      <canvas id="chart-pronostics" style="max-height:170px"></canvas>
    </div>
  </div>
  <div class="chart-card">
    <div class="chart-card-header">
      <div class="chart-card-title"><svg class="ic" aria-hidden="true"><use href="#ic-dashboard"/></svg> Répartition membres</div>
    </div>
    <div style="display:flex;flex-direction:column;gap:.6rem;justify-content:center;height:180px;padding:.5rem 0">
      <% const _total = (stats.totalUsers||0); const _prem = (stats.premiumUsers||0); const _free = _total - _prem; const _rate = _total > 0 ? Math.round(_prem/_total*100) : 0; %>
      <div>
        <div style="display:flex;justify-content:space-between;font-size:.78rem;margin-bottom:.3rem">
          <span style="color:var(--text-dim)"><svg class="ic" aria-hidden="true"><use href="#ic-crown"/></svg> Premium</span><span style="font-weight:700"><%= _prem %> (<%= _rate %>%)</span>
        </div>
        <div style="height:7px;border-radius:4px;background:var(--border);overflow:hidden">
          <div style="height:100%;width:<%= _rate %>%;background:var(--primary);border-radius:4px;transition:width .6s ease"></div>
        </div>
      </div>
      <div>
        <div style="display:flex;justify-content:space-between;font-size:.78rem;margin-bottom:.3rem">
          <span style="color:var(--text-dim)">🆓 Gratuit</span><span style="font-weight:700"><%= _free %> (<%= 100-_rate %>%)</span>
        </div>
        <div style="height:7px;border-radius:4px;background:var(--border);overflow:hidden">
          <div style="height:100%;width:<%= 100-_rate %>%;background:var(--info);border-radius:4px;transition:width .6s ease"></div>
        </div>
      </div>
      <div style="margin-top:.5rem;padding:.75rem;background:var(--surface-d);border-radius:10px;display:flex;justify-content:space-around;text-align:center">
        <div><div style="font-size:1.3rem;font-weight:800;color:var(--primary)"><%= _rate %>%</div><div style="font-size:.7rem;color:var(--text-dim)">taux Premium</div></div>
        <div style="width:1px;background:var(--border)"></div>
        <div><div style="font-size:1.3rem;font-weight:800;color:var(--success)" id="stat-active-users"><%= stats.activeUsers ?? 0 %></div><div style="font-size:.7rem;color:var(--text-dim)">en ligne</div></div>
      </div>
    </div>
  </div>
</div>

<!-- ── Bas de page : 3 colonnes ───────────────────────────────────────────── -->
<div class="bottom-grid">

  <!-- Activité récente -->
  <div class="card" style="padding:0;overflow:hidden">
    <div class="card-header">
      <h3><svg class="ic" aria-hidden="true"><use href="#ic-clipboard"/></svg> Activité récente</h3>
      <a href="/admin/audit" class="btn btn-sm btn-outline">Journal →</a>
    </div>
    <% if(recentLogs && recentLogs.length > 0){ %>
    <div class="activity-feed">
      <% recentLogs.slice(0,8).forEach(log => {
           const _icons = { login:'🔑', logout:'🚪', user_banned:'🚫', user_unbanned:'🔓', login_failed:'⚠️', settings_changed:'⚙️', sub_admin_created:'🔐', sub_admin_deleted:'🗑️' };
           const _icon = _icons[log.action] ?? '•';
           const _since = (() => {
             const ms = Date.now() - new Date(log.timestamp).getTime();
             if (ms < 60000) return 'à l\'instant';
             if (ms < 3600000) return Math.floor(ms/60000) + 'min';
             if (ms < 86400000) return Math.floor(ms/3600000) + 'h';
             return new Date(log.timestamp).toLocaleDateString('fr-FR',{day:'2-digit',month:'2-digit'});
           })();
      %>
      <div class="activity-item">
        <div class="activity-avatar" style="<%= log.action==='login_failed'||log.action==='user_banned'?'background:rgba(239,68,68,.12);color:var(--error)':log.action==='login'?'background:rgba(34,197,94,.12);color:var(--success)':'' %>"><%= (log.adminName||'?')[0].toUpperCase() %></div>
        <div class="activity-body">
          <div class="activity-action"><%= _icon %> <%= log.adminName %></div>
          <div class="activity-meta"><%= log.target ? log.target.slice(0,40) : log.action %></div>
        </div>
        <div class="activity-time"><%= _since %></div>
      </div>
      <% }) %>
    </div>
    <% } else { %><p class="empty" style="padding:1.5rem">Aucune activité enregistrée.</p><% } %>
  </div>

  <!-- Accès rapides + bans récents -->
  <div style="display:flex;flex-direction:column;gap:1rem">
    <!-- Accès rapides -->
    <div class="card">
      <h3 style="margin-bottom:.75rem;font-size:.9rem"><svg class="ic" aria-hidden="true"><use href="#ic-zap"/></svg> Accès rapides</h3>
      <div class="quick-actions">
        <% if(hasPerm('users','write')) { %>
        <a href="/admin/users" class="qa-btn"><span class="qa-icon-wrap"><svg class="ic" aria-hidden="true"><use href="#ic-users"/></svg></span> Gérer les utilisateurs</a>
        <% } %>
        <% if(hasPerm('abonnements','write')) { %>
        <a href="/admin/abonnements" class="qa-btn"><span class="qa-icon-wrap"><svg class="ic" aria-hidden="true"><use href="#ic-crown"/></svg></span> Vérifier preuves Premium <% if((proofs.total??0)>0){ %><span class="badge badge-warn" style="margin-left:auto;font-size:.7rem"><%= proofs.total %></span><% } %></a>
        <% } %>
        <% if(hasPerm('pronostics','write')) { %>
        <a href="/admin/pronostics" class="qa-btn"><span class="qa-icon-wrap"><svg class="ic" aria-hidden="true"><use href="#ic-ball"/></svg></span> Publier un pronostic</a>
        <% } %>
        <% if(hasPerm('notifications','write')) { %>
        <a href="/admin/notifications" class="qa-btn"><span class="qa-icon-wrap"><svg class="ic" aria-hidden="true"><use href="#ic-megaphone"/></svg></span> Envoyer une notification</a>
        <% } %>
        <% if(isMain) { %>
        <a href="/admin/bans" class="qa-btn"><span class="qa-icon-wrap"><svg class="ic" aria-hidden="true"><use href="#ic-ban"/></svg></span> Bannissements <% if(activeBansCount>0){ %><span class="badge badge-err" style="margin-left:auto;font-size:.7rem"><%= activeBansCount %></span><% } %></a>
        <% } %>
      </div>
    </div>

    <!-- Bans récents (si >0) -->
    <% if(activeBansCount > 0 && recentBans && recentBans.length > 0){ %>
    <div class="card" style="padding:0;overflow:hidden">
      <div class="card-header">
        <h3 style="color:var(--error)"><svg class="ic" aria-hidden="true"><use href="#ic-ban"/></svg> Bans actifs (<%= activeBansCount %>)</h3>
        <a href="/admin/bans" class="btn btn-sm btn-outline">Voir →</a>
      </div>
      <% recentBans.forEach(ban => { %>
      <div style="display:flex;align-items:center;gap:.6rem;padding:.65rem .75rem;border-bottom:1px solid var(--border);font-size:.82rem">
        <div style="width:28px;height:28px;border-radius:50%;background:rgba(239,68,68,.15);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.8rem;color:var(--error);flex-shrink:0"><%= (ban.pseudo||'?')[0].toUpperCase() %></div>
        <div style="flex:1;min-width:0">
          <div style="font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= ban.pseudo %></div>
          <div style="font-size:.72rem;color:var(--text-dim);white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= ban.reason %></div>
        </div>
        <a href="/admin/users/<%= ban.userId %>" class="btn btn-sm btn-outline" style="flex-shrink:0">→</a>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>

</div>

<!-- ── Chart.js ─────────────────────────────────────────────────────────── -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
/* ── Date ── */
document.getElementById('dash-date').textContent =
  new Date().toLocaleDateString('fr-FR', { weekday:'long', day:'numeric', month:'long', year:'numeric' });

/* ── Couleurs CSS vars → valeurs réelles ── */
function cssVar(name) {
  return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
}
function hexToRgba(hex, a) {
  const r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
  return `rgba(${r},${g},${b},${a})`;
}

/* ── Config globale Chart.js adaptative ── */
function applyChartDefaults() {
  const gridColor   = cssVar('--border') || '#1E2A42';
  const textColor   = cssVar('--text-dim') || '#8892AA';
  const tooltipBg   = cssVar('--surface') || '#141926';
  const tooltipBdr  = cssVar('--border') || '#1E2A42';
  const tooltipText = cssVar('--text') || '#E2E8F0';
  Chart.defaults.color                               = textColor;
  Chart.defaults.borderColor                         = gridColor;
  Chart.defaults.font.family                         = "'Inter', system-ui, sans-serif";
  Chart.defaults.font.size                           = 11;
  Chart.defaults.plugins.legend.labels.boxWidth      = 10;
  Chart.defaults.plugins.legend.labels.padding       = 14;
  Chart.defaults.plugins.tooltip.backgroundColor     = tooltipBg;
  Chart.defaults.plugins.tooltip.borderColor         = tooltipBdr;
  Chart.defaults.plugins.tooltip.borderWidth         = 1;
  Chart.defaults.plugins.tooltip.titleColor          = tooltipText;
  Chart.defaults.plugins.tooltip.bodyColor           = textColor;
  Chart.defaults.plugins.tooltip.padding             = 10;
}
applyChartDefaults();

/* ── Palette ── */
function palette() {
  const primary = cssVar('--primary') || '#E8541A';
  return {
    blue:   cssVar('--info')    || '#3B82F6',
    orange: primary,
    green:  cssVar('--success') || '#22C55E',
    red:    cssVar('--error')   || '#EF4444',
    purple: '#A78BFA',
    border: cssVar('--border')  || '#1E2A42',
  };
}

let chartSignups, chartConv, chartPronos;

function last14Days() {
  const days = [];
  for (let i = 13; i >= 0; i--) {
    const d = new Date(); d.setDate(d.getDate() - i);
    days.push(d.toLocaleDateString('fr-FR', { day:'2-digit', month:'2-digit' }));
  }
  return days;
}
/* ── Build charts ── */
function buildSignupsChart(data) {
  if (chartSignups) chartSignups.destroy();
  const P = palette();
  const ctx = document.getElementById('chart-signups')?.getContext('2d');
  if (!ctx) return;
  const g = ctx.createLinearGradient(0,0,0,200);
  g.addColorStop(0, hexToRgba(P.blue, .35));
  g.addColorStop(1, hexToRgba(P.blue, .02));
  chartSignups = new Chart(ctx, {
    type: 'line',
    data: { labels: data.labels ?? last14Days(), datasets: [{ label:'Inscriptions', data: data.values ?? [], borderColor: P.blue, backgroundColor: g, fill:true, tension:.4, pointRadius:3, pointBackgroundColor: P.blue }] },
    options: { responsive:true, maintainAspectRatio:false, plugins:{ legend:{ display:false } }, scales: { x:{ grid:{display:false}, ticks:{maxTicksLimit:7} }, y:{ grid:{color: P.border}, beginAtZero:true, ticks:{precision:0} } } }
  });
}

function buildConversionChart(free, premium) {
  if (chartConv) chartConv.destroy();
  const P = palette();
  const ctx = document.getElementById('chart-conversion')?.getContext('2d');
  if (!ctx) return;
  chartConv = new Chart(ctx, {
    type: 'doughnut',
    data: { labels:['Free','Premium'], datasets:[{ data:[Math.max(free,0),Math.max(premium,0)], backgroundColor:[hexToRgba(P.blue,.25),hexToRgba(P.orange,.6)], borderColor:[P.blue,P.orange], borderWidth:1.5, hoverOffset:6 }] },
    options: { responsive:true, maintainAspectRatio:false, cutout:'68%', plugins:{ legend:{position:'bottom'}, tooltip:{ callbacks:{ label: c => ` ${c.label} : ${c.raw} (${Math.round(c.raw/((free+premium)||1)*100)}%)` } } } }
  });
}


function buildPronosticsChart(won, lost, pending) {
  if (chartPronos) chartPronos.destroy();
  const P = palette();
  const ctx = document.getElementById('chart-pronostics')?.getContext('2d');
  if (!ctx) return;
  chartPronos = new Chart(ctx, {
    type: 'doughnut',
    data: { labels:['Gagnés','Perdus','En cours'], datasets:[{ data:[Math.max(won,0),Math.max(lost,0),Math.max(pending,0)], backgroundColor:[hexToRgba(P.green,.55),hexToRgba(P.red,.45),hexToRgba(P.orange,.35)], borderColor:[P.green,P.red,P.orange], borderWidth:1.5, hoverOffset:6 }] },
    options: { responsive:true, maintainAspectRatio:false, cutout:'65%', plugins:{ legend:{position:'bottom'}, tooltip:{ callbacks:{ label: c => { const t=won+lost+pending; return ` ${c.label} : ${c.raw} (${Math.round(c.raw/(t||1)*100)}%)`; } } } } }
  });
}

/* ── Flash KPI ── */
function flashUpdate(id, val, format) {
  if (val === null || val === undefined) return;
  const el = document.getElementById(id);
  if (!el) return;
  const display = format ? format(val) : String(val);
  if (el.textContent === display) return;
  el.style.transition = 'none';
  el.style.color = 'var(--primary)';
  el.textContent = display;
  setTimeout(() => { el.style.transition = ''; el.style.color = ''; }, 1500);
}

/* ── Chargement données ── */
async function loadCharts() {
  const btn = document.getElementById('refresh-btn');
  if (btn) { btn.disabled = true; btn.textContent = '⏳'; }

  try {
    const [signupsRes, pronosticsRes] = await Promise.allSettled([
      fetch('/admin/api/stats/signups?days=14').then(r => r.json()),
      fetch('/admin/api/stats/pronostics').then(r => r.json()),
    ]);

    const signups = signupsRes.status === 'fulfilled' ? signupsRes.value : {};
    buildSignupsChart(signups);
    if (signups.newThisWeek !== undefined) {
      document.getElementById('kpi-users-delta').textContent = `+${signups.newThisWeek} cette semaine`;
      document.getElementById('kpi-users-delta').className = 'kpi-delta up';
      const badgeS = document.getElementById('badge-signups');
      if (badgeS) badgeS.textContent = `+${signups.newThisWeek} / 7j`;
    }

    const totalU   = parseInt(document.getElementById('kpi-users')?.textContent.replace(/\s/g,'')) || 0;
    const premiumU = parseInt(document.getElementById('kpi-premium')?.textContent.replace(/\s/g,'')) || 0;
    buildConversionChart(totalU - premiumU, premiumU);
    if (totalU > 0) {
      const rate = Math.round(premiumU / totalU * 100);
      document.getElementById('kpi-conv-rate').textContent = `Taux conversion : ${rate}%`;
      document.getElementById('kpi-conv-rate').className   = rate > 10 ? 'kpi-delta up' : 'kpi-delta neu';
      const badgeC = document.getElementById('badge-conv');
      if (badgeC) badgeC.textContent = `${rate}% premium`;
    }

    const pronos = pronosticsRes.status === 'fulfilled' ? pronosticsRes.value : {};
    buildPronosticsChart(pronos.won ?? 0, pronos.lost ?? 0, pronos.pending ?? 0);
    if (pronos.won !== undefined && pronos.lost !== undefined) {
      const total = pronos.won + pronos.lost;
      const rate  = total > 0 ? Math.round(pronos.won / total * 100) : 0;
      document.getElementById('kpi-prono-delta').textContent = `Taux de réussite : ${rate}%`;
      document.getElementById('kpi-prono-delta').className   = rate >= 60 ? 'kpi-delta up' : rate >= 40 ? 'kpi-delta neu' : 'kpi-delta down';
      const badgeP = document.getElementById('badge-pronos');
      if (badgeP) badgeP.textContent = `${rate}% réussite`;
    }

  } catch(e) {
    if (typeof showToast === 'function') showToast('Erreur chargement graphiques', 'error');
  }

  if (btn) { btn.disabled = false; btn.textContent = '🔄 Actualiser'; }
}

function refreshAll() {
  applyChartDefaults(); // Recalcule les couleurs au cas où le thème a changé
  loadCharts();
}

loadCharts();

/* ── SSE temps réel ── */
window.addEventListener('sseKpis', function(e) {
  const d = e.detail;
  if (d.users_total    != null) flashUpdate('kpi-users',   d.users_total);
  if (d.proofs_pending != null) flashUpdate('kpi-proofs',  d.proofs_pending);
  if (d.active_users   != null) { flashUpdate('kpi-active', d.active_users); flashUpdate('stat-active-users', d.active_users); }
});

/* ── Reconstruire les charts si le thème change ── */
document.documentElement.addEventListener && (function() {
  const obs = new MutationObserver(() => { applyChartDefaults(); refreshAll(); });
  obs.observe(document.documentElement, { attributes:true, attributeFilter:['class','data-accent'] });
})();

/* ── Modal utilisateurs connectés ── */
(function() {
  const card = document.getElementById('kpi-active-card');
  const modal = document.getElementById('online-modal');
  const overlay = document.getElementById('online-overlay');
  const closeBtn = document.getElementById('online-close');
  const tbody = document.getElementById('online-tbody');
  const countEl = document.getElementById('online-count');

  function closeModal() {
    modal.style.display = 'none';
    overlay.style.display = 'none';
  }

  async function openModal() {
    modal.style.display = 'flex';
    overlay.style.display = 'block';
    tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:2rem;color:var(--text-dim)">Chargement…</td></tr>';
    try {
      const data = await fetch('/admin/api/users/online').then(r => r.json());
      countEl.textContent = data.total ?? 0;
      if (!data.users || data.users.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:2rem;color:var(--text-dim)">Aucun utilisateur connecté actuellement.</td></tr>';
        return;
      }
      tbody.innerHTML = data.users.map(u => {
        const ago = (() => {
          const ms = Date.now() - new Date(u.lastSeenAt).getTime();
          if (ms < 60000) return 'à l\'instant';
          return Math.floor(ms / 60000) + 's min';
        })();
        const plan = u.subscriptionPlan === 'premium'
          ? '<span class="badge badge-ok" style="font-size:.7rem">👑 Premium</span>'
          : '<span class="badge" style="font-size:.7rem;background:rgba(59,130,246,.15);color:#93C5FD">Free</span>';
        const id = u.identifier ?? u.phoneNumber ?? u.email ?? '—';
        return `<tr>
          <td>
            <div style="display:flex;align-items:center;gap:.6rem">
              <div style="width:30px;height:30px;border-radius:50%;background:rgba(34,197,94,.15);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.8rem;color:var(--success);flex-shrink:0">${(u.pseudo||'?')[0].toUpperCase()}</div>
              <div>
                <div style="font-weight:600">${u.pseudo ?? '—'}</div>
                <div style="font-size:.72rem;color:var(--text-dim)">${id}</div>
              </div>
            </div>
          </td>
          <td>${u.countryCode ?? '—'}</td>
          <td>${plan}</td>
          <td style="color:var(--success);font-size:.8rem;font-weight:500">
            <span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--success);margin-right:.3rem;animation:pulse-live 2s ease-in-out infinite"></span>${ago}
          </td>
        </tr>`;
      }).join('');
    } catch(e) {
      tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:2rem;color:var(--error)">Erreur de chargement.</td></tr>';
    }
  }

  if (card)    card.addEventListener('click', openModal);
  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (overlay)  overlay.addEventListener('click', closeModal);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
})();
</script>

<!-- ── Modal utilisateurs connectés ── -->
<div id="online-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:1000"></div>
<div id="online-modal" style="display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);width:min(700px,95vw);max-height:80vh;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);z-index:1001;flex-direction:column;overflow:hidden">
  <div style="display:flex;justify-content:space-between;align-items:center;padding:1rem 1.25rem;border-bottom:1px solid var(--border)">
    <div>
      <h3 style="margin:0;font-size:1rem;font-weight:700"><svg class="ic ic-sm" aria-hidden="true" style="color:var(--on-success)"><use href="#ic-dot"/></svg> Utilisateurs connectés</h3>
      <div style="font-size:.78rem;color:var(--text-dim);margin-top:.2rem">actifs ces 2 dernières minutes — <span id="online-count">…</span> en ligne</div>
    </div>
    <button id="online-close" aria-label="Fermer le panneau" style="background:none;border:none;color:var(--text-dim);font-size:1.3rem;cursor:pointer;line-height:1;padding:.2rem .4rem" title="Fermer"><svg class="ic" aria-hidden="true"><use href="#ic-x"/></svg></button>
  </div>
  <div style="overflow-y:auto;flex:1">
    <div class="table-wrap">
      <table class="dash-table" style="width:100%">
        <thead><tr>
          <th>Utilisateur</th>
          <th>Pays</th>
          <th>Plan</th>
          <th>Vu</th>
        </tr></thead>
        <tbody id="online-tbody">
          <tr><td colspan="4" style="text-align:center;padding:2rem;color:var(--text-dim)">Chargement…</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('layout_bottom') %>
