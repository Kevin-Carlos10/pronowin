<%- include('layout_top', {page:'users'}) %>

<%
  const _udHasBan = typeof activeBan !== 'undefined' && !!activeBan;
  const _udDevices = user._count ? user._count.appareils : (user.fcmToken ? 1 : 0);
  const _udLastSeen = user.lastLoginAt
    ? new Date(user.lastLoginAt).toLocaleDateString('fr-FR', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' })
    : 'Jamais connecté';
  const _udAccountState = _udHasBan ? 'Banni' : (user.isActive ? 'Actif' : 'Suspendu');
%>

<style>
/* ── Modals ──────────────────────────────────────────────────────────────── */
.ud-modal { display:none; position:fixed; inset:0; background:rgba(0,0,0,.6); backdrop-filter:blur(4px); z-index:200; align-items:center; justify-content:center; }
.ud-modal-box { background:var(--surface); border:1px solid var(--border); border-radius:16px; padding:1.75rem; width:min(96vw,480px); animation:slideUp .25s ease; }
@keyframes slideUp { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:none; } }
.ud-modal-title { font-size:1rem; font-weight:700; margin-bottom:1.1rem; }

/* ── Avatar ──────────────────────────────────────────────────────────────── */
.ud-avatar-wrap { position:relative; flex-shrink:0; }
.ud-avatar { width:64px; height:64px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:1.5rem; font-weight:800; }
.ud-avatar.premium { background:rgba(var(--warning-rgb),.15); color:var(--on-warning); }
.ud-avatar.normal  { background:var(--surface-d); color:var(--text-m); }
.ud-avatar.banned  { background:rgba(var(--error-rgb),.15); color:var(--on-danger); }
.ud-status-dot { position:absolute; bottom:2px; right:2px; width:14px; height:14px; border-radius:50%; border:2px solid var(--surface); }
.ud-status-dot.active   { background:var(--success); }
.ud-status-dot.inactive { background:var(--error); }
.ud-status-dot.banned   { background:var(--error); animation:pulse-live 2s ease-in-out infinite; }

/* ── Header user ─────────────────────────────────────────────────────────── */
.ud-header { display:flex; align-items:flex-start; gap:1rem; margin-bottom:1.25rem; flex-wrap:wrap; }
.ud-header-info { flex:1; min-width:0; }
.ud-name { font-size:1.3rem; font-weight:800; line-height:1.1; }
.ud-handle { font-size:.82rem; color:var(--text-m); margin-top:.2rem; }
.ud-id-row { display:flex; align-items:center; gap:.4rem; margin-top:.3rem; }
.ud-id { font-size:.72rem; color:var(--text-dim); font-family:monospace; background:var(--surface-d); padding:.15rem .45rem; border-radius:4px; }
.ud-copy-btn { background:none; border:none; cursor:pointer; color:var(--text-dim); font-size:.75rem; padding:.1rem .3rem; border-radius:4px; transition:all .15s; }
.ud-copy-btn:hover { background:var(--surface-h); color:var(--primary-texte); }

/* ── Onglets ─────────────────────────────────────────────────────────────── */
.ud-tabs { display:flex; gap:0; border-bottom:1px solid var(--border); margin-bottom:1.25rem; overflow-x:auto; }
.ud-tab  { padding:.6rem 1.1rem; font-size:.83rem; font-weight:600; color:var(--text-m); border-bottom:2px solid transparent; cursor:pointer; white-space:nowrap; transition:color .15s, border-color .15s; background:none; border-top:none; border-left:none; border-right:none; font-family:inherit; }
.ud-tab:hover   { color:var(--text); }
.ud-tab.active  { color:var(--primary-texte); border-bottom-color:var(--primary); }
.ud-panel       { display:none; }
.ud-panel.active { display:block; }

/* ── Info rows ───────────────────────────────────────────────────────────── */
.ud-row { display:flex; justify-content:space-between; align-items:center; padding:.55rem 0; border-bottom:1px solid var(--border); gap:.5rem; }
.ud-row:last-child { border-bottom:0; }
.ud-row-lbl { font-size:.8rem; color:var(--text-m); flex-shrink:0; }
.ud-row-val { font-size:.83rem; font-weight:500; color:var(--text); text-align:right; word-break:break-all; }
.ud-row-val.primary { color:var(--primary-texte); }
.ud-row-val.success { color:var(--on-success); }
.ud-row-val.error   { color:var(--on-danger); }
.ud-row-val.purple  { color:var(--on-purple); }

/* ── Stats mini ──────────────────────────────────────────────────────────── */
.ud-stats { display:grid; grid-template-columns:repeat(3,1fr); gap:.6rem; margin-bottom:1rem; }
.ud-stat  { background:var(--surface-d); border-radius:var(--radius-s); padding:.65rem .75rem; text-align:center; }
.ud-stat .v { font-size:1.2rem; font-weight:800; line-height:1; }
.ud-stat .l { font-size:.68rem; color:var(--text-dim); text-transform:uppercase; letter-spacing:.04em; margin-top:.2rem; }

/* ── Actions sidebar ─────────────────────────────────────────────────────── */
.ud-action-section { margin-bottom:.9rem; padding-bottom:.9rem; border-bottom:1px solid var(--border); }
.ud-action-section:last-child { margin-bottom:0; padding-bottom:0; border-bottom:0; }
.ud-action-title { font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--text-dim); margin-bottom:.6rem; }
.ud-action-btns  { display:flex; flex-direction:column; gap:.4rem; }

/* ── Ban info box ────────────────────────────────────────────────────────── */
.ud-ban-box { background:rgba(var(--error-rgb),.08); border:1px solid rgba(var(--error-rgb),.2); border-radius:var(--radius-s); padding:.75rem .9rem; margin-bottom:.75rem; font-size:.8rem; }
.ud-ban-box .reason { font-weight:600; color:var(--text); margin-bottom:.25rem; }
.ud-ban-box .meta   { color:var(--text-dim); line-height:1.5; }

/* ── Premium box ─────────────────────────────────────────────────────────── */
.ud-premium-box { background:rgba(var(--warning-rgb),.08); border:1px solid rgba(var(--warning-rgb),.2); border-radius:var(--radius-s); padding:.75rem .9rem; margin-bottom:.75rem; font-size:.83rem; color:var(--on-warning); font-weight:600; }

/* ── Layout ──────────────────────────────────────────────────────────────── */
.ud-layout { display:grid; grid-template-columns:1fr 300px; gap:1rem; align-items:start; }
.ud-identity-card { margin-bottom:1rem; }
.ud-health-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:.65rem; margin:0 0 1.25rem; }
.ud-health-item { min-width:0; padding:.7rem .8rem; border:1px solid var(--border); border-radius:var(--radius-s); background:var(--surface-d); }
.ud-health-item--ok { border-color:rgba(var(--success-rgb),.26); background:rgba(var(--success-rgb),.06); }
.ud-health-item--warn { border-color:rgba(var(--warning-rgb),.28); background:rgba(var(--warning-rgb),.06); }
.ud-health-item--danger { border-color:rgba(var(--error-rgb),.28); background:rgba(var(--error-rgb),.07); }
.ud-health-label { display:block; margin-bottom:.24rem; color:var(--text-dim); font-size:.66rem; font-weight:800; letter-spacing:.07em; text-transform:uppercase; }
.ud-health-value { display:block; overflow:hidden; color:var(--text); font-size:.82rem; font-weight:750; text-overflow:ellipsis; white-space:nowrap; }
.ud-actions-rail { position:sticky; top:1rem; }
.ud-rail-head { margin:0 0 .9rem; padding:0 0 .8rem; border-bottom:1px solid var(--border); }
.ud-rail-head h2 { margin:0; font-size:.98rem; }
.ud-rail-head p { margin:.22rem 0 0; color:var(--text-dim); font-size:.75rem; line-height:1.45; }
.ud-action-impact { margin:0 0 .6rem; color:var(--text-m); font-size:.76rem; line-height:1.5; }
.ud-danger-zone { margin-inline:-.25rem; padding:.8rem; border:1px solid rgba(var(--error-rgb),.22); border-radius:var(--radius-s); background:linear-gradient(90deg,rgba(var(--error-rgb),.08),transparent 88%); }
.ud-danger-zone .ud-action-title { color:var(--on-danger); }
.ud-modal-impact { margin:-.15rem 0 1rem; color:var(--text-m); font-size:.78rem; line-height:1.5; }
@media (max-width:900px) { .ud-actions-rail { position:static; } }
@media (max-width:650px) { .ud-health-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
@media (max-width:900px) { .ud-layout { grid-template-columns:1fr; } }
</style>

<!-- ── Modals ───────────────────────────────────────────────────────────── -->
<div class="ud-modal" id="modal-ban">
  <div class="ud-modal-box">
    <div class="ud-modal-title" style="color:var(--on-danger)"><svg class="ic" aria-hidden="true"><use href="#ic-ban"/></svg> Bannir <%= user.pseudo %></div>
    <form method="POST" action="/admin/users/<%= user.id %>/ban" id="ud-ban-form">
      <input type="hidden" name="pseudo" value="<%= user.pseudo %>">
      <p class="ud-modal-impact">Cette action bloque l'accès au compte, est journalisée et peut être levée depuis la fiche ou la liste de modération.</p>
      <div class="form-group" style="margin-bottom:.9rem">
        <label>Raison <span style="color:var(--on-danger)">*</span></label>
        <textarea class="input" name="reason" rows="3" placeholder="Ex : Arnaque, comportement abusif, fraude…" required aria-label="Raison"></textarea>
      </div>
      <div class="form-group" style="margin-bottom:1.25rem">
        <label>Durée</label>
        <select class="input" name="duration_days" aria-label="Durée en jours">
          <option value="1">1 jour</option>
          <option value="3">3 jours</option>
          <option value="7" selected>7 jours</option>
          <option value="14">14 jours</option>
          <option value="30">30 jours</option>
          <option value="90">90 jours</option>
          <option value="0">🚫 Permanent</option>
        </select>
      </div>
      <div style="display:flex;gap:.6rem;justify-content:flex-end">
        <button type="button" class="btn btn-outline" onclick="closeModal('modal-ban')">Annuler</button>
        <button type="button" class="btn btn-danger" data-pseudo="<%= user.pseudo %>"
          onclick="(function(btn){var form=document.getElementById('ud-ban-form');if(!form.reportValidity())return;askConfirm({icon:'ban',title:'Confirmer le bannissement',msg:'Le compte <strong>'+btn.dataset.pseudo+'</strong> sera bloqué et cette décision sera journalisée.',btnLabel:'Bannir le compte',btnClass:'btn-danger',onConfirm:function(){form.requestSubmit()}})})(this)"><svg class="ic" aria-hidden="true"><use href="#ic-ban"/></svg> Bannir</button>
      </div>
    </form>
  </div>
</div>

<div class="ud-modal" id="modal-notif">
  <div class="ud-modal-box">
    <div class="ud-modal-title"><svg class="ic" aria-hidden="true"><use href="#ic-phone"/></svg> Envoyer une notification</div>
    <form method="POST" action="/admin/users/<%= user.id %>/notify">
      <div class="form-group" style="margin-bottom:.9rem"><label>Titre</label><input class="input" type="text" name="title" required placeholder="Ex : Votre dépôt a été validé" aria-label="Titre"></div>
      <div class="form-group" style="margin-bottom:1.25rem"><label>Message</label><textarea class="input" name="body" rows="3" required placeholder="Contenu de la notification…" aria-label="Message"></textarea></div>
      <div style="display:flex;gap:.6rem;justify-content:flex-end">
        <button type="button" class="btn btn-outline" onclick="closeModal('modal-notif')">Annuler</button>
        <button type="submit" class="btn btn-primary"><svg class="ic" aria-hidden="true"><use href="#ic-upload"/></svg> Envoyer</button>
      </div>
    </form>
  </div>
</div>

<div class="ud-modal" id="modal-pseudo">
  <div class="ud-modal-box">
    <div class="ud-modal-title"><svg class="ic" aria-hidden="true"><use href="#ic-edit"/></svg> Modifier le pseudo</div>
    <form method="POST" action="/admin/users/<%= user.id %>/pseudo">
      <div class="form-group" style="margin-bottom:1.25rem"><label>Nouveau pseudo</label><input class="input" type="text" name="pseudo" value="<%= user.pseudo %>" required minlength="3" aria-label="Pseudo"></div>
      <div style="display:flex;gap:.6rem;justify-content:flex-end">
        <button type="button" class="btn btn-outline" onclick="closeModal('modal-pseudo')">Annuler</button>
        <button type="submit" class="btn btn-primary">Sauvegarder</button>
      </div>
    </form>
  </div>
</div>

<!-- ── Topbar ───────────────────────────────────────────────────────────── -->
<header class="workspace-header">
  <div class="workspace-heading">
    <p class="workspace-eyebrow"><svg class="ic" aria-hidden="true"><use href="#ic-user"/></svg> Fiche client 360°</p>
    <h1><%= user.full_name || user.pseudo %></h1>
    <p class="workspace-description">
      <strong><%= _udAccountState %></strong> · <%= user.is_premium ? 'Premium actif' : 'Compte gratuit' %> · dernière activité : <%= _udLastSeen %>.
    </p>
  </div>
  <div class="workspace-actions">
    <a href="/admin/users" class="btn btn-outline btn-sm">← Utilisateurs</a>
    <span class="context-chip"><svg class="ic" aria-hidden="true"><use href="#ic-clipboard"/></svg> ID&nbsp;<%= user.id %></span>
    <a href="/admin/users/<%= user.id %>" class="btn btn-outline btn-sm" title="Recharger la fiche"><svg class="ic" aria-hidden="true"><use href="#ic-refresh"/></svg> Actualiser</a>
  </div>
</header>

<!-- ── Layout ───────────────────────────────────────────────────────────── -->
<div class="ud-layout">

  <!-- Colonne principale -->
  <div>

    <!-- Card identité + onglets -->
    <div class="card cr-panel ud-identity-card">

      <!-- Header avatar -->
      <div class="ud-header">
        <div class="ud-avatar-wrap">
          <div class="ud-avatar <%= (typeof activeBan!=='undefined'&&activeBan)?'banned':user.is_premium?'premium':'normal' %>">
            <%= (user.pseudo||'?')[0].toUpperCase() %>
          </div>
          <div class="ud-status-dot <%= (typeof activeBan!=='undefined'&&activeBan)?'banned':user.isActive?'active':'inactive' %>"></div>
        </div>
        <div class="ud-header-info">
          <div class="ud-name"><%= user.full_name || user.pseudo %></div>
          <% if(user.full_name) { %><div class="ud-handle">@<%= user.pseudo %></div><% } %>
          <div class="ud-id-row">
            <span class="ud-id" id="user-id-display"><%= user.id %></span>
            <button class="ud-copy-btn" onclick="copyId()" title="Copier l'ID" aria-label="Copier l'identifiant"><svg class="ic" aria-hidden="true"><use href="#ic-clipboard"/></svg></button>
            <span id="copy-confirm" style="font-size:.7rem;color:var(--on-success);display:none"><svg class="ic" aria-hidden="true"><use href="#ic-check"/></svg> Copié</span>
          </div>
        </div>
        <!-- Stats rapides -->
        <div class="ud-stats" style="min-width:200px">
          <div class="ud-stat">
            <div class="v" style="color:var(--on-warning)"><%= (user.days_left&&user.is_premium) ? user.days_left+'j' : '—' %></div>
            <div class="l">Premium</div>
          </div>
          <div class="ud-stat">
            <div class="v" style="color:var(--on-success)"><%= (user.referralEarnings||0) > 0 ? ((user.referralEarnings/1000).toFixed(0)+'k') : (referrals ? referrals.length : 0) %></div>
            <div class="l"><%= (user.referralEarnings||0) > 0 ? 'FCFA' : 'Filleuls' %></div>
          </div>
        </div>
      </div>

      <section class="ud-health-grid" aria-label="Résumé opérationnel du compte">
        <div class="ud-health-item <%= _udHasBan || !user.isActive ? 'ud-health-item--danger' : 'ud-health-item--ok' %>">
          <span class="ud-health-label">Accès</span><span class="ud-health-value"><%= _udAccountState %></span>
        </div>
        <div class="ud-health-item <%= user.is_premium ? 'ud-health-item--warn' : '' %>">
          <span class="ud-health-label">Abonnement</span><span class="ud-health-value"><%= user.is_premium ? (user.days_left || 0) + 'j Premium' : 'Gratuit' %></span>
        </div>
        <div class="ud-health-item">
          <span class="ud-health-label">Dernière activité</span><span class="ud-health-value"><%= _udLastSeen %></span>
        </div>
        <div class="ud-health-item <%= _udDevices ? 'ud-health-item--ok' : 'ud-health-item--warn' %>">
          <span class="ud-health-label">Appareils</span><span class="ud-health-value"><%= _udDevices ? _udDevices + ' notifié' + (_udDevices > 1 ? 's' : '') : 'Aucun appareil' %></span>
        </div>
      </section>

      <!-- Onglets -->
      <div class="ud-tabs">
        <button class="ud-tab active" onclick="switchTab('tab-info', this)"><svg class="ic" aria-hidden="true"><use href="#ic-user"/></svg> Informations</button>
        <% if(subscriptions && subscriptions.length > 0) { %>
        <button class="ud-tab" onclick="switchTab('tab-subs', this)"><svg class="ic" aria-hidden="true"><use href="#ic-crown"/></svg> Abonnements (<%= subscriptions.length %>)</button>
        <% } %>
        <% if(referrals && referrals.length > 0) { %>
        <button class="ud-tab" onclick="switchTab('tab-refs', this)"><svg class="ic" aria-hidden="true"><use href="#ic-users"/></svg> Filleuls (<%= referrals.length %>)</button>
        <% } %>
      </div>

      <!-- Onglet : Informations -->
      <div class="ud-panel active" id="tab-info">
        <% function row(lbl, val, cls) { %>
        <div class="ud-row">
          <span class="ud-row-lbl"><%= lbl %></span>
          <span class="ud-row-val <%= cls||'' %>"><%= val || '—' %></span>
        </div>
        <% } %>
        <% row('Prénom',    user.firstName) %>
        <% row('Nom',       user.lastName) %>
        <% if(user.birthDate) {
             const bd = new Date(user.birthDate);
             const age = Math.floor((Date.now()-bd.getTime())/(365.25*86400000));
             row('Naissance', bd.toLocaleDateString('fr-FR')+' ('+age+' ans)');
           } else { row('Naissance', '—'); }
        %>
        <% row('Téléphone', user.phoneNumber) %>
        <% row('Email',     user.email) %>
        <% row('Pays',      user.countryCode) %>
        <% row('ID 1xBet',  user.xbetId || '—', 'primary') %>
        <% row('Code parrainage', user.referralCode, 'purple') %>
        <% row('Gains parrainage', (user.referralEarnings||0).toLocaleString()+' FCFA', 'success') %>
        <% row('Inscrit le', new Date(user.createdAt).toLocaleDateString('fr-FR',{day:'numeric',month:'long',year:'numeric'})) %>
        <% row('Dernière connexion', user.lastLoginAt ? new Date(user.lastLoginAt).toLocaleDateString('fr-FR',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}) : 'Jamais') %>
        <% const nbAppareils = user._count ? user._count.appareils : (user.fcmToken ? 1 : 0); %>
        <% row('Appareils notifiés', nbAppareils > 0 ? '✓ ' + nbAppareils : '✕ Aucun', nbAppareils > 0 ? 'success' : 'error') %>
      </div>

      <!-- Onglet : Abonnements -->
      <% if(subscriptions && subscriptions.length > 0) { %>
      <div class="ud-panel" id="tab-subs">
        <div class="table-wrap">
          <table>
            <thead><tr><th scope="col">Plan</th><th scope="col">Statut</th><th scope="col">Début</th><th scope="col">Fin</th><th scope="col">Source</th></tr></thead>
            <tbody>
            <% if (!subscriptions.length) { %>
            <tr><td colspan="5" style="text-align:center;padding:1.6rem 1rem;color:var(--text-dim);font-size:.84rem">
              Aucun abonnement. Cet utilisateur n'a jamais activé le Premium.
            </td></tr>
            <% } %>
            <% subscriptions.forEach(sub => { %>
            <tr>
              <td><span class="badge badge-warn"><%= sub.plan || sub.subscriptionPlan || 'Premium' %></span></td>
              <td><span class="badge <%= sub.status==='active'?'badge-ok':'badge-err' %>"><%= sub.status || '—' %></span></td>
              <td style="font-size:.78rem;color:var(--text-m)"><%= sub.startDate ? new Date(sub.startDate).toLocaleDateString('fr-FR') : '—' %></td>
              <td style="font-size:.78rem;color:var(--text-m)"><%= sub.endDate ? new Date(sub.endDate).toLocaleDateString('fr-FR') : '—' %></td>
              <td style="font-size:.78rem;color:var(--text-dim)"><%= sub.source || '—' %></td>
            </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <% } %>

      <!-- Onglet : Filleuls -->
      <% if(referrals && referrals.length > 0) { %>
      <div class="ud-panel" id="tab-refs">
        <div class="table-wrap">
          <table>
            <thead><tr><th scope="col">Filleul</th><th scope="col">Téléphone</th><th scope="col">Plan</th><th scope="col">Niveau</th><th scope="col">Commission</th></tr></thead>
            <tbody>
            <% if (!referrals.length) { %>
            <tr><td colspan="5" style="text-align:center;padding:1.6rem 1rem;color:var(--text-dim);font-size:.84rem">
              Aucun filleul. Personne ne s'est encore inscrit avec son code de parrainage.
            </td></tr>
            <% } %>
            <% referrals.forEach(r => { %>
            <tr>
              <td>
                <a href="/admin/users/<%= r.referred.id ?? '' %>" style="font-weight:600;color:var(--text);text-decoration:none"><%= r.referred.pseudo %></a>
              </td>
              <td style="color:var(--text-m);font-size:.78rem"><%= r.referred.phoneNumber %></td>
              <td><span class="badge <%= r.referred.subscriptionPlan==='premium'?'badge-warn':'badge-info' %>"><%= r.referred.subscriptionPlan %></span></td>
              <td style="text-align:center;font-weight:600">N<%= r.level %></td>
              <td style="color:var(--on-success);font-weight:700"><%= (r.commissionAmount||0).toLocaleString() %> FCFA</td>
            </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <% } %>

    </div><!-- /card -->
  </div><!-- /col principale -->

  <!-- Colonne actions -->
  <aside class="ud-actions-rail">
    <div class="card cr-panel">
      <div class="ud-rail-head"><h2>Intervenir</h2><p>Chaque action qui modifie le compte est confirmée et conservée dans le journal d’administration.</p></div>

      <!-- Premium -->
      <div class="ud-action-section">
        <div class="ud-action-title"><svg class="ic" aria-hidden="true"><use href="#ic-crown"/></svg> Abonnement Premium</div>
        <% if(user.is_premium) { %>
        <div class="ud-premium-box">
          Premium actif — <%= user.days_left %> jour<%= user.days_left > 1 ? 's' : '' %> restant<%= user.days_left > 1 ? 's' : '' %>
        </div>
        <form method="POST" action="/admin/users/<%= user.id %>/revoke-premium" id="form-revoke-premium">
          <button type="button" class="btn btn-danger btn-sm" style="width:100%"
            data-pseudo="<%= user.pseudo %>"
            onclick="askConfirm({icon:'x',title:'Révoquer le Premium',msg:'Le Premium de <strong>'+this.dataset.pseudo+'</strong> prendra fin immédiatement. Cette modification sera journalisée.',btnLabel:'Révoquer le Premium',btnClass:'btn-danger',onConfirm:function(){document.getElementById('form-revoke-premium').requestSubmit()}})"><svg class="ic" aria-hidden="true"><use href="#ic-x"/></svg> Révoquer le Premium</button>
        </form>
        <% } else { %>
        <form method="POST" action="/admin/users/<%= user.id %>/premium" style="display:flex;gap:.5rem;align-items:flex-end">
          <div style="flex:1">
            <label style="font-size:.72rem;color:var(--text-dim);display:block;margin-bottom:.3rem">Durée (jours)</label>
            <input class="input" type="number" name="duration_days" value="30" min="1" max="365" aria-label="Durée en jours">
          </div>
          <button type="submit" class="btn btn-primary btn-sm"><svg class="ic" aria-hidden="true"><use href="#ic-crown"/></svg> Activer</button>
        </form>
        <% } %>
      </div>

      <!-- Suspension -->
      <div class="ud-action-section ud-danger-zone">
        <div class="ud-action-title"><%= user.isActive ? '🔒 Suspension' : '🔓 Réactivation' %></div>
        <p class="ud-action-impact"><%= user.isActive ? 'Bloque immédiatement les connexions au compte. Renseignez un motif pour faciliter le suivi.' : 'Rend à nouveau l’accès au compte. Vérifiez le contexte de modération avant de poursuivre.' %></p>
        <form method="POST" action="/admin/users/<%= user.id %>/suspend">
          <input type="hidden" name="suspend" value="<%= user.isActive ? 'true' : 'false' %>">
          <% if(user.isActive) { %>
          <input class="input" type="text" name="reason" placeholder="Raison (optionnelle)…" style="margin-bottom:.5rem;font-size:.82rem" aria-label="Raison">
          <% } %>
          <button type="button" class="btn <%= user.isActive ? 'btn-danger' : 'btn-success' %> btn-sm" style="width:100%" data-pseudo="<%= user.pseudo %>"
            onclick="(function(btn){var form=btn.closest('form');if(!form.reportValidity())return;askConfirm({icon:'<%= user.isActive ? 'lock' : 'unlock' %>',title:'<%= user.isActive ? 'Suspendre' : 'Réactiver' %> le compte',msg:'<%= user.isActive ? 'Le compte' : 'Le compte' %> <strong>'+btn.dataset.pseudo+'</strong> <%= user.isActive ? 'ne pourra plus se connecter.' : 'pourra à nouveau se connecter.' %> Cette modification sera journalisée.',btnLabel:'<%= user.isActive ? 'Suspendre' : 'Réactiver' %>',btnClass:'<%= user.isActive ? 'btn-danger' : 'btn-success' %>',onConfirm:function(){form.requestSubmit()}})})(this)">
            <%= user.isActive ? '🔒 Suspendre' : '🔓 Réactiver' %>
          </button>
        </form>
      </div>

      <!-- Bannissement -->
      <% if(hasPerm('users','write')) { %>
      <div class="ud-action-section ud-danger-zone">
        <div class="ud-action-title"><svg class="ic" aria-hidden="true"><use href="#ic-ban"/></svg> Bannissement</div>
        <p class="ud-action-impact">Le bannissement suspend le compte et crée une trace consultable dans le journal de modération.</p>
        <% if(typeof activeBan !== 'undefined' && activeBan) { %>
        <div class="ud-ban-box">
          <div class="reason">« <%= activeBan.reason %> »</div>
          <div class="meta">
            Par <strong><%= activeBan.bannedBy %></strong> · <%= new Date(activeBan.bannedAt).toLocaleDateString('fr-FR') %>
            <% if(activeBan.expiresAt) { %> · expire le <strong><%= new Date(activeBan.expiresAt).toLocaleDateString('fr-FR') %></strong><% } else { %> · <strong>Permanent</strong><% } %>
          </div>
        </div>
        <form method="POST" action="/admin/users/<%= user.id %>/unban">
          <input type="hidden" name="pseudo" value="<%= user.pseudo %>">
          <input class="input" type="text" name="unban_reason" placeholder="Raison du débannissement…" style="margin-bottom:.5rem;font-size:.82rem" aria-label="Raison de la levée">
          <button type="button" class="btn btn-success btn-sm" style="width:100%" data-pseudo="<%= user.pseudo %>"
            onclick="(function(btn){askConfirm({icon:'unlock',title:'Lever le bannissement',msg:'Le compte <strong>'+btn.dataset.pseudo+'</strong> retrouvera son accès. Cette décision sera journalisée.',btnLabel:'Lever le bannissement',btnClass:'btn-success',onConfirm:function(){btn.closest('form').submit()}})})(this)"><svg class="ic" aria-hidden="true"><use href="#ic-unlock"/></svg> Débannir</button>
        </form>
        <% } else { %>
        <button onclick="openModal('modal-ban')" class="btn btn-danger btn-sm" style="width:100%"><svg class="ic" aria-hidden="true"><use href="#ic-ban"/></svg> Bannir cet utilisateur</button>
        <% } %>
      </div>
      <% } %>

      <!-- Actions rapides -->
      <div class="ud-action-section">
        <div class="ud-action-title"><svg class="ic" aria-hidden="true"><use href="#ic-zap"/></svg> Actions rapides</div>
        <div class="ud-action-btns">
          <button onclick="openModal('modal-notif')" class="btn btn-outline btn-sm" style="justify-content:flex-start"><svg class="ic" aria-hidden="true"><use href="#ic-phone"/></svg> Envoyer une notification</button>
          <button onclick="openModal('modal-pseudo')" class="btn btn-outline btn-sm" style="justify-content:flex-start"><svg class="ic" aria-hidden="true"><use href="#ic-edit"/></svg> Modifier le pseudo</button>
          <a href="/admin/historique?search=<%= encodeURIComponent(user.phoneNumber||user.pseudo) %>" class="btn btn-outline btn-sm" style="justify-content:flex-start"><svg class="ic" aria-hidden="true"><use href="#ic-clipboard"/></svg> Voir l'historique</a>
          <% if (hasPerm('bankroll')) { %>
          <a href="/admin/bankroll/<%= user.id %>" class="btn btn-outline btn-sm" style="justify-content:flex-start"><svg class="ic" aria-hidden="true"><use href="#ic-target"/></svg> Voir la bankroll</a>
          <% } %>
          <% if(isMain) { %>
          <a href="/admin/bans?search=<%= encodeURIComponent(user.pseudo) %>" class="btn btn-outline btn-sm" style="justify-content:flex-start"><svg class="ic" aria-hidden="true"><use href="#ic-ban"/></svg> Historique bans</a>
          <% } %>
        </div>
      </div>

    </div><!-- /card actions -->
  </aside><!-- /col actions -->
</div><!-- /layout -->

<script>
/* ── Onglets ── */
function switchTab(id, btn) {
  document.querySelectorAll('.ud-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.ud-tab').forEach(b => b.classList.remove('active'));
  const panel = document.getElementById(id);
  if (panel) panel.classList.add('active');
  if (btn) btn.classList.add('active');
}

/* ── Modals ── */
function openModal(id) {
  const m = document.getElementById(id);
  if (m) { m.style.display = 'flex'; }
}
function closeModal(id) {
  const m = document.getElementById(id);
  if (m) { m.style.display = 'none'; }
}
document.querySelectorAll('.ud-modal').forEach(m => {
  m.addEventListener('click', e => { if (e.target === m) m.style.display = 'none'; });
});
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') document.querySelectorAll('.ud-modal').forEach(m => m.style.display = 'none');
});

/* ── Copier ID ── */
function copyId() {
  const id = '<%= user.id %>';
  navigator.clipboard?.writeText(id).then(() => {
    const c = document.getElementById('copy-confirm');
    if (c) { c.style.display = 'inline'; setTimeout(() => c.style.display = 'none', 2000); }
  }).catch(() => {
    // fallback
    const el = document.createElement('textarea');
    el.value = id; document.body.appendChild(el); el.select();
    document.execCommand('copy'); document.body.removeChild(el);
    const c = document.getElementById('copy-confirm');
    if (c) { c.style.display = 'inline'; setTimeout(() => c.style.display = 'none', 2000); }
  });
}

/* ── Toasts succès / erreur ── */
document.addEventListener('DOMContentLoaded', function() {
  <% if(typeof success !== 'undefined' && success) { %>
  if (typeof showToast === 'function') showToast('<%= success.replace(/'/g, "\\'") %>', 'success');
  <% } %>
  <% if(typeof error !== 'undefined' && error) { %>
  if (typeof showToast === 'function') showToast('<%= error.replace(/'/g, "\\'") %>', 'error');
  <% } %>
});
</script>

<%- include('layout_bottom') %>
