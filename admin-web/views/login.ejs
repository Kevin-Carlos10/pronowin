<!DOCTYPE html>
<html lang="fr" id="login-html">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#0D1117">
  <meta name="robots" content="noindex, nofollow">
  <title>Connexion — PronoWin Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script>
    (function() {
      var m = localStorage.getItem('pw_mode') || 'dark';
      if (m === 'light') document.getElementById('login-html').classList.add('light');
    })();
  </script>
  <link rel="stylesheet" href="/style.css">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --login-brand: #E8541A;
      --login-brand-rgb: 232,84,26;
      --login-dark: #0D1117;
      --login-dark2: #161B22;
      --login-border: rgba(255,255,255,.08);
    }
    html.light {
      --login-dark: #F0F4FF;
      --login-dark2: #E2E8F0;
      --login-border: rgba(0,0,0,.08);
    }

    body {
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      display: flex;
      background: var(--bg);
      color: var(--text);
      overflow: hidden;
    }

    /* ══════════════════════════════════════════
       PANNEAU GAUCHE — Branding
    ══════════════════════════════════════════ */
    .login-left {
      flex: 1;
      background: var(--login-dark);
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 2.5rem;
      overflow: hidden;
    }
    html.light .login-left { background: #0D1117; }

    /* Grille décorative */
    .login-left::before {
      content: '';
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(232,84,26,.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(232,84,26,.06) 1px, transparent 1px);
      background-size: 40px 40px;
      mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 100%);
    }

    /* Lueur centrale */
    .login-left::after {
      content: '';
      position: absolute;
      top: -20%; left: -20%;
      width: 140%; height: 140%;
      background: radial-gradient(ellipse 60% 50% at 40% 40%, rgba(232,84,26,.18) 0%, transparent 65%);
      pointer-events: none;
    }

    .left-top { position: relative; z-index: 1; }
    .left-logo {
      display: flex; align-items: center; gap: .75rem;
    }
    .left-logo-icon {
      width: 48px; height: 48px; border-radius: 14px;
      background: linear-gradient(135deg, #E8541A, #C43F0D);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.4rem;
      box-shadow: 0 8px 24px rgba(232,84,26,.4), 0 0 0 1px rgba(232,84,26,.2);
    }
    .left-logo-name { font-size: 1.4rem; font-weight: 800; color: #fff; }
    .left-logo-name span { color: var(--login-brand); }
    .left-logo-sub { font-size: .72rem; color: rgba(255,255,255,.4); text-transform: uppercase; letter-spacing: .08em; margin-top: .1rem; font-weight: 500; }

    /* Hero texte */
    .left-hero { position: relative; z-index: 1; margin-top: 4rem; }
    .left-hero-badge {
      display: inline-flex; align-items: center; gap: .4rem;
      background: rgba(232,84,26,.12); border: 1px solid rgba(232,84,26,.25);
      border-radius: 99px; padding: .3rem .75rem;
      font-size: .72rem; font-weight: 600; color: #F97316;
      letter-spacing: .04em; margin-bottom: 1.25rem;
    }
    .left-hero-badge::before {
      content: '';
      width: 6px; height: 6px; border-radius: 50%;
      background: #F97316;
      animation: pulse-dot 2s ease-in-out infinite;
    }
    @keyframes pulse-dot {
      0%,100% { opacity: 1; transform: scale(1); }
      50%      { opacity: .5; transform: scale(.7); }
    }
    .left-hero h2 {
      font-size: 2.5rem; font-weight: 900; line-height: 1.15;
      color: #fff; letter-spacing: -.03em;
    }
    .left-hero h2 em { font-style: normal; color: var(--login-brand); }
    .left-hero p {
      margin-top: 1rem; font-size: .92rem; color: rgba(255,255,255,.45);
      line-height: 1.65; max-width: 340px;
    }

    /* Features */
    .left-features { position: relative; z-index: 1; display: flex; flex-direction: column; gap: .65rem; margin-top: 2.5rem; }
    .feature-item {
      display: flex; align-items: center; gap: .75rem;
      font-size: .83rem; color: rgba(255,255,255,.55);
    }
    .feature-icon {
      width: 30px; height: 30px; border-radius: 8px; flex-shrink: 0;
      background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.07);
      display: flex; align-items: center; justify-content: center; font-size: .9rem;
    }

    /* Stats bottom */
    .left-stats { position: relative; z-index: 1; }
    .left-stats-grid { display: flex; gap: 1.5rem; }
    .stat-item { }
    .stat-val { font-size: 1.5rem; font-weight: 800; color: #fff; line-height: 1; }
    .stat-lbl { font-size: .72rem; color: rgba(255,255,255,.4); margin-top: .2rem; }

    /* ══════════════════════════════════════════
       PANNEAU DROIT — Formulaire
    ══════════════════════════════════════════ */
    .login-right {
      width: min(480px, 100%);
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 3rem 2.5rem;
      background: var(--surface);
      position: relative;
      overflow-y: auto;
    }

    /* Mode toggle */
    .theme-row {
      position: absolute; top: 1.25rem; right: 1.25rem;
      display: flex; gap: .35rem;
    }
    .theme-btn {
      width: 32px; height: 32px; border-radius: 9px;
      background: var(--surface-d); border: 1px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; font-size: .9rem; transition: all .15s;
      color: var(--text-dim);
    }
    .theme-btn:hover { background: var(--surface-h); }
    .theme-btn.active { border-color: var(--primary); background: rgba(var(--primary-rgb),.1); }

    /* Header formulaire */
    .form-header { margin-bottom: 2rem; }
    .form-header h3 {
      font-size: 1.65rem; font-weight: 800; line-height: 1.2;
      letter-spacing: -.02em; color: var(--text);
    }
    .form-header p { font-size: .85rem; color: var(--text-dim); margin-top: .4rem; }

    /* Alertes */
    .login-alert {
      border-radius: 10px; padding: .8rem 1rem;
      font-size: .83rem; margin-bottom: 1.25rem;
      display: flex; align-items: flex-start; gap: .5rem; line-height: 1.5;
    }
    .login-alert.error   { background: rgba(239,68,68,.08);  border: 1px solid rgba(239,68,68,.18);  color: #FCA5A5; }
    .login-alert.warning { background: rgba(245,158,11,.08); border: 1px solid rgba(245,158,11,.18); color: #FCD34D; }
    .login-alert.info    { background: rgba(59,130,246,.08); border: 1px solid rgba(59,130,246,.18); color: #93C5FD; }
    .login-alert.locked  { background: rgba(239,68,68,.1);   border: 1px solid rgba(239,68,68,.22);  color: #FCA5A5; }

    /* Barre tentatives */
    .attempts-bar {
      margin-bottom: 1.25rem; padding: .75rem .9rem;
      background: var(--surface-d); border-radius: 10px; border: 1px solid var(--border);
    }
    .attempts-label { display: flex; justify-content: space-between; align-items: center; font-size: .75rem; color: var(--text-dim); margin-bottom: .45rem; }
    .attempts-label strong { color: #F97316; font-weight: 700; }
    .attempts-track { height: 4px; background: var(--surface-h); border-radius: 99px; overflow: hidden; }
    .attempts-fill { height: 100%; border-radius: 99px; background: linear-gradient(90deg, #22C55E, #F97316); transition: width .4s ease; }
    .attempts-fill.danger { background: linear-gradient(90deg, #F97316, #EF4444); }

    /* Countdown blocage */
    .lock-box {
      text-align: center; padding: 2.5rem 1.5rem;
      background: var(--surface-d); border: 1px solid var(--border);
      border-radius: 16px; margin-bottom: 1.5rem;
    }
    .lock-icon { font-size: 3rem; margin-bottom: .75rem; }
    .lock-timer { font-size: 2.5rem; font-weight: 900; color: #EF4444; letter-spacing: .05em; margin: .5rem 0; font-variant-numeric: tabular-nums; }
    .lock-msg   { font-size: .82rem; color: var(--text-dim); line-height: 1.6; }

    /* Champs */
    .field { margin-bottom: 1.1rem; }
    .field label {
      display: block; font-size: .72rem; font-weight: 700;
      color: var(--text-dim); letter-spacing: .06em; text-transform: uppercase; margin-bottom: .45rem;
    }
    .field-inner { position: relative; }
    .field input {
      width: 100%; padding: .8rem 1rem;
      background: var(--surface-d); border: 1.5px solid var(--border);
      border-radius: 11px; color: var(--text);
      font-size: .95rem; font-family: inherit;
      outline: none; transition: border-color .2s, box-shadow .2s;
    }
    .field input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(var(--primary-rgb), .12);
      background: var(--surface);
    }
    .field input.has-icon { padding-right: 2.85rem; }
    .field input::placeholder { color: var(--text-dim); opacity: .6; }
    .field-icon {
      position: absolute; right: .9rem; top: 50%; transform: translateY(-50%);
      color: var(--text-dim); cursor: pointer; font-size: .9rem;
      background: none; border: none; padding: 0; line-height: 1;
      transition: color .15s;
    }
    .field-icon:hover { color: var(--primary); }

    /* Checkbox remember */
    .remember-wrap {
      display: flex; align-items: center; gap: .5rem;
      font-size: .82rem; color: var(--text-dim);
      cursor: pointer; user-select: none; margin-bottom: 1.5rem;
    }
    .remember-wrap input { accent-color: var(--primary); width: 15px; height: 15px; cursor: pointer; }

    /* Bouton */
    .login-btn {
      width: 100%; padding: .9rem;
      background: linear-gradient(135deg, #E8541A, #C43F0D);
      color: #fff; border: none; border-radius: 11px; cursor: pointer;
      font-size: .95rem; font-weight: 700; font-family: inherit;
      transition: opacity .15s, transform .1s, box-shadow .15s;
      box-shadow: 0 4px 20px rgba(232,84,26,.35);
      display: flex; align-items: center; justify-content: center; gap: .5rem;
      letter-spacing: .01em;
    }
    .login-btn:hover:not(:disabled) { opacity: .9; box-shadow: 0 6px 24px rgba(232,84,26,.45); transform: translateY(-1px); }
    .login-btn:active:not(:disabled) { transform: scale(.98) translateY(0); }
    .login-btn:disabled { opacity: .55; cursor: not-allowed; }
    .login-btn-spinner {
      width: 16px; height: 16px; border: 2px solid rgba(255,255,255,.3);
      border-top-color: #fff; border-radius: 50%;
      animation: spin .6s linear infinite; display: none;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* Séparateur */
    .form-divider {
      display: flex; align-items: center; gap: .75rem;
      margin: 1.5rem 0; color: var(--text-dim); font-size: .75rem;
    }
    .form-divider::before, .form-divider::after {
      content: ''; flex: 1; height: 1px; background: var(--border);
    }

    /* Footer */
    .login-footer {
      margin-top: 2rem; padding-top: 1.25rem;
      border-top: 1px solid var(--border);
      text-align: center; font-size: .75rem; color: var(--text-dim);
      display: flex; align-items: center; justify-content: center; gap: .5rem;
    }
    .login-footer-dot { opacity: .3; }

    /* Shake */
    .login-right.shake { animation: shake .4s cubic-bezier(.36,.07,.19,.97); }
    @keyframes shake {
      10%,90% { transform: translateX(-4px); }
      20%,80% { transform: translateX(5px); }
      30%,50%,70% { transform: translateX(-5px); }
      40%,60% { transform: translateX(5px); }
    }

    /* ── Responsive : mobile = pile ── */
    @media (max-width: 768px) {
      body { flex-direction: column; overflow: auto; }
      .login-left { display: none; }
      .login-right { width: 100%; min-height: 100vh; padding: 2rem 1.5rem; }
    }
    @media (max-width: 1100px) {
      .login-left { flex: none; width: 45%; }
    }
  </style>
</head>
<body>

<!-- ══ PANNEAU GAUCHE ══ -->
<div class="login-left">
  <div class="left-top">
    <div class="left-logo">
      <div class="left-logo-icon">⚽</div>
      <div>
        <div class="left-logo-name">Prono<span>Win</span></div>
        <div class="left-logo-sub">Administration</div>
      </div>
    </div>
  </div>

  <div class="left-hero">
    <div class="left-hero-badge">LIVE</div>
    <h2>Gérez vos<br>pronostics<br><em>en temps réel</em></h2>
    <p>Tableau de bord complet pour piloter les pronostics, les utilisateurs premium et les performances de PronoWin.</p>
    <div class="left-features">
      <div class="feature-item">
        <div class="feature-icon">📊</div>
        Statistiques et analytics avancées
      </div>
      <div class="feature-item">
        <div class="feature-icon">👥</div>
        Gestion des utilisateurs & abonnements
      </div>
      <div class="feature-item">
        <div class="feature-icon">⚽</div>
        Publication & suivi des pronostics IA
      </div>
      <div class="feature-item">
        <div class="feature-icon">🔒</div>
        Accès sécurisé multi-admins
      </div>
    </div>
  </div>

  <div class="left-stats">
    <div class="left-stats-grid">
      <div class="stat-item">
        <div class="stat-val">99%</div>
        <div class="stat-lbl">Disponibilité</div>
      </div>
      <div class="stat-item">
        <div class="stat-val">IA</div>
        <div class="stat-lbl">Pronostics assistés</div>
      </div>
      <div class="stat-item">
        <div class="stat-val">Live</div>
        <div class="stat-lbl">Données en direct</div>
      </div>
    </div>
  </div>
</div>

<!-- ══ PANNEAU DROIT ══ -->
<div class="login-right" id="login-right">

  <!-- Mode toggle -->
  <div class="theme-row">
    <button class="theme-btn" id="lt-dark"  onclick="setLoginMode('dark')"  title="Mode sombre">🌙</button>
    <button class="theme-btn" id="lt-light" onclick="setLoginMode('light')" title="Mode clair">☀️</button>
  </div>

  <!-- Header -->
  <div class="form-header">
    <h3>Bon retour 👋</h3>
    <p>Connectez-vous pour accéder au panel d'administration.</p>
  </div>

  <%
    const _remaining      = typeof remaining !== 'undefined' ? remaining : 5;
    const _maxAttempts    = 5;
    const _blockedUntilMs = typeof blockedUntilMs !== 'undefined' ? blockedUntilMs : null;
    const _isLocked       = !!locked || !!_blockedUntilMs;
    const _isExpired      = typeof expired !== 'undefined' && expired;
    const _username       = typeof username !== 'undefined' ? username : '';
  %>

  <% if (_isExpired && !_isLocked && !error) { %>
  <div class="login-alert info">
    <span>⏰</span>
    <span>Votre session a expiré. Reconnectez-vous pour continuer.</span>
  </div>
  <% } %>

  <% if (error && !_isLocked) { %>
  <div class="login-alert error">
    <span>⚠️</span>
    <div>
      <%= error %>
      <% if (_remaining > 0 && _remaining <= 3) { %>
      <div style="margin-top:.3rem;font-size:.78rem;opacity:.85">
        Il vous reste <strong><%= _remaining %> tentative<%= _remaining > 1 ? 's' : '' %></strong> avant blocage.
      </div>
      <% } %>
    </div>
  </div>
  <% } %>

  <% if (error && !_isLocked && _remaining <= 3 && _remaining > 0) { %>
  <div class="attempts-bar">
    <div class="attempts-label">
      <span>Tentatives restantes</span>
      <strong><%= _remaining %> / <%= _maxAttempts %></strong>
    </div>
    <div class="attempts-track">
      <div class="attempts-fill <%= _remaining <= 1 ? 'danger' : '' %>"
           style="width:<%= Math.round((_remaining / _maxAttempts) * 100) %>%"></div>
    </div>
  </div>
  <% } %>

  <% if (_isLocked) { %>
  <div class="lock-box">
    <div class="lock-icon">🔐</div>
    <div class="lock-timer" id="lock-timer">—:——</div>
    <div class="lock-msg">Trop de tentatives échouées.<br>L'accès se débloque automatiquement.</div>
  </div>
  <% } %>

  <% if (!_isLocked) { %>
  <form method="POST" action="/admin/login" id="login-form" autocomplete="on">

    <div class="field">
      <label for="username">Identifiant</label>
      <div class="field-inner">
        <input type="text" id="username" name="username"
               value="<%= _username %>"
               placeholder="admin ou sous-admin"
               required autofocus autocomplete="username"
               class="has-icon">
        <span class="field-icon">👤</span>
      </div>
    </div>

    <div class="field">
      <label for="password">Mot de passe</label>
      <div class="field-inner">
        <input type="password" id="password" name="password"
               placeholder="••••••••"
               required autocomplete="current-password"
               class="has-icon">
        <button type="button" class="field-icon" id="pwd-toggle" onclick="togglePwd()" tabindex="-1" title="Afficher / masquer">👁</button>
      </div>
    </div>

    <label class="remember-wrap">
      <input type="checkbox" name="remember" value="1"> Se souvenir de moi (30 jours)
    </label>

    <button type="submit" class="login-btn" id="submit-btn">
      <span class="login-btn-spinner" id="btn-spinner"></span>
      <span id="btn-label">Se connecter →</span>
    </button>

  </form>
  <% } %>

  <div class="login-footer">
    <span>PronoWin Admin</span>
    <span class="login-footer-dot">·</span>
    <span>Accès réservé</span>
    <span class="login-footer-dot">·</span>
    <span id="footer-time"></span>
  </div>
</div>

<script>
/* ── Thème ── */
function setLoginMode(mode) {
  const h = document.getElementById('login-html');
  if (mode === 'light') h.classList.add('light'); else h.classList.remove('light');
  localStorage.setItem('pw_mode', mode);
  _updateModeBtn(mode);
}
function _updateModeBtn(mode) {
  document.getElementById('lt-dark') ?.classList.toggle('active', mode === 'dark');
  document.getElementById('lt-light')?.classList.toggle('active', mode === 'light');
}
_updateModeBtn(localStorage.getItem('pw_mode') || 'dark');

/* ── Toggle mot de passe ── */
function togglePwd() {
  const inp = document.getElementById('password');
  const btn = document.getElementById('pwd-toggle');
  if (!inp) return;
  const shown = inp.type === 'text';
  inp.type = shown ? 'password' : 'text';
  btn.textContent = shown ? '👁' : '🙈';
}

/* ── Soumission ── */
const form      = document.getElementById('login-form');
const submitBtn = document.getElementById('submit-btn');
const spinner   = document.getElementById('btn-spinner');
const btnLabel  = document.getElementById('btn-label');
if (form) {
  form.addEventListener('submit', function() {
    if (submitBtn) {
      submitBtn.disabled    = true;
      spinner.style.display = 'block';
      btnLabel.textContent  = 'Connexion…';
    }
  });
}

/* ── Shake sur erreur ── */
<% if (error && !_isLocked) { %>
(function() {
  const el = document.getElementById('login-right');
  if (el) {
    el.classList.add('shake');
    el.addEventListener('animationend', () => el.classList.remove('shake'), { once: true });
  }
})();
<% } %>

/* ── Countdown blocage ── */
<% if (_isLocked && _blockedUntilMs) { %>
(function() {
  const el  = document.getElementById('lock-timer');
  const end = <%= _blockedUntilMs %>;
  function tick() {
    const left = Math.max(0, end - Date.now());
    if (left === 0) { if (el) el.textContent = '00:00'; setTimeout(() => location.reload(), 800); return; }
    const m = String(Math.floor(left / 60000)).padStart(2, '0');
    const s = String(Math.floor((left % 60000) / 1000)).padStart(2, '0');
    if (el) el.textContent = m + ':' + s;
    setTimeout(tick, 1000);
  }
  tick();
})();
<% } else if (_isLocked) { %>
(function() {
  const el = document.getElementById('lock-timer');
  if (el) el.textContent = '15:00';
})();
<% } %>

/* ── Horloge footer ── */
(function() {
  const el = document.getElementById('footer-time');
  function tick() {
    if (el) el.textContent = new Date().toLocaleTimeString('fr-FR', { hour:'2-digit', minute:'2-digit', second:'2-digit' });
    setTimeout(tick, 1000);
  }
  tick();
})();
</script>
</body>
</html>
