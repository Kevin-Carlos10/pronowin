<%- include('layout_top', { page: 'bans' }) %>

<style>
/* ── Stats ── */
.bans-stats { display:grid; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); gap:.65rem; margin-bottom:1rem; }
.ban-stat { background:var(--surface); border:1px solid var(--border); border-left:3px solid var(--border-s); border-radius:14px; padding:.9rem 1.1rem; transition:transform .2s,box-shadow .2s; }
.ban-stat:hover { transform:translateY(-2px); box-shadow:0 8px 24px rgba(0,0,0,.2); }
.ban-stat .bs-val { font-size:1.7rem; font-weight:900; line-height:1; margin-top:.1rem; letter-spacing:-.03em; }
.ban-stat .bs-lbl { font-size:.68rem; text-transform:uppercase; letter-spacing:.06em; color:var(--text-dim); font-weight:700; margin-bottom:2px; }

/* ── Filter tabs ── */
.bans-bar { display:flex; gap:.6rem; align-items:center; flex-wrap:wrap; margin-bottom:1rem; }
.filter-tabs { display:flex; gap:.3rem; background:var(--surface-d); border-radius:var(--radius-s); padding:.25rem; }
.filter-tab { padding:.3rem .85rem; border-radius:calc(var(--radius-s) - 2px); font-size:.78rem; font-weight:600; color:var(--text-dim); text-decoration:none; border:none; background:none; cursor:pointer; transition:all .15s; }
.filter-tab.active { background:var(--surface); color:var(--text); box-shadow:0 1px 3px rgba(0,0,0,.2); }

/* ── Row styles ── */
.ban-row-active  { border-left:3px solid var(--error); }
.ban-row-expired { border-left:3px solid var(--border); opacity:.75; }
.ban-row-soon    { border-left:3px solid var(--warning); }
.ban-pseudo { font-weight:700; color:var(--text); }
.ban-uid    { font-size:.72rem; color:var(--text-dim); font-family:monospace; }

/* ── Pills ── */
.dur-pill { display:inline-flex; align-items:center; gap:.3rem; font-size:.75rem; font-weight:700; padding:.2rem .6rem; border-radius:99px; }
.dur-perm { background:rgba(239,68,68,.12); color:var(--error); }
.dur-temp { background:rgba(245,158,11,.12); color:var(--warning); }
.dur-done { background:var(--surface-d); color:var(--text-dim); }
.st-pill  { display:inline-flex; align-items:center; gap:.3rem; font-size:.72rem; font-weight:700; padding:.2rem .55rem; border-radius:99px; }
.st-active  { background:rgba(239,68,68,.1);  color:var(--error); }
.st-expired { background:var(--surface-d); color:var(--text-dim); }
.st-soon    { background:rgba(245,158,11,.1); color:var(--warning); }

/* ── Quick ban card ── */
.quick-ban-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:1.1rem 1.25rem; margin-bottom:1rem; display:none; }
.quick-ban-card.open { display:block; }

/* ── Raison cell ── */
.reason-cell { max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

/* ── Expiration progress ── */
.exp-bar  { height:4px; background:var(--surface-d); border-radius:99px; margin-top:.3rem; overflow:hidden; }
.exp-fill { height:100%; border-radius:99px; transition:width .3s; }
</style>

<%
  function fmtD(iso) {
    if (!iso) return '—';
    return new Date(iso).toLocaleDateString('fr-FR', { day:'2-digit', month:'2-digit', year:'numeric' });
  }
  function relT(iso) {
    if (!iso) return '—';
    const d = Date.now() - new Date(iso).getTime();
    const s = Math.floor(d / 1000);
    if (s < 60)   return "à l'instant";
    const m = Math.floor(s / 60);
    if (m < 60)   return 'il y a ' + m + 'min';
    const h = Math.floor(m / 60);
    if (h < 24)   return 'il y a ' + h + 'h';
    const dy = Math.floor(h / 24);
    if (dy < 30)  return 'il y a ' + dy + 'j';
    return fmtD(iso);
  }
  function expireIn(iso) {
    if (!iso) return null;
    const ms = new Date(iso).getTime() - Date.now();
    if (ms <= 0) return 'Expiré';
    const d = Math.floor(ms / 86400000);
    const h = Math.floor((ms % 86400000) / 3600000);
    if (d > 0) return 'dans ' + d + 'j' + (h > 0 ? ' ' + h + 'h' : '');
    return 'dans ' + h + 'h';
  }
  function expPct(bannedAt, expiresAt) {
    if (!expiresAt || !bannedAt) return 100;
    var total   = new Date(expiresAt).getTime() - new Date(bannedAt).getTime();
    var elapsed = Date.now() - new Date(bannedAt).getTime();
    return Math.min(100, Math.max(0, Math.round(elapsed / total * 100)));
  }
%>

<!-- ── Header ── -->
<div class="topbar">
  <div>
    <h2><svg class="ic" aria-hidden="true"><use href="#ic-ban"/></svg> Bannissements</h2>
    <small>
      <% if (filter === 'active') { %><%= stats.active %> ban<%= stats.active!==1?'s':'' %> actif<%= stats.active!==1?'s':'' %>
      <% } else if (filter === 'expired') { %><%= total %> entrée<%= total!==1?'s':'' %> levées/expirées
      <% } else { %><%= stats.total %> ban<%= stats.total!==1?'s':'' %> au total<% } %>
    </small>
  </div>
  <div style="display:flex;gap:.5rem;flex-wrap:wrap">
    <button class="btn btn-outline btn-sm" onclick="toggleQuickBan()"><svg class="ic" aria-hidden="true"><use href="#ic-plus"/></svg> Bannir un utilisateur</button>
    <a href="/admin/bans/export" class="btn btn-outline btn-sm" onclick="exportBtnFeedback(this)"><svg class="ic" aria-hidden="true"><use href="#ic-download"/></svg> Export CSV</a>
  </div>
</div>

<% if (success) { %><div class="alert alert-success" style="display:none"><%= success %></div><% } %>
<% if (error)   { %><div class="alert alert-error"   style="display:none"><%= error %></div><% } %>

<%# Un ban expiré ne rendait pas l'accès au compte : la tâche de fond ne
    dispose d'aucun jeton, elle ne mettait donc à jour que le fichier local.
    La réconciliation se fait à l'ouverture de cette page ; on dit ce qui a
    été fait plutôt que de le faire en silence. %>
<% const _r = typeof restauration !== 'undefined' && restauration ? restauration : null; %>
<% if (_r && _r.restaures && _r.restaures.length) { %>
<div class="alert alert-success" data-toast="skip">
  <svg class="ic" aria-hidden="true"><use href="#ic-check"/></svg>
  <strong><%= _r.restaures.length %> compte<%= _r.restaures.length !== 1 ? 's' : '' %></strong>
  dont le ban a expiré <%= _r.restaures.length !== 1 ? 'ont' : 'a' %> retrouvé l'accès :
  <%= _r.restaures.map(b => b.pseudo).join(', ') %>.
</div>
<% } %>
<% if (_r && _r.echecs > 0) { %>
<div class="alert alert-warning" data-toast="skip">
  <svg class="ic" aria-hidden="true"><use href="#ic-alert"/></svg>
  <strong><%= _r.echecs %> compte<%= _r.echecs !== 1 ? 's' : '' %></strong>
  dont le ban a expiré <%= _r.echecs !== 1 ? 'restent' : 'reste' %> suspendu<%= _r.echecs !== 1 ? 's' : '' %> :
  l'API n'a pas pu être jointe. Rechargez cette page une fois le backend disponible.
</div>
<% } %>

<!-- ── Stats ── -->
<div class="bans-stats">
  <div class="ban-stat" style="border-left-color:var(--error)">
    <div class="bs-lbl"><svg class="ic" aria-hidden="true"><use href="#ic-ban"/></svg> Actifs</div>
    <div class="bs-val" style="color:var(--error)"><%= stats.active %></div>
  </div>
  <div class="ban-stat" style="border-left-color:var(--error)">
    <div class="bs-lbl"><svg class="ic" aria-hidden="true"><use href="#ic-infinity"/></svg> Permanents</div>
    <div class="bs-val" style="color:var(--error)"><%= stats.permanent %></div>
  </div>
  <div class="ban-stat" style="border-left-color:var(--warning)">
    <div class="bs-lbl">⏳ Temporaires</div>
    <div class="bs-val" style="color:var(--warning)"><%= stats.temporary %></div>
  </div>
  <div class="ban-stat" style="border-left-color:var(--warning)">
    <div class="bs-lbl"><svg class="ic" aria-hidden="true"><use href="#ic-bell"/></svg> Expirent ≤ 7j</div>
    <div class="bs-val" style="color:var(--warning)"><%= stats.expiringSoon %></div>
  </div>
  <div class="ban-stat">
    <div class="bs-lbl"><svg class="ic" aria-hidden="true"><use href="#ic-calendar"/></svg> Aujourd'hui</div>
    <div class="bs-val" style="color:var(--text-dim)"><%= stats.today %></div>
  </div>
  <div class="ban-stat">
    <div class="bs-lbl"><svg class="ic" aria-hidden="true"><use href="#ic-clipboard"/></svg> Total historique</div>
    <div class="bs-val"><%= stats.total %></div>
  </div>
</div>

<!-- ── Formulaire ban rapide ── -->
<div class="quick-ban-card" id="quick-ban-card">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.9rem">
    <h3 style="font-size:.9rem;font-weight:700;margin:0"><svg class="ic" aria-hidden="true"><use href="#ic-plus"/></svg> Bannir un utilisateur</h3>
    <button onclick="toggleQuickBan()" style="background:none;border:none;cursor:pointer;color:var(--text-dim);font-size:1.2rem;line-height:1;padding:0">×</button>
  </div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem">
    <div>
      <label style="font-size:.72rem;font-weight:700;color:var(--text-dim);text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:.3rem">
        ID utilisateur <span style="color:var(--error)">*</span>
      </label>
      <input class="input" type="text" id="qb-userid" placeholder="ID numérique de l'utilisateur" required aria-label="ID numérique de l'utilisateur">
      <div style="font-size:.68rem;color:var(--text-dim);margin-top:.2rem">Trouvez l'ID sur la page utilisateur</div>
    </div>
    <div>
      <label style="font-size:.72rem;font-weight:700;color:var(--text-dim);text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:.3rem">
        Pseudo (affiché)
      </label>
      <input class="input" type="text" id="qb-pseudo" placeholder="Pseudo de l'utilisateur" aria-label="Pseudo de l'utilisateur">
    </div>
    <div>
      <label style="font-size:.72rem;font-weight:700;color:var(--text-dim);text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:.3rem">
        Raison <span style="color:var(--error)">*</span>
      </label>
      <input class="input" type="text" id="qb-reason" aria-label="Raison du bannissement" placeholder="Ex: Comportement abusif, fraude…" maxlength="500" required>
    </div>
    <div>
      <label style="font-size:.72rem;font-weight:700;color:var(--text-dim);text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:.3rem">
        Durée
      </label>
      <select class="input" id="qb-duration" aria-label="Durée du bannissement">
        <option value="1">1 jour</option>
        <option value="3">3 jours</option>
        <option value="7" selected>7 jours</option>
        <option value="14">14 jours</option>
        <option value="30">30 jours</option>
        <option value="90">90 jours</option>
        <option value="0">Permanent ♾️</option>
      </select>
    </div>
    <div style="grid-column:1/-1;display:flex;justify-content:flex-end;gap:.5rem">
      <button class="btn btn-outline" onclick="toggleQuickBan()">Annuler</button>
      <button class="btn btn-danger"
        onclick="askConfirm({icon:'ban',title:'Confirmer le bannissement',msg:'Bannir cet utilisateur ?',btnLabel:'Bannir',btnClass:'btn-danger',onConfirm:submitQuickBan})">
        <svg class="ic" aria-hidden="true"><use href="#ic-ban"/></svg> Bannir
      </button>
    </div>
  </div>
</div>

<!-- ── Filtres + Recherche ── -->
<div class="bans-bar">
  <div class="filter-tabs">
    <a href="/admin/bans?filter=active<%= search ? '&search='+encodeURIComponent(search) : '' %>"
      class="filter-tab <%= filter==='active'?'active':'' %>"><svg class="ic" aria-hidden="true"><use href="#ic-ban"/></svg> Actifs <span style="font-size:.7rem;opacity:.7">(<%= stats.active %>)</span></a>
    <a href="/admin/bans?filter=expired<%= search ? '&search='+encodeURIComponent(search) : '' %>"
      class="filter-tab <%= filter==='expired'?'active':'' %>"><svg class="ic" aria-hidden="true"><use href="#ic-check"/></svg> Levés/Expirés</a>
    <a href="/admin/bans?filter=all<%= search ? '&search='+encodeURIComponent(search) : '' %>"
      class="filter-tab <%= filter==='all'?'active':'' %>"><svg class="ic" aria-hidden="true"><use href="#ic-clipboard"/></svg> Tous (<%= stats.total %>)</a>
  </div>

  <form method="GET" action="/admin/bans" style="display:flex;gap:.4rem;flex:1;max-width:340px">
    <input type="hidden" name="filter" value="<%= filter %>">
    <input class="input" type="search" name="search" value="<%= search %>"
      placeholder="Pseudo, raison, admin…" style="flex:1" aria-label="Rechercher">
    <button class="btn btn-primary btn-sm" type="submit" aria-label="Lancer la recherche"><svg class="ic" aria-hidden="true"><use href="#ic-search"/></svg></button>
    <% if (search) { %>
    <a href="/admin/bans?filter=<%= filter %>" class="btn btn-outline btn-sm"><svg class="ic" aria-hidden="true"><use href="#ic-x"/></svg></a>
    <% } %>
  </form>
</div>

<!-- ── Empty state ── -->
<% if (bans.length === 0) { %>
<div style="text-align:center;padding:3.5rem 1rem;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius)">
  <%# L'ecran ne disait pas ce qu'un ban fait reellement, ni ou il se declenche.
      Un administrateur arrivant ici pour sanctionner quelqu'un repartait sans
      savoir qu'il faut passer par la fiche de l'utilisateur. %>
  <div style="width:62px;height:62px;border-radius:50%;margin:0 auto .9rem;
              background:rgba(34,197,94,.10);color:var(--success);
              display:flex;align-items:center;justify-content:center">
    <svg class="ic ic-xl" aria-hidden="true"><use href="#ic-<%= filter==='active' ? 'check-circle' : 'clipboard' %>"/></svg>
  </div>
  <h3 style="font-weight:800;margin-bottom:.4rem;font-size:1.1rem">
    <% if (search) { %>Aucun résultat pour « <%= search %> »
    <% } else if (filter==='active') { %>Aucun ban actif
    <% } else { %>Aucun bannissement<% } %>
  </h3>
  <p style="color:var(--text-m);font-size:.86rem;margin:0 auto 1rem;max-width:52ch;line-height:1.65">
    <% if (search) { %>
      La recherche porte sur le pseudo, la raison et l'administrateur.
    <% } else if (filter==='active') { %>
      Personne n'est banni actuellement.
      <% if (stats.total > 0) { %>
        <strong><%= stats.total %></strong> bannissement<%= stats.total !== 1 ? 's' : '' %>
        figure<%= stats.total !== 1 ? 'nt' : '' %> à l'historique.
      <% } %>
    <% } else { %>
      Aucun bannissement n'a encore été prononcé.
    <% } %>
  </p>

  <% if (!search && filter==='active') { %>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:.8rem;
              max-width:640px;margin:1.4rem auto 0;text-align:left">
    <div style="background:var(--surface-d);border:1px solid var(--border);border-radius:12px;padding:.85rem .9rem">
      <div style="font-size:.8rem;font-weight:700;margin-bottom:.25rem">Où bannir</div>
      <div style="font-size:.74rem;color:var(--text-dim);line-height:1.5">
        Depuis la fiche d'un utilisateur, section <em>Modération</em>. Une raison est obligatoire.
      </div>
    </div>
    <div style="background:var(--surface-d);border:1px solid var(--border);border-radius:12px;padding:.85rem .9rem">
      <div style="font-size:.8rem;font-weight:700;margin-bottom:.25rem">Ce que ça fait</div>
      <div style="font-size:.74rem;color:var(--text-dim);line-height:1.5">
        Le compte est suspendu : plus de connexion à l'application tant que le ban court.
      </div>
    </div>
    <div style="background:var(--surface-d);border:1px solid var(--border);border-radius:12px;padding:.85rem .9rem">
      <div style="font-size:.8rem;font-weight:700;margin-bottom:.25rem">Durée</div>
      <div style="font-size:.74rem;color:var(--text-dim);line-height:1.5">
        Un ban temporaire rend l'accès automatiquement à son échéance. Un ban permanent se lève à la main.
      </div>
    </div>
  </div>
  <div style="margin-top:1.3rem;display:flex;gap:.5rem;justify-content:center;flex-wrap:wrap">
    <a href="/admin/users" class="btn btn-outline btn-sm">
      <svg class="ic" aria-hidden="true"><use href="#ic-users"/></svg> Aller aux utilisateurs
    </a>
    <% if (stats.total > 0) { %>
    <a href="/admin/bans?filter=all" class="btn btn-outline btn-sm">
      <svg class="ic" aria-hidden="true"><use href="#ic-clipboard"/></svg> Voir l'historique
    </a>
    <% } %>
  </div>
  <% } %>

  <% if (search) { %>
  <a href="/admin/bans?filter=<%= filter %>" class="btn btn-outline btn-sm" style="margin-top:.4rem">Voir tous les bans</a>
  <% } %>
</div>

<% } else { %>
<!-- ── Tableau ── -->
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th scope="col">Utilisateur</th>
        <th scope="col">Raison</th>
        <th scope="col">Durée</th>
        <th scope="col">Banni le</th>
        <th scope="col">Expire le</th>
        <th scope="col">Par</th>
        <th scope="col">Statut</th>
        <th scope="col" style="text-align:right">Actions</th>
      </tr>
    </thead>
    <tbody>
    <% bans.forEach(function(b) {
      var now2      = Date.now();
      var isExpired = !b.active || (b.expiresAt && new Date(b.expiresAt).getTime() <= now2);
      var isSoon    = b.active && b.expiresAt && (new Date(b.expiresAt).getTime() - now2) <= 7 * 86400000 && !isExpired;
      var rowClass  = isExpired ? 'ban-row-expired' : isSoon ? 'ban-row-soon' : 'ban-row-active';
      var pct       = expPct(b.bannedAt, b.expiresAt);
    %>
    <tr class="<%= rowClass %>">

      <!-- Utilisateur -->
      <td>
        <div class="ban-pseudo">
          <%= b.pseudo || '—' %>
          <% if (isSoon) { %><span style="font-size:.65rem;color:var(--warning);margin-left:.3rem"><svg class="ic" aria-hidden="true"><use href="#ic-alert"/></svg></span><% } %>
        </div>
        <div class="ban-uid">ID&nbsp;<%= b.userId %></div>
      </td>

      <!-- Raison -->
      <td>
        <div class="reason-cell" title="<%= b.reason %>"><%= b.reason || '—' %></div>
        <% if (b.unbanReason) { %>
        <div style="font-size:.7rem;color:var(--success);margin-top:.2rem"><svg class="ic" aria-hidden="true"><use href="#ic-check"/></svg> Note : <%= b.unbanReason %></div>
        <% } %>
      </td>

      <!-- Durée -->
      <td>
        <% if (!b.durationDays || b.durationDays === 0) { %>
          <span class="dur-pill <%= isExpired ? 'dur-done' : 'dur-perm' %>"><svg class="ic" aria-hidden="true"><use href="#ic-infinity"/></svg> Permanent</span>
        <% } else { %>
          <span class="dur-pill <%= isExpired ? 'dur-done' : 'dur-temp' %>">⏳ <%= b.durationDays %>j</span>
        <% } %>
      </td>

      <!-- Banni le -->
      <td>
        <div style="font-size:.82rem"><%= fmtD(b.bannedAt) %></div>
        <div style="font-size:.7rem;color:var(--text-dim)"><%= relT(b.bannedAt) %></div>
      </td>

      <!-- Expire le -->
      <td>
        <% if (!b.expiresAt) { %>
          <span style="font-size:.8rem;color:var(--text-dim)">Jamais</span>
        <% } else { %>
          <div style="font-size:.82rem"><%= fmtD(b.expiresAt) %></div>
          <% if (!isExpired) { %>
          <div style="font-size:.7rem;color:<%= isSoon ? 'var(--warning)' : 'var(--text-dim)' %>"><%= expireIn(b.expiresAt) %></div>
          <div class="exp-bar">
            <div class="exp-fill" style="width:<%= pct %>%;background:<%= pct>=90?'var(--error)':pct>=65?'var(--warning)':'var(--success)' %>"></div>
          </div>
          <% } else { %>
          <div style="font-size:.7rem;color:var(--text-dim)">Expiré</div>
          <% } %>
        <% } %>
      </td>

      <!-- Par -->
      <td>
        <div style="font-size:.82rem"><%= b.bannedBy || '—' %></div>
        <% if (b.unbannedBy) { %>
        <div style="font-size:.7rem;color:var(--success)">Levé par <%= b.unbannedBy %></div>
        <% } %>
      </td>

      <!-- Statut -->
      <td>
        <% if (!b.active && b.unbannedAt) { %>
          <span class="st-pill st-expired"><svg class="ic" aria-hidden="true"><use href="#ic-check"/></svg> Levé</span>
        <% } else if (isExpired) { %>
          <span class="st-pill st-expired">⏰ Expiré</span>
        <% } else if (isSoon) { %>
          <span class="st-pill st-soon"><svg class="ic" aria-hidden="true"><use href="#ic-alert"/></svg> Expire bientôt</span>
        <% } else { %>
          <span class="st-pill st-active"><svg class="ic" aria-hidden="true"><use href="#ic-ban"/></svg> Actif</span>
        <% } %>
      </td>

      <!-- Actions -->
      <td style="text-align:right;white-space:nowrap">
        <div style="display:flex;gap:.4rem;justify-content:flex-end">
          <a href="/admin/users/<%= b.userId %>" class="btn btn-outline btn-xs" title="Voir le profil"><svg class="ic" aria-hidden="true"><use href="#ic-user"/></svg></a>
          <% if (b.active && !isExpired) { %>
          <form method="POST" action="/admin/users/<%= b.userId %>/unban" style="display:inline">
            <input type="hidden" name="pseudo" value="<%= b.pseudo %>">
            <input type="hidden" name="redirect_to" value="/admin/bans?filter=<%= filter %><%= search ? '&search='+encodeURIComponent(search) : '' %>">
            <button type="button" class="btn btn-outline btn-xs"
              style="color:var(--success);border-color:var(--success)"
              data-pseudo="<%= b.pseudo %>"
              onclick="(function(btn){askConfirm({icon:'check',title:'Lever le bannissement',msg:'Lever le ban de <strong>'+btn.dataset.pseudo+'</strong> ?',btnLabel:'Lever le ban',btnClass:'btn-outline',onConfirm:function(){btn.closest('form').submit()}})})(this)">
              <svg class="ic" aria-hidden="true"><use href="#ic-check"/></svg> Lever
            </button>
          </form>
          <% } %>
        </div>
      </td>
    </tr>
    <% }); %>
    </tbody>
  </table>
</div>

<!-- ── Pagination ── -->
<% if (totalPages > 1) { %>
<div class="pagination" style="margin-top:1rem;display:flex;align-items:center;gap:.4rem">
  <a href="/admin/bans?filter=<%= filter %><%= search?'&search='+encodeURIComponent(search):'' %>&page=1"
    class="btn btn-outline btn-sm <%= page<=1?'disabled':'' %>">«</a>
  <a href="/admin/bans?filter=<%= filter %><%= search?'&search='+encodeURIComponent(search):'' %>&page=<%= page-1 %>"
    class="btn btn-outline btn-sm <%= page<=1?'disabled':'' %>">‹</a>
  <span style="font-size:.82rem;color:var(--text-dim);padding:0 .5rem">
    Page <strong style="color:var(--text)"><%= page %></strong> / <%= totalPages %>
    · <span><%= total %> résultat<%= total!==1?'s':'' %></span>
  </span>
  <a href="/admin/bans?filter=<%= filter %><%= search?'&search='+encodeURIComponent(search):'' %>&page=<%= page+1 %>"
    class="btn btn-outline btn-sm <%= page>=totalPages?'disabled':'' %>">›</a>
  <a href="/admin/bans?filter=<%= filter %><%= search?'&search='+encodeURIComponent(search):'' %>&page=<%= totalPages %>"
    class="btn btn-outline btn-sm <%= page>=totalPages?'disabled':'' %>">»</a>
</div>
<% } %>
<% } %>

<script>
function toggleQuickBan() {
  const card = document.getElementById('quick-ban-card');
  card.classList.toggle('open');
  if (card.classList.contains('open')) {
    setTimeout(() => document.getElementById('qb-userid').focus(), 50);
  }
}

function submitQuickBan() {
  const userId   = document.getElementById('qb-userid').value.trim();
  const pseudo   = document.getElementById('qb-pseudo').value.trim() || userId;
  const reason   = document.getElementById('qb-reason').value.trim();
  const duration = document.getElementById('qb-duration').value;

  if (!userId) { showToast('L\'ID utilisateur est obligatoire.', 'error'); return; }
  if (!reason) { showToast('La raison est obligatoire.', 'error'); return; }

  const f = document.createElement('form');
  f.method = 'POST';
  f.action = '/admin/users/' + encodeURIComponent(userId) + '/ban';
  [['reason', reason], ['duration_days', duration], ['pseudo', pseudo], ['redirect_to', '/admin/bans']].forEach(function(pair) {
    const i = document.createElement('input');
    i.type = 'hidden'; i.name = pair[0]; i.value = pair[1];
    f.appendChild(i);
  });
  document.body.appendChild(f);
  f.submit();
}
</script>

<%- include('layout_bottom') %>
