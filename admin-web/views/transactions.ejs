<%- include('layout_top', {page:'transactions'}) %>

<style>
/* ── Cartes de versement ─────────────────────────────────────────────────── */
.tx-card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 16px; overflow: hidden;
  transition: box-shadow .2s, border-color .2s, transform .2s;
}
.tx-card:hover { box-shadow: 0 10px 32px rgba(0,0,0,.25); transform: translateY(-2px); }
.tx-card.withdrawal { border-left: 3px solid var(--warning); }

.tx-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: .85rem 1.25rem; border-bottom: 1px solid var(--border);
  gap: .75rem; flex-wrap: wrap;
}
.tx-user { display: flex; align-items: center; gap: .75rem; }
.tx-avatar {
  width: 38px; height: 38px; border-radius: 50%;
  background: rgba(59,130,246,.12); display: flex; align-items: center;
  justify-content: center; font-weight: 800; font-size: .95rem;
  color: var(--info); flex-shrink: 0;
}
.tx-user-info .name  { font-weight: 700; font-size: .9rem; }
.tx-user-info .phone { font-size: .75rem; color: var(--text-dim); margin-top: .1rem; }
.tx-amount {
  font-size: 1.5rem; font-weight: 800; line-height: 1;
  color: var(--text);
}
.tx-amount.withdrawal { color: var(--warning); }

.tx-body {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(200px,1fr));
  gap: 0; padding: 0;
}
.tx-field {
  padding: .75rem 1.25rem; border-right: 1px solid var(--border);
  min-width: 0;
}
.tx-field:last-child { border-right: 0; }
.tx-field-lbl { font-size: .7rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: .05em; font-weight: 600; margin-bottom: .3rem; }
.tx-field-val { font-size: .85rem; font-weight: 600; color: var(--text); word-break: break-all; }
.tx-field-val.accent { color: var(--primary); }
.tx-field-val.muted  { color: var(--text-m); font-weight: 400; }

.tx-actions {
  display: flex; align-items: flex-start; gap: .75rem;
  padding: .85rem 1.25rem; border-top: 1px solid var(--border);
  flex-wrap: wrap;
}
.tx-note {
  flex: 1; min-width: 180px;
}
.tx-note textarea {
  width: 100%; background: var(--surface-d); border: 1px solid var(--border);
  border-radius: var(--radius-s); padding: .5rem .7rem; color: var(--text);
  font-size: .82rem; font-family: inherit; resize: vertical; min-height: 54px;
  outline: none; transition: border-color .15s;
}
.tx-note textarea:focus { border-color: var(--primary); }
.tx-btns { display: flex; flex-direction: column; gap: .4rem; flex-shrink: 0; }

/* ── Filtre ──────────────────────────────────────────────────────────────── */
.tx-filter-row { display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; }
.tx-filter-row input, .tx-filter-row select {
  background: var(--surface-d); border: 1px solid var(--border);
  border-radius: var(--radius-s); padding: .45rem .75rem;
  color: var(--text); font-size: .83rem; font-family: inherit; outline: none;
  transition: border-color .15s;
}
.tx-filter-row input:focus, .tx-filter-row select:focus { border-color: var(--primary); }
.tx-filter-row input { flex: 1; min-width: 160px; }

/* ── Stats cards ─────────────────────────────────────────────────────────── */
.tx-stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px,1fr)); gap: .75rem; margin-bottom: 1.25rem; }
.tx-stat  { background: var(--surface); border: 1px solid var(--border); border-left: 3px solid var(--border-s); border-radius: 14px; padding: .85rem 1rem; transition: transform .2s, box-shadow .2s; }
.tx-stat:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,.2); }
.tx-stat .lbl  { font-size: .7rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: .06em; font-weight: 700; margin-bottom: 2px; }
.tx-stat .val  { font-size: 1.7rem; font-weight: 900; line-height: 1; letter-spacing: -.03em; }
.tx-stat.green  { border-left-color: var(--success); } .tx-stat.green  .val { color: var(--success); }
.tx-stat.orange { border-left-color: var(--warning); } .tx-stat.orange .val { color: var(--warning); }
.tx-stat.red    { border-left-color: var(--error);   } .tx-stat.red    .val { color: var(--error); }
.tx-stat.blue   { border-left-color: var(--info);    } .tx-stat.blue   .val { color: var(--info); }

/* ── Instructions box ────────────────────────────────────────────────────── */
.tx-instr {
  background: var(--surface-d); border-radius: var(--radius-s);
  padding: .6rem .85rem; font-size: .8rem; line-height: 1.7;
  color: var(--text-m); border: 1px solid var(--border);
}
.tx-instr strong { color: var(--text); }
.tx-instr .hi    { color: var(--primary); font-weight: 700; }

/* -- Etat vide explicatif ------------------------------------------------- */
.tx-vide      { text-align: center; padding: 2.6rem 1.5rem 2rem; }
.tx-vide-ic   { width: 62px; height: 62px; border-radius: 50%; margin: 0 auto .9rem;
                background: rgba(34,197,94,.10); display: flex; align-items: center;
                justify-content: center; color: var(--success); }
.tx-vide-ic.attente { background: rgba(148,163,184,.12); color: var(--text-dim); }
.tx-vide h3   { margin: 0 0 .35rem; font-size: 1.12rem; font-weight: 800; letter-spacing: -.01em; }
.tx-vide .diag{ margin: 0 auto; max-width: 46ch; font-size: .87rem; line-height: 1.65; color: var(--text-m); }
.tx-vide .diag strong { color: var(--text); font-weight: 700; }

.tx-flux      { display: flex; align-items: stretch; justify-content: center; gap: 0;
                flex-wrap: wrap; margin: 1.6rem auto 0; max-width: 660px; }
.tx-etape     { flex: 1 1 150px; min-width: 140px; padding: .85rem .7rem; position: relative; }
.tx-etape + .tx-etape::before {
                content: ""; position: absolute; left: 0; top: 28px; bottom: 28px;
                width: 1px; background: var(--border); }
.tx-etape .n  { width: 24px; height: 24px; border-radius: 50%; margin: 0 auto .5rem;
                background: var(--surface-d); border: 1px solid var(--border);
                display: flex; align-items: center; justify-content: center;
                font-size: .72rem; font-weight: 800; color: var(--text-dim); }
.tx-etape.ici .n { background: var(--primary); border-color: var(--primary); color: #fff; }
.tx-etape .t  { font-size: .8rem; font-weight: 700; margin-bottom: .2rem; }
.tx-etape.ici .t { color: var(--primary); }
.tx-etape .d  { font-size: .72rem; line-height: 1.5; color: var(--text-dim); }

.tx-jauge     { margin: 1.5rem auto 0; max-width: 480px; display: grid;
                grid-template-columns: repeat(3, 1fr); gap: .6rem; }
.tx-jauge > div { background: var(--surface-d); border: 1px solid var(--border);
                border-radius: 12px; padding: .6rem .5rem; }
.tx-jauge .v  { font-size: 1.15rem; font-weight: 900; line-height: 1.1; letter-spacing: -.02em; }
.tx-jauge .l  { font-size: .66rem; text-transform: uppercase; letter-spacing: .05em;
                color: var(--text-dim); font-weight: 700; margin-top: .2rem; }
@media (max-width: 560px) {
  .tx-etape + .tx-etape::before { display: none; }
  .tx-etape { border-top: 1px solid var(--border); }
  .tx-flux .tx-etape:first-child { border-top: 0; }
}

@media (max-width: 640px) {
  .tx-body { grid-template-columns: 1fr 1fr; }
  .tx-field { border-right: 0; border-bottom: 1px solid var(--border); }
}
</style>

<%
  const _items = data.data ?? [];
  const _total = data.total ?? 0;
  const _ls    = localStats;
  const _methodCfg = {
    orange_money: { emoji:'🟠', label:'Orange Money' },
    moov_money:   { emoji:'🔵', label:'Moov Money' },
    mtn_momo:     { emoji:'🟡', label:'MTN MoMo' },
    wave:         { emoji:'🌊', label:'Wave' },
  };
  function _methodLabel(m) { const c = _methodCfg[m] || { emoji:'💳', label:m }; return c.emoji + ' ' + c.label; }
  function _fq(obj) {
    return Object.entries(obj).filter(([,v])=>v).map(([k,v])=>`${k}=${encodeURIComponent(v)}`).join('&');
  }
%>

<div class="topbar">
  <div>
    <h2><svg class="ic" aria-hidden="true"><use href="#ic-money"/></svg> Versements à effectuer</h2>
    <small id="tx-count"><%= _total %> versement<%= _total!==1?'s':'' %> de gains de parrainage en attente</small>
  </div>
  <div style="display:flex;gap:.5rem">
    <a href="/admin/historique" class="btn btn-outline btn-sm"><svg class="ic" aria-hidden="true"><use href="#ic-clipboard"/></svg> Historique complet</a>
  </div>
</div>

<% if (success) { %><div class="alert alert-success" style="display:none"><%= success %></div><% } %>
<% if (error)   { %><div class="alert alert-error"   style="display:none"><%= error   %></div><% } %>

<!-- ── Stats rapides ─────────────────────────────────────────────────────── -->
<div class="tx-stats">
  <div class="tx-stat blue">
    <div class="lbl">En attente</div>
    <div class="val"><%= _total %></div>
  </div>
  <div class="tx-stat orange">
    <div class="lbl">Total à verser</div>
    <div class="val"><%= _ls.totalAmount.toLocaleString() %> <span style="font-size:.8rem;font-weight:600">FCFA</span></div>
  </div>
</div>

<!-- ── Filtres ───────────────────────────────────────────────────────────── -->
<div class="card" style="padding:.85rem 1.25rem;margin-bottom:1rem">
  <form method="GET" action="/admin/transactions" class="tx-filter-row">
    <input type="text" name="search" value="<%= search %>" placeholder="🔍 Pseudo, téléphone, 1xBet ID…" aria-label="Rechercher">

    <select name="method" aria-label="Méthode">
      <option value="">Toutes méthodes</option>
      <% (typeof methods !== 'undefined' ? methods : []).forEach(m => { %>
      <option value="<%= m %>" <%= method===m ?'selected':'' %>><%= _methodLabel(m) %></option>
      <% }) %>
    </select>
    <button type="submit" class="btn btn-primary btn-sm">Filtrer</button>
    <% if (search || method) { %>
    <a href="/admin/transactions" class="btn btn-outline btn-sm"><svg class="ic" aria-hidden="true"><use href="#ic-x"/></svg> Reset</a>
    <% } %>
  </form>
</div>

<!-- ── Liste des versements ──────────────────────────────────────────────── -->
<% if (_items.length === 0 && (search || method)) { %>
<div class="empty-state card">
  <p>Aucun versement ne correspond aux filtres.</p>
  <a href="/admin/transactions" class="btn btn-outline" style="margin-top:.75rem">Voir tous les versements</a>
</div>

<% } else if (_items.length === 0) { %>
<%
  // Une file vide ne dit pas si le systeme marche ou s'il est casse. On explique
  // donc d'ou viennent ces lignes, et a quelle etape la chaine est arretee.
  const _c    = typeof contexte !== 'undefined' && contexte ? contexte : null;
  const _avec = _c ? (_c.parrains_avec_gains ?? 0) : null;
  const _elig = _c ? (_c.parrains_eligibles  ?? 0) : null;
  const _cum  = _c ? (_c.total_gains         ?? 0) : null;
  const _seuil= _c ? (_c.seuil_retrait     ?? 2000) : 2000;
  // Etape ou la chaine s'arrete : 1 aucun gain, 2 gains sous le seuil, 3 pret a demander.
  const _etape = !_c ? 0 : (_avec === 0 ? 1 : (_elig === 0 ? 2 : 3));
%>
<div class="card tx-vide">
  <div class="tx-vide-ic <%= _etape === 3 ? '' : 'attente' %>">
    <svg class="ic ic-xl" aria-hidden="true"><use href="#ic-<%= _etape === 3 ? 'check' : 'clock' %>"/></svg>
  </div>

  <h3>Aucun versement en attente</h3>

  <p class="diag">
    <% if (_etape === 0) { %>
      Rien à traiter pour le moment. Les demandes de versement des gains de
      parrainage s’affichent ici dès qu’un parrain en fait la demande.
    <% } else if (_etape === 1) { %>
      C’est normal : <strong>aucun parrain n’a encore de gains</strong>.
      La commission n’est créditée qu’au moment où un filleul devient Premium —
      tant qu’aucun parrainage n’a abouti à un abonnement, cette file reste vide.
    <% } else if (_etape === 2) { %>
      <strong><%= _avec %> parrain<%= _avec !== 1 ? 's' : '' %></strong> cumule<%= _avec !== 1 ? 'nt' : '' %>
      <strong><%= _cum.toLocaleString() %>&nbsp;FCFA</strong>, mais aucun n’atteint encore le
      seuil de <strong><%= _seuil.toLocaleString() %>&nbsp;FCFA</strong> requis pour demander un versement.
    <% } else { %>
      <strong><%= _elig %> parrain<%= _elig !== 1 ? 's' : '' %></strong> peu<%= _elig !== 1 ? 'vent' : 't' %>
      déjà demander un versement (<%= _cum.toLocaleString() %>&nbsp;FCFA cumulés),
      mais aucun ne l’a fait. Rien à traiter de votre côté.
    <% } %>
  </p>

  <div class="tx-flux">
    <div class="tx-etape <%= _etape === 1 ? 'ici' : '' %>">
      <div class="n">1</div>
      <div class="t">Un filleul s’abonne</div>
      <div class="d">La commission du parrain est créditée à ce moment-là, pas à l’inscription.</div>
    </div>
    <div class="tx-etape <%= _etape === 2 ? 'ici' : '' %>">
      <div class="n">2</div>
      <div class="t">Le parrain atteint <%= _seuil.toLocaleString() %>&nbsp;FCFA</div>
      <div class="d">En dessous du seuil, le bouton de retrait reste inactif dans l’application.</div>
    </div>
    <div class="tx-etape <%= _etape === 3 ? 'ici' : '' %>">
      <div class="n">3</div>
      <div class="t">Il demande son versement</div>
      <div class="d">La demande arrive ici. Vous envoyez l’argent, puis vous l’approuvez.</div>
    </div>
  </div>

  <% if (_c) { %>
  <div class="tx-jauge">
    <div>
      <div class="v"><%= _avec %></div>
      <div class="l">Parrains avec gains</div>
    </div>
    <div>
      <div class="v"><%= _cum.toLocaleString() %></div>
      <div class="l">FCFA cumulés</div>
    </div>
    <div>
      <div class="v"><%= _elig %></div>
      <div class="l">Au-dessus du seuil</div>
    </div>
  </div>
  <% } %>
</div>

<% } else { %>

<div style="display:flex;flex-direction:column;gap:.75rem">
<% _items.forEach((tx, idx) => {
     const initials  = (tx.user?.pseudo ?? '?')[0].toUpperCase();
     const method    = (tx.paymentMethod ?? '').replace(/_/g,' ');
%>
<div class="tx-card withdrawal" id="tx-<%= tx.id %>">

  <!-- En-tête -->
  <div class="tx-header">
    <div class="tx-user">
      <div class="tx-avatar"><%= initials %></div>
      <div class="tx-user-info">
        <div class="name">
          <a href="/admin/users/<%= tx.user?.id ?? '' %>" style="color:var(--text);text-decoration:none">
            <%= tx.user?.pseudo ?? '—' %>
          </a>
        </div>
        <div class="phone"><%= tx.user?.phoneNumber ?? '—' %></div>
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:.75rem;flex-wrap:wrap">
      <span class="badge badge-warn"><svg class="ic" aria-hidden="true"><use href="#ic-gift"/></svg> Gains de parrainage</span>
      <div class="tx-amount withdrawal">
        <%= (tx.amount ?? 0).toLocaleString() %> <span style="font-size:.9rem;font-weight:600">FCFA</span>
      </div>
    </div>
  </div>

  <!-- Détails -->
  <div class="tx-body">
    <div class="tx-field">
      <div class="tx-field-lbl">Méthode</div>
      <div class="tx-field-val"><%= method.toUpperCase() || '—' %></div>
    </div>
    <div class="tx-field">
      <div class="tx-field-lbl">N° envoyeur</div>
      <div class="tx-field-val"><%= tx.senderPhone ?? '—' %></div>
    </div>
    <div class="tx-field">
      <div class="tx-field-lbl">ID 1xBet</div>
      <div class="tx-field-val accent"><%= tx.xbetId ?? '⚠ Non renseigné' %></div>
    </div>
    <div class="tx-field">
      <div class="tx-field-lbl">Date demande</div>
      <div class="tx-field-val muted"><%= new Date(tx.createdAt).toLocaleDateString('fr-FR',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) %></div>
    </div>
    <div class="tx-field" style="grid-column: span 2">
      <div class="tx-field-lbl">Instructions</div>
      <div class="tx-instr">
        <%# La branche « dépôt » (vérifier une réception) n'a plus lieu d'être :
            un versement de gains part toujours de la plateforme vers le parrain. %>
        Envoyer <strong><%= (tx.amount??0).toLocaleString() %> FCFA</strong>
        via <strong><%= method %></strong>
        sur le <strong><%= tx.senderPhone ?? '—' %></strong>
      </div>
    </div>
  </div>

  <!-- Actions -->
  <% if (hasPerm('transactions', 'write')) { %>
  <div class="tx-actions">
    <form method="POST" action="/admin/transactions/<%= tx.id %>" id="form-<%= tx.id %>" style="display:contents">
      <div class="tx-note">
        <textarea name="admin_note" placeholder="Note admin (optionnelle)…" rows="2" aria-label="Note administrateur"></textarea>
      </div>
      <div class="tx-btns">
        <button type="button" class="btn btn-success btn-sm"
          onclick="askConfirm({
            icon:'check',
            title:'Confirmer le versement',
            msg:'Valider <strong><%= (tx.amount??0).toLocaleString() %> FCFA</strong> pour <strong><%= tx.user?.pseudo ?? tx.id %></strong> ?',
            btnLabel:'Confirmer',
            btnClass:'btn-success',
            onConfirm: () => submitTx('<%= tx.id %>', 'completed')
          })"><svg class="ic" aria-hidden="true"><use href="#ic-check"/></svg> Approuver</button>
        <button type="button" class="btn btn-danger btn-sm"
          onclick="askConfirm({
            icon:'x',
            title:'Rejeter le versement',
            msg:'Rejeter la demande de <strong><%= tx.user?.pseudo ?? tx.id %></strong> ?',
            btnLabel:'Rejeter',
            btnClass:'btn-danger',
            onConfirm: () => submitTx('<%= tx.id %>', 'rejected')
          })"><svg class="ic" aria-hidden="true"><use href="#ic-x"/></svg> Rejeter</button>
      </div>
      <input type="hidden" name="status" id="status-<%= tx.id %>">
    </form>
  </div>
  <% } %>

</div>
<% }) %>
</div>

<!-- Pagination -->
<% if (totalPages > 1) { %>
<div style="display:flex;justify-content:space-between;align-items:center;padding:14px 0;margin-top:8px">
  <p style="color:var(--text-m);font-size:.78rem">Page <%= page %> / <%= totalPages %></p>
  <div style="display:flex;gap:.4rem">
    <% if (page > 1) { %>
    <a href="/admin/transactions?<%= _fq({search,method,page:page-1}) %>" class="btn btn-sm btn-outline">← Préc.</a>
    <% } %>
    <% if (page < totalPages) { %>
    <a href="/admin/transactions?<%= _fq({search,method,page:page+1}) %>" class="btn btn-sm btn-outline">Suiv. →</a>
    <% } %>
  </div>
</div>
<% } %>

<% } %>

<script>
function submitTx(id, status) {
  document.getElementById('status-' + id).value = status;
  document.getElementById('form-' + id).submit();
}
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.alert-success,.alert-error').forEach(function(el) {
    var txt = el.textContent.trim();
    if (txt && typeof showToast === 'function') showToast(txt, el.classList.contains('alert-success') ? 'success' : 'error');
  });
});
// SSE : rafraîchir le badge si une TX est validée depuis un autre onglet
window.addEventListener('sseAction', function(e) {
  if (['transaction_approved','transaction_rejected'].includes(e.detail?.type)) {
    showToast('Une transaction vient d\'être traitée — pensez à actualiser.', 'info');
  }
});
</script>

<%- include('layout_bottom') %>
