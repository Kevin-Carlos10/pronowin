<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#141926">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>PronoWin Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <!-- Anti-flash : appliquer le thème AVANT le rendu -->
  <script>
    (function() {
      var mode   = localStorage.getItem('pw_mode')   || 'dark';
      var accent = localStorage.getItem('pw_accent') || 'orange';
      if (mode === 'light') document.documentElement.classList.add('light');
      document.documentElement.setAttribute('data-accent', accent);
    })();
  </script>
</head>
<body>

<%- include('_icons') %>

<!-- ── Overlay mobile sidebar ── -->
<div class="sidebar-overlay" id="sidebar-overlay" onclick="closeSidebar()"></div>

<!-- ── Confirm dialog ── -->
<div class="confirm-overlay" id="confirm-overlay">
  <div class="confirm-box">
    <div class="confirm-icon" id="confirm-icon"><svg class="ic ic-xl" aria-hidden="true"><use href="#ic-alert"/></svg></div>
    <h3 id="confirm-title">Confirmer l'action</h3>
    <p id="confirm-msg">Êtes-vous sûr de vouloir effectuer cette action ?</p>
    <div class="confirm-actions">
      <button class="btn btn-outline" onclick="closeConfirm()">Annuler</button>
      <button class="btn btn-primary" id="confirm-ok-btn">Confirmer</button>
    </div>
  </div>
</div>

<!-- ── Toast container ── -->
<div class="toast-container" id="toast-container"></div>

<!-- ── Session timeout warning ── -->
<div class="session-overlay" id="session-overlay">
  <div class="session-box">
    <div style="font-size:2.5rem;margin-bottom:.75rem"><svg class="ic" aria-hidden="true"><use href="#ic-clock"/></svg></div>
    <h3>Session sur le point d'expirer</h3>
    <p>Vous avez été inactif pendant un moment.<br>Votre session se fermera dans <strong id="session-countdown">02:00</strong>.</p>
    <div style="display:flex;gap:.75rem;justify-content:center;margin-top:1.5rem">
      <button class="btn btn-primary" onclick="extendSession()"><svg class="ic" aria-hidden="true"><use href="#ic-check"/></svg> Rester connecté</button>
      <a href="/admin/logout" class="btn btn-outline"><svg class="ic" aria-hidden="true"><use href="#ic-logout"/></svg> Se déconnecter</a>
    </div>
  </div>
</div>

<!-- ── Recherche globale (Ctrl+K) ── -->
<div class="search-overlay" id="search-overlay" onclick="if(event.target===this)closeSearch()">
  <div class="search-box">
    <div class="search-input-wrap">
      <span class="search-icon"><svg class="ic" aria-hidden="true"><use href="#ic-search"/></svg></span>
      <input type="text" id="search-input" placeholder="Rechercher un utilisateur, pronostic, actualité…" autocomplete="off" aria-label="Rechercher un utilisateur, pronostic, actualité">
      <kbd class="search-esc" onclick="closeSearch()">Esc</kbd>
    </div>
    <div class="search-results" id="search-results">
      <div class="search-hint">
        <span><svg class="ic" aria-hidden="true"><use href="#ic-users"/></svg> Utilisateurs</span><span><svg class="ic" aria-hidden="true"><use href="#ic-ball"/></svg> Pronostics</span><span><svg class="ic" aria-hidden="true"><use href="#ic-news"/></svg> Actualités</span>
      </div>
    </div>
  </div>
</div>

<div class="layout">

<!-- ── Sidebar ── -->
<aside class="sidebar" id="sidebar">
  <div class="sidebar-logo">
    <h1>Prono<span>Win</span></h1>
    <small>Administration</small>
  </div>
  <style>
  /* ── Sidebar logo glow ── */
  .sidebar-logo h1 span { text-shadow: 0 0 18px rgba(var(--primary-rgb),.4); }
  </style>

  <!-- Bouton recherche sidebar -->
  <div style="padding:0 12px 12px">
    <button class="sidebar-search-btn" onclick="openSearch()" title="Ctrl+K ou /">
      <span><svg class="ic" aria-hidden="true"><use href="#ic-search"/></svg></span> <span>Rechercher…</span> <kbd>/</kbd>
    </button>
  </div>

  <nav>
    <a href="/admin/dashboard" class="nav-item <%= page==='dashboard' ?'active':'' %>"><span class="icon"><svg class="ic" aria-hidden="true"><use href="#ic-dashboard"/></svg></span> Dashboard</a>

    <% if (hasPerm('statistiques')) { %>
    <a href="/admin/statistiques" class="nav-item <%= page==='statistiques' ?'active':'' %>"><span class="icon"><svg class="ic" aria-hidden="true"><use href="#ic-chart"/></svg></span> Statistiques</a>
    <% } %>

    <% if (hasPerm('users')) { %>
    <a href="/admin/users" class="nav-item <%= page==='users' ?'active':'' %>"><span class="icon"><svg class="ic" aria-hidden="true"><use href="#ic-users"/></svg></span> Utilisateurs</a>
    <% } %>

    <% if (hasPerm('pronostics')) { %>
    <a href="/admin/pronostics" class="nav-item <%= page==='pronostics' ?'active':'' %>"><span class="icon"><svg class="ic" aria-hidden="true"><use href="#ic-ball"/></svg></span> Pronostics</a>
    <a href="/admin/leagues" class="nav-item <%= page==='leagues' ?'active':'' %>"><span class="icon"><svg class="ic" aria-hidden="true"><use href="#ic-trophy"/></svg></span> Ligues</a>
    <% } %>

    <% if (hasPerm('abonnements') || hasPerm('transactions') || hasPerm('historique') || hasPerm('bankroll')) { %>
    <div class="sidebar-section">Finances</div>
    <% } %>

    <% if (hasPerm('abonnements')) { %>
    <a href="/admin/abonnements" class="nav-item <%= page==='abonnements' ?'active':'' %>">
      <span class="icon"><svg class="ic" aria-hidden="true"><use href="#ic-crown"/></svg></span> Abonnements
      <span class="nav-badge" id="badge-proofs"></span>
    </a>
    <% } %>

    <%# Transactions et Historique existaient comme pages complètes, avec leur
        permission dans le formulaire sous-admin — mais aucun lien n'y menait
        nulle part dans l'application. On ne pouvait les atteindre qu'en tapant
        l'URL, ou depuis l'autre des deux. %>
    <% if (hasPerm('transactions')) { %>
    <a href="/admin/transactions" class="nav-item <%= page==='transactions' ?'active':'' %>"><span class="icon"><svg class="ic" aria-hidden="true"><use href="#ic-card"/></svg></span> Versements</a>
    <% } %>

    <%# Réservé à l'admin principal : changer le numéro de réception, c'est
        rediriger l'argent des abonnés. %>
    <% if (isMain) { %>
    <a href="/admin/paiements" class="nav-item <%= page==='paiements' ?'active':'' %>"><span class="icon"><svg class="ic" aria-hidden="true"><use href="#ic-card"/></svg></span> Méthodes paiement</a>
    <% } %>

    <% if (hasPerm('historique')) { %>
    <a href="/admin/historique" class="nav-item <%= page==='historique' ?'active':'' %>"><span class="icon"><svg class="ic" aria-hidden="true"><use href="#ic-clipboard"/></svg></span> Historique</a>
    <% } %>

    <% if (hasPerm('bankroll')) { %>
    <a href="/admin/bankroll" class="nav-item <%= page==='bankroll' ?'active':'' %>"><span class="icon"><svg class="ic" aria-hidden="true"><use href="#ic-target"/></svg></span> Bankroll</a>
    <% } %>

    <% if (hasPerm('tutoriels') || hasPerm('notifications') || hasPerm('actualites')) { %>
    <div class="sidebar-section">Contenu</div>
    <% } %>

    <% if (hasPerm('actualites')) { %>
    <a href="/admin/actualites" class="nav-item <%= page==='actualites' ?'active':'' %>"><span class="icon"><svg class="ic" aria-hidden="true"><use href="#ic-news"/></svg></span> Actualités</a>
    <% } %>

    <% if (hasPerm('tutoriels')) { %>
    <a href="/admin/tutoriels" class="nav-item <%= page==='tutoriels' ?'active':'' %>"><span class="icon"><svg class="ic" aria-hidden="true"><use href="#ic-book"/></svg></span> Tutoriels</a>
    <% } %>

    <% if (hasPerm('notifications')) { %>
    <a href="/admin/notifications" class="nav-item <%= page==='notifications' ?'active':'' %>"><span class="icon"><svg class="ic" aria-hidden="true"><use href="#ic-megaphone"/></svg></span> Notifications</a>
    <% } %>

    <% if (isMain) { %>
    <div class="sidebar-section">Administration</div>
    <a href="/admin/sub-admins" class="nav-item <%= page==='sub-admins' ?'active':'' %>"><span class="icon"><svg class="ic" aria-hidden="true"><use href="#ic-lock"/></svg></span> Sous-admins</a>
    <a href="/admin/bans"       class="nav-item <%= page==='bans'       ?'active':'' %>"><span class="icon"><svg class="ic" aria-hidden="true"><use href="#ic-ban"/></svg></span> Bannissements</a>
    <a href="/admin/audit"      class="nav-item <%= page==='audit'      ?'active':'' %>"><span class="icon"><svg class="ic" aria-hidden="true"><use href="#ic-clipboard"/></svg></span> Journal d'activité</a>
    <a href="/admin/settings"   class="nav-item <%= page==='settings'   ?'active':'' %>"><span class="icon"><svg class="ic" aria-hidden="true"><use href="#ic-settings"/></svg></span> Paramètres</a>
    <% } %>
  </nav>

  <div class="sidebar-spacer"></div>

  <!-- ── Panneau thème ── -->
  <div class="theme-panel">
    <div class="theme-panel-row">
      <span class="theme-panel-lbl">Thème</span>
      <div class="mode-toggle">
        <button class="mode-btn" id="mode-dark"  onclick="setMode('dark')"  title="Mode sombre" aria-label="Activer le thème sombre"><svg class="ic" aria-hidden="true"><use href="#ic-moon"/></svg></button>
        <button class="mode-btn" id="mode-light" onclick="setMode('light')" title="Mode clair" aria-label="Activer le thème clair"><svg class="ic" aria-hidden="true"><use href="#ic-sun"/></svg></button>
      </div>
    </div>
  </div>

  <div class="sidebar-footer">
    <a href="/admin/profile" class="nav-item <%= page==='profile' ?'active':'' %>" style="padding:.6rem 1rem;margin-bottom:.1rem">
      <div style="width:30px;height:30px;border-radius:50%;background:<%= adminRole==='sub'?'rgba(245,158,11,.15)':'rgba(34,197,94,.15)' %>;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;color:<%= adminRole==='sub'?'var(--warning)':'var(--success)' %>">
        <%= adminName[0]?.toUpperCase() ?? '?' %>
      </div>
      <div style="min-width:0">
        <div style="font-weight:600;font-size:.82rem;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= adminName %></div>
        <div style="font-size:.7rem;color:<%= adminRole==='sub'?'var(--warning)':'var(--success)' %>"><%= adminRole==='sub'?'Sous-admin':'Admin principal' %></div>
      </div>
    </a>
    <a href="/admin/logout" class="nav-item nav-logout"><span class="icon"><svg class="ic" aria-hidden="true"><use href="#ic-logout"/></svg></span> Déconnexion</a>
  </div>
</aside>

<!-- ── Bottom Navigation Bar (mobile) ── -->
<nav class="bottom-nav" id="bottom-nav" aria-label="Navigation mobile">
  <div class="bottom-nav-items">
    <a href="/admin/dashboard" class="bottom-nav-item <%= page==='dashboard'?'active':'' %>" aria-label="Dashboard">
      <span class="bottom-nav-icon"><svg class="ic" aria-hidden="true"><use href="#ic-dashboard"/></svg></span>
      <span>Dashboard</span>
    </a>
    <% if (hasPerm('users')) { %>
    <a href="/admin/users" class="bottom-nav-item <%= page==='users'?'active':'' %>" aria-label="Utilisateurs">
      <span class="bottom-nav-icon"><svg class="ic" aria-hidden="true"><use href="#ic-users"/></svg></span>
      <span>Utilisateurs</span>
    </a>
    <% } else { %>
    <a href="/admin/statistiques" class="bottom-nav-item <%= page==='statistiques'?'active':'' %>" aria-label="Stats">
      <span class="bottom-nav-icon"><svg class="ic" aria-hidden="true"><use href="#ic-chart"/></svg></span>
      <span>Stats</span>
    </a>
    <% } %>
    <!-- Bouton FAB central : recherche rapide -->
    <button class="bottom-nav-fab" onclick="openSearch()" aria-label="Rechercher">
      <div class="bottom-nav-fab-circle"><svg class="ic" aria-hidden="true"><use href="#ic-search"/></svg></div>
      <span class="bottom-nav-fab-lbl">Chercher</span>
    </button>
    <a href="/admin/profile" class="bottom-nav-item <%= page==='profile'?'active':'' %>" aria-label="Profil">
      <span class="bottom-nav-icon"><svg class="ic" aria-hidden="true"><use href="#ic-user"/></svg></span>
      <span>Profil</span>
    </a>
  </div>
</nav>

<!-- ── Main ── -->
<main class="main">

<!-- Barre mobile (hamburger) -->
<div class="mobile-bar">
  <button class="hamburger" onclick="toggleSidebar()" aria-label="Menu"><svg class="ic" aria-hidden="true"><use href="#ic-menu"/></svg></button>
  <span class="mobile-bar-title">Prono<span>Win</span> Admin</span>
  <button class="search-trigger-btn" onclick="openSearch()" title="Recherche (Ctrl+K)" aria-label="Ouvrir la recherche"><svg class="ic" aria-hidden="true"><use href="#ic-search"/></svg></button>
</div>

<%
  const _s = locals.settings || {};
  const _announceBg   = { info: 'rgba(59,130,246,.12)', warning: 'rgba(245,158,11,.12)', danger: 'rgba(239,68,68,.12)' };
  const _announceColor= { info: 'var(--info)', warning: 'var(--warning)', danger: 'var(--error)' };
  const _announceIcon = { info: 'ℹ', warning: '⚠', danger: '⚠' };
%>
<% if (_s.announcementEnabled && _s.announcementText) { %>
<div style="background:<%= _announceBg[_s.announcementType]||_announceBg.info %>;border-bottom:1px solid <%= _announceColor[_s.announcementType]||'var(--info)' %>20;padding:.6rem 1.25rem;display:flex;align-items:center;gap:.6rem;font-size:.83rem;color:<%= _announceColor[_s.announcementType]||'var(--info)' %>;margin-bottom:0" id="global-announcement">
  <span><%= _announceIcon[_s.announcementType]||'ℹ️' %></span>
  <span style="flex:1"><%= _s.announcementText %></span>
  <button onclick="this.parentElement.style.display='none'" style="background:none;border:none;cursor:pointer;color:inherit;font-size:1rem;opacity:.6;padding:0;line-height:1">×</button>
</div>
<% } %>

<% if (_s.maintenanceMode) { %>
<div style="background:rgba(245,158,11,.15);border-bottom:1px solid rgba(245,158,11,.3);padding:.6rem 1.25rem;display:flex;align-items:center;gap:.6rem;font-size:.83rem;color:var(--warning)">
  <span><svg class="ic" aria-hidden="true"><use href="#ic-settings"/></svg></span>
  <span style="flex:1"><strong>Mode maintenance actif</strong> — <%= _s.maintenanceMessage || 'Le panel est en maintenance.' %></span>
  <% if (isMain) { %>
  <a href="/admin/settings" style="color:var(--warning);font-weight:600;font-size:.78rem;text-decoration:underline">Désactiver →</a>
  <% } %>
</div>
<% } %>
