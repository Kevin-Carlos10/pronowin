<%- include('layout_top', {page:'pronostics'}) %>

<style>
/* ── Stats ─────────────────────────────────────────────────────────────────── */
.pro-stats { display:grid; grid-template-columns:repeat(auto-fill,minmax(130px,1fr)); gap:.7rem; margin-bottom:1.1rem; }
.pro-stat  { background:var(--surface); border:1px solid var(--border); border-left:3px solid var(--border-s); border-radius:14px; padding:.9rem 1.1rem; transition:transform .2s,box-shadow .2s; }
.pro-stat:hover { transform:translateY(-2px); box-shadow:0 8px 24px rgba(0,0,0,.2); }
.pro-stat .v  { font-size:1.7rem; font-weight:900; line-height:1; margin-top:.1rem; letter-spacing:-.03em; }
.pro-stat .l  { font-size:.68rem; text-transform:uppercase; letter-spacing:.06em; font-weight:700; color:var(--text-dim); margin-bottom:2px; }
.pro-stat.blue   { border-left-color:var(--info); }    .pro-stat.blue   .v { color:var(--info); }
.pro-stat.green  { border-left-color:var(--success); } .pro-stat.green  .v { color:var(--success); }
.pro-stat.orange { border-left-color:var(--warning); } .pro-stat.orange .v { color:var(--warning); }
.pro-stat.dim    { border-left-color:var(--border-s); }.pro-stat.dim    .v { color:var(--text-m); }

/* Barre de filtres : voir .filterbar dans style.css (socle partagé). */



.pro-date { font-size:.72rem; color:var(--text-dim); white-space:nowrap; }




/* ── Countdown badge ────────────────────────────────────────────────────────── */

/* ── Groupe par championnat (Mes pronostics) ──────────────────────────────────── */
</style>

<%
  const _total     = matches.length;
  const _published = matches.filter(m => m.is_published).length;
  const _drafts    = matches.filter(m => m.has_pronostic && !m.is_published).length;
  const _none      = matches.filter(m => !m.has_pronostic).length;

  // statusFilter est injecté par le serveur depuis req.query.status
  const _statusFilter = (typeof statusFilter !== 'undefined' ? statusFilter : '') || '';
  function matchesStatus(m) {
    if (!_statusFilter) return true;
    if (_statusFilter === 'published') return m.is_published;
    if (_statusFilter === 'draft')     return m.has_pronostic && !m.is_published;
    if (_statusFilter === 'none')      return !m.has_pronostic;
    return true;
  }
  const visibleMatches = matches.filter(matchesStatus);
%>

<div class="topbar">
  <div>
    <h2><svg class="ic" aria-hidden="true"><use href="#ic-ball"/></svg> Pronostics</h2>
    <%# Le total avant troncature vient de l'en-tête X-Total-Count. L'afficher
        évite de laisser croire que la liste est complète quand elle est
        plafonnée à 400. %>
    <% const _totalReel = (typeof totalMatchs !== 'undefined' && totalMatchs) ? totalMatchs : _total; %>
    <small>
      <% if (_totalReel > _total) { %>
        <%= _total %> affichés sur <%= _totalReel.toLocaleString('fr-FR') %> matchs
      <% } else { %>
        <%= _total %> match<%= _total!==1?'s':'' %>
      <% } %>
      · <%= (typeof live !== 'undefined' && live) ? 'Matchs en direct (base locale)' : (typeof mine !== 'undefined' && mine) ? 'Mes pronostics (base locale)' : 'Catalogue externe' %>
    </small>
  </div>
  <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
    <a href="/admin/pronostics/export<%= competition ? '?competition='+competition : '' %>"
       class="btn btn-outline btn-sm" onclick="exportBtnFeedback(this)"><svg class="ic" aria-hidden="true"><use href="#ic-download"/></svg> Export CSV</a>
  </div>
</div>

<!-- ── Onglets : découvrir de nouveaux matchs vs retrouver ce qui a déjà été pronostiqué ── -->
<div style="display:flex;gap:.4rem;margin-bottom:1rem">
  <a href="/admin/pronostics"
     class="btn btn-sm <%= (typeof mine === 'undefined' || !mine) && (typeof live === 'undefined' || !live) ? 'btn-primary' : 'btn-outline' %>">
    <svg class="ic" aria-hidden="true"><use href="#ic-globe"/></svg> Découvrir
  </a>
  <a href="/admin/pronostics?mine=1"
     class="btn btn-sm <%= (typeof mine !== 'undefined' && mine) ? 'btn-primary' : 'btn-outline' %>">
    <svg class="ic" aria-hidden="true"><use href="#ic-clipboard"/></svg> Mes pronostics
  </a>
  <a href="/admin/pronostics?live=1"
     class="btn btn-sm <%= (typeof live !== 'undefined' && live) ? 'btn-primary' : 'btn-outline' %>">
    <svg class="ic ic-sm" aria-hidden="true" style="color:var(--on-danger)"><use href="#ic-dot"/></svg> Match en direct
  </a>
</div>

<%# `data-toast="skip"` : le balayeur générique de layout_bottom transformait
    déjà cette alerte en toast, et le script de la page en produisait un second.
    Deux notifications identiques empilées pour un seul événement. %>
<% if(typeof success !== 'undefined' && success){ %>
<div class="alert alert-success" style="display:none" id="flash-success" data-toast="skip"><svg class="ic" aria-hidden="true"><use href="#ic-check"/></svg> Pronostic publié avec succès !</div>
<% } %>
<% if(typeof error !== 'undefined' && error){ %>
<div class="alert alert-error">
  <strong><svg class="ic" aria-hidden="true"><use href="#ic-x"/></svg> Erreur du fournisseur de données</strong> — <%= error %>
  <% if(error.includes('clé') || error.includes('API')){ %>
  <br><small><svg class="ic" aria-hidden="true"><use href="#ic-arrow-right"/></svg> Vérifiez <code>API_FOOTBALL_KEY</code> dans le fichier <code>.env</code>.</small>
  <% } %>
</div>
<% } %>

<!-- ── Stats ─────────────────────────────────────────────────────────────────── -->
<div class="pro-stats">
  <div class="pro-stat blue"><div class="l">Matchs</div><div class="v"><%= _total %></div></div>
  <div class="pro-stat green"><div class="l">Publiés</div><div class="v"><%= _published %></div></div>
  <div class="pro-stat orange"><div class="l">Brouillons</div><div class="v"><%= _drafts %></div></div>
  <div class="pro-stat dim"><div class="l">Sans prono</div><div class="v"><%= _none %></div></div>
</div>

<!-- ── Filtres ────────────────────────────────────────────────────────────────── -->
<form method="GET" action="/admin/pronostics" class="filterbar">
    <input type="hidden" name="mine" value="<%= (typeof mine !== 'undefined' && mine) ? '1' : '0' %>">
    <input type="hidden" name="live" value="<%= (typeof live !== 'undefined' && live) ? '1' : '0' %>">
    <%
      // « Tout » est désormais la valeur vide, donc le défaut : l'appel API
      // ramène de toute façon l'intégralité des matchs, la vue restreinte
      // jetait 90 % de ce qui était déjà payé.
      //
      // Les homonymes sont levés par le pays quand l'API le fournit : deux
      // « Serie A » (Italie, Brésil) s'affichaient à l'identique.
      const _ligues = typeof visibleLeagues !== 'undefined' ? visibleLeagues : [];
      const _occurrences = _ligues.reduce((acc, l) => {
        acc[l.league] = (acc[l.league] ?? 0) + 1; return acc;
      }, {});
      const _libelle = l => _occurrences[l.league] > 1
        ? `${l.league} · ${l.leagueCountry || l.leagueCode}`
        : l.league;
    %>
    <select name="competition" onchange="this.form.submit()">
      <option value="">🌐 Tout</option>
      <option value="MAJORS" <%= competition==='MAJORS' ?'selected':'' %>>⭐ Ligues principales + amicaux</option>
      <% _ligues.forEach(l => { %>
        <option value="<%= l.leagueCode %>" <%= competition===l.leagueCode ?'selected':'' %>><%= _libelle(l) %></option>
      <% }) %>
    </select>
    <select name="status" onchange="this.form.submit()">
      <option value="">Tous statuts</option>
      <option value="published" <%= _statusFilter==='published'?'selected':'' %>>✅ Publiés</option>
      <option value="draft"     <%= _statusFilter==='draft'    ?'selected':'' %>>✏️ Brouillons</option>
      <option value="none"      <%= _statusFilter==='none'     ?'selected':'' %>>— Sans prono</option>
    </select>
    <input type="text" name="q" placeholder="🔍 Équipe ou ligue..." value="<%= typeof q !== 'undefined' ? q : '' %>">
    <% if((typeof mine === 'undefined' || !mine) && (typeof live === 'undefined' || !live)) { %>
    <input type="date" name="date" title="Voir les matchs d'une date précise (passée ou à venir)" value="<%= typeof date !== 'undefined' ? date : '' %>">
    <% } %>
    <button type="submit" class="btn btn-outline btn-sm">Filtrer</button>
    <% if(competition || _statusFilter || (typeof q !== 'undefined' && q) || (typeof date !== 'undefined' && date)) { %>
    <a href="/admin/pronostics<%= (typeof live !== 'undefined' && live) ? '?live=1' : (typeof mine !== 'undefined' && mine) ? '?mine=1' : '' %>" class="btn btn-outline btn-sm"><svg class="ic" aria-hidden="true"><use href="#ic-x"/></svg> Reset</a>
    <% } %>
  <span class="spacer"></span>
  <span style="font-size:.78rem;color:var(--text-dim)"><%= visibleMatches.length %> affiché<%= visibleMatches.length!==1?'s':'' %></span>
</form>

<!-- ── Grille des matchs ──────────────────────────────────────────────────────── -->
<% const _isMine = typeof mine !== 'undefined' && mine; %>
<% const _isLive = typeof live !== 'undefined' && live; %>
<% const _isGrouped = _isMine || _isLive; %>
<%
  // "Mes pronostics" / "Match en direct" : regroupé par championnat, chaque
  // groupe trié par date ; les groupes suivent l'ordre du match le plus
  // pertinent qu'ils contiennent, puisque visibleMatches arrive déjà trié.
  let leagueGroups = null;
  if (_isGrouped) {
    const byLeague = new Map();
    visibleMatches.forEach(m => {
      const key = m.league || 'Autre';
      if (!byLeague.has(key)) byLeague.set(key, { league: key, logo: m.leagueLogo, items: [] });
      byLeague.get(key).items.push(m);
    });
    leagueGroups = [...byLeague.values()];
  }
%>
<% if(visibleMatches.length === 0) { %>
<div class="empty-state card">
  <div style="font-size:2.5rem;margin-bottom:.5rem"><%= _total === 0 ? (_isLive ? '🔴' : _isMine ? '📋' : '⏳') : '🔍' %></div>
  <p><%= _total === 0
    ? (_isLive ? 'Aucun match en direct actuellement.' : _isMine ? 'Aucun pronostic créé pour l\'instant.' : 'Aucun match programmé cette semaine pour cette ligue.')
    : 'Aucun match ne correspond aux filtres.' %></p>
  <% if(competition || _statusFilter || (typeof q !== 'undefined' && q) || (typeof date !== 'undefined' && date)) { %>
  <a href="/admin/pronostics<%= _isLive ? '?live=1' : _isMine ? '?mine=1' : '' %>" class="btn btn-outline" style="margin-top:.75rem">Voir tous les matchs</a>
  <% } %>
</div>
<% } else {
     const sections = _isGrouped ? leagueGroups : [{ league: null, logo: null, items: visibleMatches }];
%>
<div class="dt-wrap" id="pro-table">
  <div class="bulkbar" id="pro-bulk">
    <span class="count" id="pro-bulk-n">0</span>&nbsp;pronostic(s) sélectionné(s)
    <span class="spacer"></span>
    <button type="button" class="btn btn-sm btn-outline bulk-result" data-result="WIN"><svg class="ic" aria-hidden="true"><use href="#ic-check"/></svg> WIN</button>
    <button type="button" class="btn btn-sm btn-outline bulk-result" data-result="LOSS"><svg class="ic" aria-hidden="true"><use href="#ic-x"/></svg> LOSS</button>
    <button type="button" class="btn btn-sm btn-outline bulk-result" data-result="PUSH"><svg class="ic" aria-hidden="true"><use href="#ic-refresh"/></svg> Push</button>
    <button type="button" class="btn btn-sm btn-outline" id="pro-bulk-clear">Annuler</button>
  </div>
  <div class="dt-scroll">
  <div class="table-wrap">
    <table class="dt">
      <thead>
        <tr>
          <th class="col-check"><input type="checkbox" id="pro-all" aria-label="Tout sélectionner"></th>
          <th>Coup d'envoi</th>
          <% if(!_isGrouped) { %><th>Compétition</th><% } %>
          <th>Match</th>
          <th>Pronostic</th>
          <th class="num">Cote</th>
          <th class="num">Conf.</th>
          <th>Statut</th>
          <th class="col-act">Actions</th>
        </tr>
      </thead>
      <tbody>
  <% const _cols = _isGrouped ? 8 : 9; %>
  <% sections.forEach(section => { %>
  <% if(_isGrouped) { %>
        <tr class="dt-group"><td colspan="<%= _cols %>">
          <% if(section.logo){ %><img src="<%= section.logo %>" onerror="this.style.display='none'" alt=""><% } %>
          <%= section.league %>
          <span class="n">· <%= section.items.length %> match<%= section.items.length!==1?'s':'' %></span>
        </td></tr>
  <% } %>
  <% section.items.forEach(m => {
       const d = new Date(m.matchDate);
       const diffMin = Math.floor((d.getTime() - Date.now()) / 60000);
       const dateStr = d.toLocaleDateString('fr-FR',{weekday:'short',day:'numeric',month:'short'}) + ' · ' + d.toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});
       const isLive = m.status === 'LIVE' || (diffMin < 0 && diffMin > -120);
       const isFinished = m.status === 'FINISHED';
       const homeInitial = (m.homeTeam||'?')[0].toUpperCase();
       const awayInitial = (m.awayTeam||'?')[0].toUpperCase();
       const conf = m.pronostic?.confidence_score ?? 0;
       const rowClass = isLive ? 'is-live' : m.is_published ? 'is-pub' : m.has_pronostic ? 'is-draft' : '';
       let whenClass = 'when', whenStr = dateStr;
       if (isLive) { whenClass += ' live'; whenStr = ' ' + dateStr; }
       else if (isFinished) { whenStr = ' ' + dateStr; }
       else if (diffMin >= 0 && diffMin < 120) { whenClass += ' soon'; whenStr = ' Dans ' + diffMin + ' min'; }
  %>
        <tr class="<%= rowClass %>">
          <td class="col-check">
            <% if(m.has_pronostic && m.pronostic) { %>
              <input type="checkbox" class="pro-chk" value="<%= m.pronostic.id %>" aria-label="Sélectionner ce pronostic">
            <% } %>
          </td>
          <td><span class="<%= whenClass %>"><%= whenStr %></span></td>
          <% if(!_isGrouped) { %>
          <td style="color:var(--text-m)">
            <% if(m.leagueLogo){ %><img src="<%= m.leagueLogo %>" class="team-logo" onerror="this.style.display='none'" alt=""><% } %>
            <%= m.league %>
          </td>
          <% } %>
          <td>
            <div class="matchcell">
              <span class="team" title="<%= m.homeTeam %>">
                <% if(m.homeTeamLogo) { %><img src="<%= m.homeTeamLogo %>" class="team-logo" alt="" onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'team-logo',textContent:'<%= homeInitial %>'}))"><% } else { %><span class="team-logo"><%= homeInitial %></span><% } %>
                <%= m.homeTeam %>
              </span>
              <% if((isLive || isFinished) && m.homeScore != null && m.awayScore != null) { %>
                <span class="score" style="color:<%= isLive ? 'var(--error)' : 'var(--text)' %>"><%= m.homeScore %>–<%= m.awayScore %></span>
              <% } else { %><span class="vs">vs</span><% } %>
              <span class="team" title="<%= m.awayTeam %>">
                <% if(m.awayTeamLogo) { %><img src="<%= m.awayTeamLogo %>" class="team-logo" alt="" onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'team-logo',textContent:'<%= awayInitial %>'}))"><% } else { %><span class="team-logo"><%= awayInitial %></span><% } %>
                <%= m.awayTeam %>
              </span>
            </div>
          </td>
          <td>
            <% if(m.has_pronostic && m.pronostic) { %>
              <% if(m.pronostic.is_premium){ %><span title="Premium" style="color:var(--warning)"><svg class="ic" aria-hidden="true"><use href="#ic-crown"/></svg></span> <% } %>
              <%= m.pronostic.prediction_label || m.pronostic.tip || '—' %>
            <% } else { %><span style="color:var(--text-dim)">—</span><% } %>
          </td>
          <td class="num"><%= (m.has_pronostic && m.pronostic && m.pronostic.odds) ? m.pronostic.odds : '—' %></td>
          <td class="num"><%= conf ? conf + '/5' : '—' %></td>
          <td>
            <% if(m.is_published) { %><span class="status pub">Publié</span>
            <% } else if(m.has_pronostic) { %><span class="status draft">Brouillon</span>
            <% } else { %><span class="status none">Sans prono</span><% } %>
            <% if(isFinished && m.has_pronostic) { %>
              <% const _r = m.pronostic?.result; %>
              <% if(_r === 'WIN') { %><span class="badge badge-ok" style="margin-left:.4rem"><svg class="ic" aria-hidden="true"><use href="#ic-trophy"/></svg> Gagné</span>
              <% } else if(_r === 'LOSS') { %><span class="badge badge-error" style="margin-left:.4rem"><svg class="ic" aria-hidden="true"><use href="#ic-heart"/></svg> Perdu</span>
              <% } else if(_r === 'PUSH') { %><span class="badge badge-info" style="margin-left:.4rem"><svg class="ic" aria-hidden="true"><use href="#ic-refresh"/></svg> Remboursé</span>
              <% } else { %><span class="badge badge-warn" style="margin-left:.4rem">⏳ En attente</span><% } %>
            <% } %>
          </td>
          <td class="col-act">
            <div class="row-act">
              <% if(m.has_pronostic && m.pronostic) { %>
                <button class="btn btn-sm btn-outline force-result-btn" data-id="<%= m.pronostic.id %>" data-result="WIN"  title="Forcer le résultat à GAGNANT"><svg class="ic" aria-hidden="true"><use href="#ic-check"/></svg></button>
                <button class="btn btn-sm btn-outline force-result-btn" data-id="<%= m.pronostic.id %>" data-result="LOSS" title="Forcer le résultat à PERDANT"><svg class="ic" aria-hidden="true"><use href="#ic-x"/></svg></button>
                <button class="btn btn-sm btn-outline force-result-btn" data-id="<%= m.pronostic.id %>" data-result="PUSH" title="Forcer le résultat à REMBOURSÉ"><svg class="ic" aria-hidden="true"><use href="#ic-refresh"/></svg></button>
              <% } %>
              <a href="/admin/pronostics/edit/<%= m.id %>" class="btn btn-primary btn-sm"><%= m.has_pronostic ? '' : '+ Créer' %></a>
            </div>
          </td>
        </tr>
  <% }) %>
  <% }) %>
      </tbody>
    </table>
  </div>
  </div>
</div>
<% } %>

<%# Les valeurs transitent par un attribut data plutôt que par une
    interpolation dans du JavaScript : un nom d'équipe contenant une
    apostrophe casserait le script. %>
<% if (typeof flash !== 'undefined' && flash) { %>
<div id="flash-prono" hidden
     data-ok="<%= flash.ok %>" data-match="<%= flash.match %>" data-tip="<%= flash.tip %>"></div>
<% } %>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const _fp = document.getElementById('flash-prono');
  window.__flashProno = _fp ? {
    ok: _fp.dataset.ok, match: _fp.dataset.match, tip: _fp.dataset.tip,
  } : null;
  // Confirmation de publication / brouillon.
  const flash = document.getElementById('flash-success');
  const info  = window.__flashProno ?? null;
  if (typeof showToast === 'function' && (flash || info)) {
    const brouillon = info && info.ok === 'brouillon';
    const detail    = info
      ? [info.match, info.tip].filter(Boolean).join('  ·  ')
      : '';
    showToast({
      type:   brouillon ? 'warning' : 'success',
      titre:  brouillon ? 'Brouillon enregistré' : 'Pronostic publié',
      detail: detail || (brouillon
        ? "Il n'apparaît pas encore dans l'application."
        : "Visible dans l'application."),
      action: brouillon ? null : { label: 'Voir les pronostics publiés →', href: '/admin/pronostics?mine=1' },
      duree:  brouillon ? 6000 : 5000,
    });
  }

  // ── Forcer le résultat WIN / LOSS / PUSH ────────────────────────────────────
  const forceResultLabel = r => r === 'WIN' ? '✅ GAGNANT' : r === 'PUSH' ? '🔄 REMBOURSÉ' : '❌ PERDANT';
  const forceResultBtnText = r => r === 'WIN' ? '✅ WIN' : r === 'PUSH' ? '🔄 Push' : '❌ LOSS';
  document.querySelectorAll('.force-result-btn').forEach(btn => {
    btn.addEventListener('click', async function() {
      const id     = this.dataset.id;
      const result = this.dataset.result;
      const label  = forceResultLabel(result);
      const confirmMsg = result === 'PUSH'
        ? `Forcer ce pronostic comme ${label} ?\n\nLa mise sera intégralement remboursée sur les paris en attente (ni gain ni perte).`
        : `Forcer ce pronostic comme ${label} ?\n\nTous les paris en attente seront réglés automatiquement.`;
      if (!confirm(confirmMsg)) return;

      this.disabled = true;
      this.textContent = '⏳';
      try {
        const res = await fetch(`/admin/pronostics/force-result/${id}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ result }),
        });
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.message || `Erreur ${res.status}`);
        }
        if (typeof showToast === 'function') {
          showToast(`Pronostic forcé ${label} — paris réglés.`, 'success');
        } else {
          alert(`Pronostic forcé ${label} — paris réglés.`);
        }
        // Mettre à jour visuellement le bouton
        this.textContent = forceResultBtnText(result);
        this.disabled = false;
      } catch(e) {
        if (typeof showToast === 'function') {
          showToast('Erreur : ' + e.message, 'error');
        } else {
          alert('Erreur : ' + e.message);
        }
        this.textContent = forceResultBtnText(result);
        this.disabled = false;
      }
    });
  });

  // ── Sélection multiple + actions groupées ─────────────────────────────────
  // Les cases ne sont proposées que sur les lignes qui ont un pronostic :
  // forcer un résultat n'a pas de sens sans pronostic.
  const chks    = () => [...document.querySelectorAll('.pro-chk')];
  const bulk    = document.getElementById('pro-bulk');
  const bulkN   = document.getElementById('pro-bulk-n');
  const allBox  = document.getElementById('pro-all');
  if (bulk) {
    const sync = () => {
      const sel = chks().filter(c => c.checked);
      bulkN.textContent = sel.length;
      bulk.toggleAttribute('data-on', sel.length > 0);
      chks().forEach(c => c.closest('tr').toggleAttribute('data-selected', c.checked));
      if (allBox) {
        allBox.checked = sel.length > 0 && sel.length === chks().length;
        allBox.indeterminate = sel.length > 0 && sel.length < chks().length;
      }
    };
    document.addEventListener('change', e => {
      if (e.target.classList.contains('pro-chk')) sync();
    });
    if (allBox) allBox.addEventListener('change', () => {
      chks().forEach(c => c.checked = allBox.checked); sync();
    });
    document.getElementById('pro-bulk-clear')?.addEventListener('click', () => {
      chks().forEach(c => c.checked = false); sync();
    });

    // Traitement séquentiel : le backend n'expose pas d'endpoint de lot, on
    // réutilise force-result une fois par pronostic. Séquentiel et non
    // parallèle pour ne pas déclencher le rate-limiter ni saturer le serveur.
    document.querySelectorAll('.bulk-result').forEach(btn => {
      btn.addEventListener('click', async () => {
        const result = btn.dataset.result;
        const ids    = chks().filter(c => c.checked).map(c => c.value);
        if (!ids.length) return;
        const label = forceResultLabel(result);
        if (!confirm(`Forcer ${ids.length} pronostic(s) comme ${label} ?

Les paris en attente seront réglés automatiquement.`)) return;

        document.querySelectorAll('.bulk-result').forEach(b => b.disabled = true);
        let ok = 0; const failed = [];
        for (const id of ids) {
          try {
            const res = await fetch(`/admin/pronostics/force-result/${id}`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'include',
              body: JSON.stringify({ result }),
            });
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            ok++;
            bulkN.textContent = `${ok}/${ids.length}`;
          } catch (e) { failed.push(id); }
        }
        document.querySelectorAll('.bulk-result').forEach(b => b.disabled = false);
        const msg = failed.length
          ? `${ok} réglé(s), ${failed.length} en échec.`
          : `${ok} pronostic(s) forcé(s) ${label} — paris réglés.`;
        if (typeof showToast === 'function') showToast(msg, failed.length ? 'error' : 'success');
        else alert(msg);
        if (ok) setTimeout(() => location.reload(), 1200);
      });
    });
  }
});
</script>

