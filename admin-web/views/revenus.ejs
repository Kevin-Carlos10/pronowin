<%- include('layout_top', {page:'revenus'}) %>
<link rel="stylesheet" href="/admin/assets/finance-control-room.css">
<section class="finance-page finance-page--revenue">

<style>
/* ── Cartes de synthèse ───────────────────────────────────────────────────── */
.rv-stats { display:grid; grid-template-columns:repeat(auto-fill,minmax(170px,1fr)); gap:.75rem; margin-bottom:1.25rem; }
.rv-stat  { background:var(--surface); border:1px solid var(--border); border-left:3px solid var(--border-s);
            border-radius:14px; padding:.9rem 1.1rem; transition:transform .2s, box-shadow .2s; }
.rv-stat:hover { transform:translateY(-2px); box-shadow:0 8px 24px rgba(0,0,0,.2); }
.rv-stat .l { font-size:.68rem; color:var(--text-dim); text-transform:uppercase; letter-spacing:.06em; font-weight:700; }
.rv-stat .v { font-size:1.55rem; font-weight:900; line-height:1.1; letter-spacing:-.03em; margin-top:.2rem; }
.rv-stat .s { font-size:.68rem; color:var(--text-dim); margin-top:.25rem; }
.rv-stat.or   { border-left-color:var(--warning); } .rv-stat.or   .v { color:var(--on-warning); }
.rv-stat.vert { border-left-color:var(--success); } .rv-stat.vert .v { color:var(--on-success); }
.rv-stat.bleu { border-left-color:var(--info);    } .rv-stat.bleu .v { color:var(--on-info); }

/* ── Histogramme, rendu côté serveur ──────────────────────────────────────── */
.rv-graph   { background:var(--surface); border:1px solid var(--border); border-radius:16px; padding:1.1rem 1.25rem 1rem; margin-bottom:1.25rem; }
.rv-titre   { font-size:.82rem; font-weight:700; color:var(--text-m); margin-bottom:.9rem; display:flex; align-items:center; gap:.4rem; flex-wrap:wrap; }
.rv-barres  { display:flex; align-items:flex-end; gap:2px; height:200px; padding-top:.3rem; }
.rv-col     { flex:1; min-width:0; height:100%; display:flex; flex-direction:column; justify-content:flex-end; }
.rv-piste   { width:100%; display:flex; align-items:flex-end; height:100%; }
.rv-remplie { width:100%; border-radius:3px 3px 0 0; background:linear-gradient(180deg,
              rgba(var(--primary-rgb,99,102,241),.9), rgba(var(--primary-rgb,99,102,241),.30)); transition:filter .15s; }
.rv-remplie.nulle { background:var(--border); }
.rv-col:hover .rv-remplie { filter:brightness(1.35); }
.rv-axe     { display:flex; justify-content:space-between; font-size:.66rem; color:var(--text-dim); margin-top:.5rem; }
.rv-vide    { height:200px; display:flex; align-items:center; justify-content:center; text-align:center;
              color:var(--text-dim); font-size:.84rem; line-height:1.65; padding:0 1.5rem; }

/* ── Tableau mensuel ──────────────────────────────────────────────────────── */
.rv-mois     { background:var(--surface); border:1px solid var(--border); border-radius:14px; overflow:hidden; }
.rv-ligne    { display:grid; grid-template-columns:1.2fr 1fr 1fr 1.6fr; gap:.75rem; align-items:center;
               padding:.7rem 1.1rem; border-bottom:1px solid var(--border); font-size:.85rem; }
.rv-ligne:last-child { border-bottom:0; }
.rv-ligne:hover      { background:var(--surface-d); }
.rv-entete   { font-size:.68rem; text-transform:uppercase; letter-spacing:.06em; font-weight:800;
               color:var(--text-dim); background:var(--surface-d); }
.rv-jauge    { height:6px; border-radius:99px; background:var(--surface-d); overflow:hidden; }
.rv-jauge > div { height:100%; border-radius:99px; background:var(--primary); }
@media (max-width:760px){ .rv-ligne { grid-template-columns:1fr 1fr; } .rv-entete { display:none; } }

/* ── Période ──────────────────────────────────────────────────────────────── */
.rv-periodes { display:flex; gap:.35rem; flex-wrap:wrap; }
.rv-periode  { padding:.35rem .75rem; border-radius:99px; font-size:.78rem; font-weight:700;
               border:1px solid var(--border); color:var(--text-m); text-decoration:none; }
.rv-periode:hover { background:var(--surface-d); color:var(--text); }
.rv-periode.on    { background:var(--btn-primary); border-color:var(--btn-primary); color:#fff; }

/* ── Ventes par canal ─────────────────────────────────────────────────────── */
.rv-canaux   { background:var(--surface); border:1px solid var(--border); border-radius:14px; overflow:hidden; margin-bottom:1.25rem; }
.rv-canal    { display:grid; grid-template-columns:1.4fr .8fr .8fr .9fr 1.6fr; gap:.75rem; align-items:center;
               padding:.7rem 1.1rem; border-bottom:1px solid var(--border); font-size:.85rem; }
.rv-canal:last-child { border-bottom:0; }
.rv-canal.rv-entete  { font-size:.68rem; }
.rv-canal .nom   { font-weight:700; }
.rv-canal .fort  { font-weight:800; color:var(--on-success); }
.rv-canal .sous  { display:block; font-size:.7rem; color:var(--text-dim); font-weight:400; margin-top:.1rem; }
.rv-canal.total  { background:var(--surface-d); font-weight:800; }
.rv-note         { font-size:.75rem; color:var(--text-dim); margin:-.6rem 0 1.25rem; line-height:1.6; }
.rv-export       { display:flex; gap:.5rem; align-items:center; flex-wrap:wrap; }
.rv-export select { width:auto; padding:.3rem .5rem; font-size:.78rem; }
@media (max-width:760px){ .rv-canal { grid-template-columns:1fr 1fr; } }
</style>

<%
  const _serie   = Array.isArray(serie)   ? serie   : [];
  const _mensuel = Array.isArray(mensuel) ? mensuel : [];
  const _jours   = typeof jours !== 'undefined' ? jours : 30;
  const _err     = typeof erreur !== 'undefined' ? erreur : null;

  const _total   = _serie.reduce((n, p) => n + (p.amount ?? 0), 0);
  const _pic     = Math.max(1, ..._serie.map(p => p.amount ?? 0));
  const _jourMax = _serie.find(p => (p.amount ?? 0) === _pic);
  const _actifs  = _serie.filter(p => (p.amount ?? 0) > 0).length;
  const _moyenne = _serie.length ? Math.round(_total / _serie.length) : 0;

  // Comparaison à la période précédente de même longueur, quand elle existe.
  const _moitie  = Math.floor(_serie.length / 2);
  const _recent  = _serie.slice(_moitie).reduce((n, p) => n + (p.amount ?? 0), 0);
  const _ancien  = _serie.slice(0, _moitie).reduce((n, p) => n + (p.amount ?? 0), 0);
  const _evol    = _ancien > 0 ? Math.round(((_recent - _ancien) / _ancien) * 100) : null;

  const _picMois = Math.max(1, ..._mensuel.map(m => m.revenue ?? 0));
  const _fcfa    = n => (n ?? 0).toLocaleString('fr-FR');

  const _canaux  = (typeof canaux !== 'undefined') ? canaux : null;
  const _libCan  = (typeof libelleCanal === 'function') ? libelleCanal : (c => c);
  // Les douze derniers mois, pour l'export comptable (le mois en cours compris).
  const _moisExport = Array.from({ length: 12 }, (_, i) => {
    const d = new Date(Date.UTC(new Date().getUTCFullYear(), new Date().getUTCMonth() - i, 1));
    return { val: d.toISOString().slice(0, 7),
             lib: d.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric', timeZone: 'UTC' }) };
  });
  const _storeMontant = l => l.store.map(x => x.montant.toLocaleString('fr-FR', { minimumFractionDigits: 2 }) + ' ' + x.devise).join(' + ');
%>

<header class="topbar workspace-header finance-workspace-header">
  <div class="workspace-heading">
    <div class="workspace-eyebrow"><svg class="ic" aria-hidden="true"><use href="#ic-money"/></svg> Pilotage financier</div>
    <h1><svg class="ic" aria-hidden="true"><use href="#ic-money"/></svg> Revenus</h1>
    <p class="workspace-description">Suivez les encaissements d'abonnements, leur rythme quotidien et leur évolution dans le temps.</p>
  </div>
  <div class="workspace-actions finance-period-controls">
    <div class="rv-periodes">
    <a class="btn btn-outline btn-sm" href="/admin/revenus/export?jours=<%= _jours %>"><svg class="ic" aria-hidden="true"><use href="#ic-download"/></svg> Exporter la période</a>
    <a class="btn btn-outline btn-sm" href="/admin/revenus/export?vue=mensuel"><svg class="ic" aria-hidden="true"><use href="#ic-download"/></svg> Exporter les 12 mois</a>
    <% [[7,'7 jours'],[30,'30 jours'],[90,'90 jours'],[365,'1 an']].forEach(([n, lib]) => { %>
    <a class="rv-periode <%= _jours === n ? 'on' : '' %>" href="/admin/revenus?jours=<%= n %>"
       aria-current="<%= _jours === n ? 'page' : 'false' %>"><%= lib %></a>
    <% }) %>
    </div>
  </div>
</header>

<% if (_err) { %>
<%# Un écran de revenus vide serait lu comme « zéro encaissé ». Une panne doit
    se distinguer d'un chiffre d'affaires nul. %>
<div class="alert alert-error">
  <strong><svg class="ic" aria-hidden="true"><use href="#ic-x"/></svg> Chiffres indisponibles</strong>
  <%# Le message d'erreur porte souvent deja sa ponctuation finale. %>
  — impossible de lire les revenus : <%= String(_err).replace(/[.\s]+$/, '') %>.
  Ce n'est pas un chiffre d'affaires nul, c'est une lecture qui a échoué.
</div>
<% } else { %>

<!-- ── Synthèse ─────────────────────────────────────────────────────────── -->
<div class="rv-stats metric-grid">
  <div class="rv-stat metric-card vert">
    <div class="l">Encaissé sur la période</div>
    <div class="v"><%= _fcfa(_total) %> <span style="font-size:.72rem;font-weight:700">FCFA</span></div>
    <% if (_evol !== null) { %>
    <div class="s" style="color:var(--<%= _evol >= 0 ? 'success' : 'error' %>)">
      <%= _evol >= 0 ? '+' : '' %><%= _evol %> % vs la première moitié de la période
    </div>
    <% } %>
  </div>
  <div class="rv-stat metric-card bleu">
    <div class="l">Moyenne par jour</div>
    <div class="v"><%= _fcfa(_moyenne) %></div>
    <div class="s"><%= _actifs %> jour<%= _actifs !== 1 ? 's' : '' %> avec au moins un encaissement</div>
  </div>
  <div class="rv-stat metric-card or">
    <div class="l">Meilleure journée</div>
    <div class="v" style="font-size:1.2rem"><%= _pic > 0 ? _fcfa(_pic) : '—' %></div>
    <div class="s"><%= _pic > 0 && _jourMax ? _jourMax.label : 'aucun encaissement' %></div>
  </div>
  <div class="rv-stat metric-card">
    <div class="l">Mois couverts</div>
    <div class="v" style="color:var(--primary-texte)"><%= _mensuel.length %></div>
    <div class="s">historique mensuel disponible</div>
  </div>
</div>

<!-- ── Ventes par canal ─────────────────────────────────────────────────── -->
<div class="control-section-head">
  <div>
    <h2>Ventes par canal</h2>
    <p>Ce que rapporte chaque moyen de paiement sur les <%= _jours %> derniers jours.</p>
  </div>
  <div class="rv-export">
    <%# Le détail des ventes d'un mois, une ligne par vente, pour le comptable. %>
    <form method="GET" action="/admin/revenus/export-comptable" class="rv-export">
      <select name="mois" aria-label="Mois de l'export comptable">
        <% _moisExport.forEach(m => { %><option value="<%= m.val %>"><%= m.lib %></option><% }) %>
      </select>
      <button type="submit" class="btn btn-outline btn-sm"><svg class="ic" aria-hidden="true"><use href="#ic-download"/></svg> Export comptable</button>
    </form>
    <a class="context-chip" href="/admin/fidelite">Fidélité des abonnés</a>
  </div>
</div>
<% if (!_canaux) { %>
  <p class="rv-note">Ventes par canal indisponibles : la lecture a échoué. Ce n'est pas une absence de ventes.</p>
<% } else if (!_canaux.canaux.length) { %>
  <p class="rv-note">Aucune vente sur la période.</p>
<% } else { %>
<div class="rv-canaux cr-panel">
  <div class="rv-canal rv-entete">
    <div>Canal</div><div>Ventes</div><div>Nouveaux</div><div>Réabonnements</div><div>Encaissé</div>
  </div>
  <% _canaux.canaux.forEach(l => { %>
  <div class="rv-canal">
    <div class="nom"><%= _libCan(l.canal) %></div>
    <div><%= l.ventes %></div>
    <div><%= l.nouveaux %></div>
    <div><%= l.reabonnements %></div>
    <div>
      <% if (l.canal === 'partenaire' || l.canal === 'offert') { %>
        <span class="sous"><%= l.canal === 'partenaire' ? 'mois offerts — rémunérés par la commission du partenaire' : 'accès offerts' %></span>
      <% } else { %>
        <% if (l.fcfa > 0 || (!l.store.length && !l.montantsInconnus)) { %><span class="fort"><%= _fcfa(l.fcfa) %> FCFA</span><% } %>
        <% if (l.store.length) { %>
          <span class="fort"><%= _storeMontant(l) %></span>
          <span class="sous">payé par les clients, avant la commission <%= l.canal === 'apple' ? "d'Apple" : 'de Google' %></span>
        <% } %>
        <% if (l.montantsInconnus) { %>
          <span class="sous"><%= l.montantsInconnus %> vente<%= l.montantsInconnus > 1 ? 's' : '' %> sans montant transmis par le store</span>
        <% } %>
      <% } %>
    </div>
  </div>
  <% }) %>
  <div class="rv-canal total">
    <div>Total</div><div><%= _canaux.total.ventes %></div><div><%= _canaux.total.nouveaux %></div>
    <div><%= _canaux.total.ventes - _canaux.total.nouveaux %></div><div><%= _fcfa(_canaux.total.fcfa) %> FCFA<% if (_canaux.canaux.some(l => l.store.length)) { %> + stores<% } %></div>
  </div>
</div>
<p class="rv-note">
  « Nouveaux » : premier abonnement du compte, tous canaux confondus. Un abonnement store est compté à chaque
  renouvellement mensuel ou annuel.
  <% if (_canaux.tests) { %>
    <%= _canaux.tests %> achat<%= _canaux.tests > 1 ? 's' : '' %> de test (TestFlight, vérification d'Apple)
    écarté<%= _canaux.tests > 1 ? 's' : '' %>.
  <% } %>
</p>
<% } %>

<!-- ── Histogramme quotidien ────────────────────────────────────────────── -->
<%# Rendu côté serveur, sans bibliothèque : la page Journal chargeait un
    graphique qui n'existait pas, et le cadre restait vide en silence. %>
<div class="control-section-head">
  <div>
    <h2>Rythme d'encaissement</h2>
    <p>Lecture quotidienne sur les <%= _jours %> derniers jours.</p>
  </div>
  <span class="context-chip"><%= _actifs %> jour<%= _actifs !== 1 ? 's' : '' %> actif<%= _actifs !== 1 ? 's' : '' %></span>
</div>
<div class="rv-graph cr-panel finance-revenue-graph">
  <div class="rv-titre">
    <svg class="ic" aria-hidden="true"><use href="#ic-chart"/></svg>
    Encaissements par jour
    <span style="font-weight:400;color:var(--text-dim)">— pic à <%= _fcfa(_pic) %> FCFA</span>
  </div>
  <% if (_total === 0) { %>
    <div class="rv-vide">
      Aucun encaissement sur les <%= _jours %> derniers jours.<br>
      Un revenu n'apparaît ici qu'à l'approbation d'une preuve Premium ou à un achat via les stores.
    </div>
  <% } else { %>
    <div class="rv-barres" role="img"
         aria-label="Revenus quotidiens sur <%= _jours %> jours, total <%= _fcfa(_total) %> FCFA">
      <% _serie.forEach(p => { const m = p.amount ?? 0; %>
      <div class="rv-col" title="<%= p.label %> — <%= _fcfa(m) %> FCFA">
        <div class="rv-piste">
          <div class="rv-remplie <%= m === 0 ? 'nulle' : '' %>"
               style="height:<%= m === 0 ? 2 : Math.max(3, Math.round((m / _pic) * 100)) %>%"></div>
        </div>
      </div>
      <% }) %>
    </div>
    <div class="rv-axe">
      <span><%= _serie[0] ? _serie[0].label : '' %></span>
      <span><%= _serie[_serie.length - 1] ? _serie[_serie.length - 1].label : '' %></span>
    </div>
  <% } %>
</div>

<!-- ── Historique mensuel ───────────────────────────────────────────────── -->
<div class="control-section-head">
  <div>
    <h2>Tendance mensuelle</h2>
    <p>Comparez chaque mois au meilleur niveau d'encaissement connu.</p>
  </div>
  <span class="context-chip"><%= _mensuel.length %> mois disponible<%= _mensuel.length !== 1 ? 's' : '' %></span>
</div>
<div class="rv-mois cr-panel finance-monthly-panel">
  <div class="rv-ligne rv-entete">
    <div>Mois</div><div>Revenu</div><div>Nouveaux inscrits</div><div>Part du meilleur mois</div>
  </div>
  <% if (!_mensuel.length) { %>
    <div style="padding:2rem 1rem;text-align:center;color:var(--text-dim);font-size:.84rem">
      Aucun historique mensuel. Il se construit au fil des abonnements enregistrés.
    </div>
  <% } %>
  <% _mensuel.slice().reverse().forEach(m => { %>
  <div class="rv-ligne">
    <div style="font-weight:700"><%= m.label ?? m.month ?? '—' %></div>
    <div style="font-weight:800;color:var(--on-success)"><%= _fcfa(m.revenue) %> F</div>
    <div><%= m.new_users ?? 0 %></div>
    <div>
      <div class="rv-jauge"><div style="width:<%= Math.round(((m.revenue ?? 0) / _picMois) * 100) %>%"></div></div>
    </div>
  </div>
  <% }) %>
</div>

<% const _inconnus = (serie ?? []).reduce((n, j) => n + (j.montants_inconnus ?? 0), 0); %>
<% if (_inconnus > 0) { %>
<p class="rv-inconnus" style="font-size:.8rem;margin-top:.9rem;line-height:1.6">
  <strong><%= _inconnus %> achat<%= _inconnus > 1 ? 's' : '' %> par un store</strong> sur la période
  n'<%= _inconnus > 1 ? 'ont' : 'a' %> pas encore de montant : le store ne le communique pas à la validation.
  Ces ventes ne sont pas comptées dans les totaux ci-dessus — elles ne valent pas zéro, elles restent à rapprocher
  des relevés du store.
</p>
<% } %>
<p class="finance-source-note" style="font-size:.75rem;color:var(--text-dim);margin-top:.9rem;line-height:1.6">
  Source : les abonnements enregistrés (<code>Subscription.amountPaid</code>) — un revenu est compté
  au moment où l'abonnement est accordé, c'est-à-dire à l'approbation de la preuve ou à la validation
  d'un achat par un store. Les demandes de versement de parrainage ne sont pas déduites ici ;
  elles figurent dans <a href="/admin/historique" style="color:var(--primary-texte)">Historique</a>.
</p>

<% } %>

</section>
<%- include('layout_bottom') %>
