<%
  // formId : 'create' (prefix 'cp') ou 'modal' (prefix 'mp')
  // existingPerms : tableau de permissions actuelles
  const _prefix = formId === 'create' ? 'cp' : 'mp';

  // La lecture du niveau accordé vient du serveur (`lib/permissions.js`, via
  // res.locals). La copie qui vivait ici renvoyait le PREMIER niveau trouvé au
  // lieu du plus élevé : sur un compte enregistré avec
  // ["pronostics:read","pronostics:write","pronostics:delete"] — ce que produit
  // la cascade des cases — elle répondait « read », et le tableau n'affichait
  // qu'une case cochée sur trois.
  const _getLevel = (key) => niveauAccorde(existingPerms || [], key);

  function _levelOk(key, lvl) {
    const granted = _getLevel(key);
    if (!granted) return false;
    const order = ['read','write','delete'];
    return order.indexOf(granted) >= order.indexOf(lvl);
  }
%>
<div class="perm-table-wrap">
  <div class="table-wrap">
    <table class="perm-table">
      <thead>
        <tr>
          <th scope="col" style="width:40%">Section</th>
          <th scope="col" class="perm-level-head lvl-read"><svg class="ic" aria-hidden="true"><use href="#ic-eye"/></svg> Lire</th>
          <th scope="col" class="perm-level-head lvl-write"><svg class="ic" aria-hidden="true"><use href="#ic-edit"/></svg> Écrire</th>
          <th scope="col" class="perm-level-head lvl-delete"><svg class="ic" aria-hidden="true"><use href="#ic-trash"/></svg> Supprimer</th>
        </tr>
      </thead>
      <tbody>
      <% PERMISSIONS.forEach(function(p) {
           const levels = p.levels || {};
      %>
        <tr>
          <td>
            <div class="perm-key-label"><%- p.icon ? '<svg class="ic" aria-hidden="true"><use href="#ic-' + p.icon + '"/></svg> ' : '' %><%= p.label %></div>
            <div class="perm-key-desc"><%= p.desc %></div>
          </td>
  
          <!-- READ -->
          <td>
            <% if (levels.read) { %>
            <label title="<%= levels.read %>">
              <input type="checkbox"
                class="perm-cb"
                id="<%= _prefix %>-<%= p.key %>-read"
                name="permissions"
                value="<%= p.key %>:read"
                <%= _levelOk(p.key, 'read') ? 'checked' : '' %>
                onchange="onPermChange('<%= _prefix %>','<%= p.key %>','read')">
            </label>
            <% } else { %>
            <span style="color:var(--text-dim);font-size:.8rem;">—</span>
            <% } %>
          </td>
  
          <!-- WRITE -->
          <td>
            <% if (levels.write) { %>
            <label title="<%= levels.write %>">
              <input type="checkbox"
                class="perm-cb"
                id="<%= _prefix %>-<%= p.key %>-write"
                name="permissions"
                value="<%= p.key %>:write"
                <%= _levelOk(p.key, 'write') ? 'checked' : '' %>
                onchange="onPermChange('<%= _prefix %>','<%= p.key %>','write')">
            </label>
            <% } else { %>
            <span style="color:var(--text-dim);font-size:.8rem;">—</span>
            <% } %>
          </td>
  
          <!-- DELETE -->
          <td>
            <% if (levels.delete) { %>
            <label title="<%= levels.delete %>">
              <input type="checkbox"
                class="perm-cb"
                id="<%= _prefix %>-<%= p.key %>-delete"
                name="permissions"
                value="<%= p.key %>:delete"
                <%= _levelOk(p.key, 'delete') ? 'checked' : '' %>
                onchange="onPermChange('<%= _prefix %>','<%= p.key %>','delete')">
            </label>
            <% } else { %>
            <span style="color:var(--text-dim);font-size:.8rem;">—</span>
            <% } %>
          </td>
        </tr>
      <% }); %>
      </tbody>
    </table>
  </div>
</div>
