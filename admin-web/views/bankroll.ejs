<%- include('layout_top', {page:'bankroll'}) %>

<%
  function qParam(obj) {
    return Object.entries(obj).filter(([,v])=>v).map(([k,v])=>`${k}=${encodeURIComponent(v)}`).join('&');
  }
  const _filterQs = qParam({ search, sort_by: sortBy, sort_dir: sortDir });
%>

<div class="topbar">
  <div>
    <h2>🎯 Bankroll</h2>
    <small><%= total %> utilisateur<%= total>1?'s':'' %> avec un budget configuré</small>
  </div>
</div>

<% if(error){ %>
  <div class="alert alert-error" style="margin-bottom:12px">❌ <%= error %></div>
<% } %>

<!-- Recherche + tri -->
<div class="filter-block card" id="filter-block">
  <form method="GET" action="/admin/bankroll" id="filter-form">
    <div class="filter-main-row">
      <input type="text" name="search" value="<%= search %>"
        placeholder="🔍 Rechercher pseudo, téléphone, email…" class="filter-search-input">

      <select name="sort_by">
        <option value="currentBalance" <%= sortBy==='currentBalance' ?'selected':'' %>>Solde actuel</option>
        <option value="totalBudget"    <%= sortBy==='totalBudget'    ?'selected':'' %>>Budget total</option>
        <option value="createdAt"      <%= sortBy==='createdAt'      ?'selected':'' %>>Date de création</option>
        <option value="pseudo"         <%= sortBy==='pseudo'         ?'selected':'' %>>Pseudo A-Z</option>
      </select>

      <select name="sort_dir">
        <option value="desc" <%= sortDir==='desc' ?'selected':'' %>>Décroissant</option>
        <option value="asc"  <%= sortDir==='asc'  ?'selected':'' %>>Croissant</option>
      </select>

      <div class="filter-actions-row">
        <button type="submit" class="btn btn-primary">Filtrer</button>
        <% if(search){ %>
        <a href="/admin/bankroll" class="btn btn-outline">✕ Effacer</a>
        <% } %>
      </div>
    </div>
  </form>
</div>

<!-- Table -->
<div class="card" style="padding:0;overflow:hidden">
  <% if(!data || data.length === 0){ %>
    <div class="empty-state" style="padding:40px">
      <div style="font-size:2rem;margin-bottom:.5rem">🎯</div>
      <p><%= search ? 'Aucun résultat pour cette recherche.' : 'Aucun utilisateur n\'a encore configuré de budget bankroll.' %></p>
      <% if(search){ %><a href="/admin/bankroll" class="btn btn-outline" style="margin-top:12px">Effacer la recherche</a><% } %>
    </div>
  <% } else { %>
  <div class="table-wrap"><table>
    <thead>
      <tr>
        <th>Utilisateur</th>
        <th>Solde / Budget</th>
        <th>Paris</th>
        <th>Taux réussite</th>
        <th>Profit</th>
        <th>ROI</th>
        <th style="text-align:right">Actions</th>
      </tr>
    </thead>
    <tbody>
    <% data.forEach(b => { %>
    <tr>
      <td>
        <div style="display:flex;align-items:center;gap:10px">
          <div style="width:36px;height:36px;border-radius:50%;background:var(--surface-d);display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:var(--text-dim);flex-shrink:0">
            <%= (b.pseudo||'?')[0].toUpperCase() %>
          </div>
          <div>
            <p style="font-weight:600;color:var(--text)"><%= b.pseudo %></p>
            <p style="font-size:11px;color:var(--text-dim)"><%= b.phone_number || b.email || '' %></p>
          </div>
        </div>
      </td>
      <td>
        <p style="font-weight:700;color:<%= b.current_balance >= b.total_budget ? 'var(--success)' : 'var(--text)' %>">
          <%= Math.round(b.current_balance).toLocaleString('fr-FR') %> <%= b.currency %>
        </p>
        <p style="font-size:11px;color:var(--text-dim)">sur <%= Math.round(b.total_budget).toLocaleString('fr-FR') %> <%= b.currency %></p>
      </td>
      <td style="color:var(--text-m);font-size:13px">
        <%= b.total_bets %>
        <% if(b.pending_bets > 0){ %><br><span style="font-size:10px;color:var(--warning)"><%= b.pending_bets %> en attente</span><% } %>
      </td>
      <td>
        <% if(b.win_rate === null){ %>
          <span style="color:var(--border);font-size:12px">—</span>
        <% } else { %>
          <span class="badge <%= b.win_rate >= 50 ? 'badge-ok' : 'badge-err' %>"><%= b.win_rate %>%</span>
          <p style="font-size:10px;color:var(--text-dim);margin-top:2px"><%= b.wins %>V / <%= b.losses %>D</p>
        <% } %>
      </td>
      <td style="font-weight:600;color:<%= b.total_profit >= 0 ? 'var(--success)' : 'var(--error)' %>">
        <%= b.total_profit >= 0 ? '+' : '' %><%= Math.round(b.total_profit).toLocaleString('fr-FR') %>
      </td>
      <td>
        <% if(b.roi === null){ %>
          <span style="color:var(--border);font-size:12px">—</span>
        <% } else { %>
          <span style="font-weight:600;color:<%= b.roi >= 0 ? 'var(--success)' : 'var(--error)' %>"><%= b.roi >= 0 ? '+' : '' %><%= b.roi %>%</span>
        <% } %>
      </td>
      <td style="text-align:right">
        <a href="/admin/bankroll/<%= b.user_id %>" class="btn btn-sm btn-outline">Voir →</a>
      </td>
    </tr>
    <% }) %>
    </tbody>
  </table></div>

  <!-- Pagination -->
  <% if(total_pages > 1){ %>
  <div style="display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-top:1px solid var(--border)">
    <p style="color:var(--text-m);font-size:12px">
      <%= ((page-1)*per_page)+1 %>–<%= Math.min(page*per_page, total) %> sur <%= total %>
    </p>
    <div style="display:flex;gap:6px;align-items:center">
      <% if(page > 1){ %>
        <a href="/admin/bankroll?page=<%= page-1 %>&<%= _filterQs %>" class="btn btn-sm btn-outline">← Préc.</a>
      <% } %>
      <span style="padding:5px 12px;background:var(--surface-d);border-radius:6px;font-size:12px;color:var(--text)">
        Page <%= page %> / <%= total_pages %>
      </span>
      <% if(page < total_pages){ %>
        <a href="/admin/bankroll?page=<%= page+1 %>&<%= _filterQs %>" class="btn btn-sm btn-outline">Suiv. →</a>
      <% } %>
    </div>
  </div>
  <% } %>
  <% } %>
</div>

<%- include('layout_bottom') %>
