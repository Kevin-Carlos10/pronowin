          <div>
            <label for="odds-away" style="display:block;font-size:.7rem;color:var(--text-dim);margin-bottom:.3rem;font-weight:500">2 (<%= match.awayTeam %>)</label>
            <input class="input" type="number" id="odds-away" name="odds_away" step="0.01" min="1" required
