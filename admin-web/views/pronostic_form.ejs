<% const uiText = typeof tAdmin === 'function' ? tAdmin : text => text; %>
<%- include('layout_top', {page:'pronostics'}) %>

<style>
/* ── Match preview ────────────────────────────────────────────────────────────── */
.match-preview {
  display:flex; align-items:center; justify-content:center;
  gap:1.5rem; padding:1.5rem 1rem;
}
.mp-team { text-align:center; flex:1; }
.mp-team img {
  width:64px; height:64px; border-radius:50%; object-fit:contain;
  background:var(--surface-d); margin-bottom:.5rem;
}
.mp-team .initial {
  width:64px; height:64px; border-radius:50%; background:var(--surface-d);
  display:flex; align-items:center; justify-content:center;
  font-size:1.5rem; font-weight:800; color:var(--text-m);
  margin:0 auto .5rem;
}
.mp-team .tname { font-size:.95rem; font-weight:700; line-height:1.3; }
.mp-sep { font-size:1.25rem; font-weight:800; color:var(--text-dim); flex-shrink:0; }
.mp-meta { text-align:center; margin-top:.75rem; padding-top:.75rem; border-top:1px solid var(--border); }

/* ── Indice de confiance (pourcentage) ─────────────────────────────────────── */
.conf-saisie { display:flex; align-items:center; gap:.5rem; margin-bottom:.5rem; }
.conf-saisie .conf-nombre { width:5.5rem; font-weight:800; font-size:1.05rem; }
.conf-saisie .conf-unite { font-weight:800; color:var(--text-p); }
.conf-saisie input[type=range] { flex:1; accent-color:var(--primary-texte); min-height:44px; }

/* ── Cotes grid ───────────────────────────────────────────────────────────────── */
.odds-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:.75rem; }
@media(max-width:640px){ .odds-grid { grid-template-columns:1fr 1fr; } }

/* ── Type pills ────────────────────────────────────────────────────────────────── */
.type-pills { display:flex; flex-wrap:wrap; gap:.4rem; margin-bottom:.75rem; }
.type-pill {
  padding:.35rem .75rem; border-radius:20px; font-size:.78rem; font-weight:600;
  background:var(--surface-d); border:1px solid var(--border); color:var(--text-m);
  cursor:pointer; transition:all .15s; white-space:nowrap;
}
.type-pill:hover, .type-pill.active { background:rgba(var(--primary-rgb),.12); border-color:var(--primary); color:var(--primary-texte); }
.pill-odd { margin-left:.35rem; font-weight:800; }

/* ── Libellé qui ne décrit plus le marché enregistré ───────────────────────── */
.libelle-ecart { margin-top:.5rem; padding:.6rem .75rem; border-radius:8px;
  border:1px solid var(--error); background:rgba(var(--error-rgb),.08); }
.libelle-ecart p { margin:0 0 .5rem; font-size:var(--fs-s); color:var(--text); }
.libelle-ecart strong { color:var(--on-danger); }
.libelle-ecart-actions { display:flex; flex-wrap:wrap; gap:.5rem; }
.libelle-ecart-actions .btn { min-height:44px; }

/* ── Autres marchés 1xBet (hors API, cote saisie) ─────────────────────────── */
.marches-plus { margin-top:.6rem; }
.marches-plus-corps { padding:.75rem; display:grid; gap:.6rem; }
.marches-plus-aide { font-size:var(--fs-xs); color:var(--text-m); margin:0; }
.marches-plus-options { display:grid; grid-template-columns:repeat(auto-fit,minmax(9rem,1fr)); gap:.6rem; }
.marches-plus-corps label { display:block; font-size:var(--fs-xs); color:var(--text-m); margin-bottom:.25rem; font-weight:600; }
.marches-plus-apercu { font-size:var(--fs-s); color:var(--text); margin:0; min-height:1.2em; }
.marches-plus-erreur { font-size:var(--fs-s); color:var(--on-danger); margin:0; font-weight:600; }
.marches-plus-corps .btn { justify-self:start; min-height:44px; }

/* ── Tous les marchés (accordéon) ─────────────────────────────────────────────── */
.markets-wrap { border:1px solid var(--border); border-radius:8px; overflow:hidden; }
.markets-wrap > summary {
  padding:.55rem .75rem; font-size:.8rem; font-weight:700; cursor:pointer;
  background:var(--surface-d); list-style:none;
  display:flex; align-items:center; gap:.5rem;
}
.markets-wrap > summary::-webkit-details-marker { display:none; }
.markets-wrap > summary::after { content:'▾'; margin-left:auto; color:var(--text-dim); transition:transform .15s; }
.markets-wrap[open] > summary::after { transform:rotate(180deg); }
.market-group {
  border:1px solid var(--border); border-radius:8px; margin-bottom:.5rem; overflow:hidden;
}
.market-group summary {
  padding:.55rem .75rem; font-size:.8rem; font-weight:700; cursor:pointer;
  background:var(--surface-d); list-style:none; display:flex; align-items:center; justify-content:space-between;
}
.market-group summary::-webkit-details-marker { display:none; }
.market-group summary::after { content:'▾'; color:var(--text-dim); transition:transform .15s; }
.market-group[open] summary::after { transform:rotate(180deg); }
.market-chips { display:flex; flex-wrap:wrap; gap:.4rem; padding:.6rem .75rem; }
.market-value-chip {
  padding:.3rem .65rem; border-radius:14px; font-size:.75rem; font-weight:600;
  background:var(--surface); border:1px solid var(--border); color:var(--text-m);
  cursor:pointer; transition:all .15s; white-space:nowrap;
}
.market-value-chip:hover { border-color:var(--primary); color:var(--primary-texte); }
.market-value-chip.active { background:rgba(var(--primary-rgb),.15); border-color:var(--primary); color:var(--primary-texte); }
.custom-pick-banner {
  display:none; align-items:center; gap:.6rem; padding:.6rem .8rem; margin-top:.6rem;
  background:rgba(var(--primary-rgb),.08); border:1px solid var(--primary); border-radius:8px; font-size:.8rem;
}
.custom-pick-banner button {
  margin-left:auto; background:none; border:none; color:var(--text-dim); cursor:pointer; font-size:.9rem;
}

/* ── Premium toggle ────────────────────────────────────────────────────────────── */
.vip-toggle {
  display:flex; align-items:center; gap:.75rem; padding:.75rem 1rem;
  background:var(--surface-d); border:1px solid var(--border);
  border-radius:var(--radius-s); cursor:pointer; transition:all .15s;
}
.vip-toggle:hover { border-color:var(--warning); }
.vip-toggle input { display:none; }
.vip-badge {
  display:flex; align-items:center; justify-content:center;
  width:36px; height:36px; border-radius:50%;
  background:rgba(var(--warning-rgb),.12); font-size:1.2rem; flex-shrink:0;
}
.vip-toggle .info { flex:1; }
.vip-toggle .info .t { font-size:.85rem; font-weight:700; color:var(--text); }
.vip-toggle .info .s { font-size:.75rem; color:var(--text-dim); margin-top:.1rem; }
.vip-toggle .checkmark { color:var(--text-dim); font-size:1.1rem; transition:color .15s; }
.vip-toggle.checked { border-color:var(--warning); }
.vip-toggle.checked .checkmark { color:var(--on-warning); }
.vip-toggle.checked .vip-badge { background:rgba(var(--warning-rgb),.2); }
</style>

<%
  const pro = match.pronostic ?? {};
  const homeInitial = (match.homeTeam||'?')[0].toUpperCase();
  const awayInitial = (match.awayTeam||'?')[0].toUpperCase();
  const matchDate   = new Date(match.matchDate);
  const dateStr     = matchDate.toLocaleDateString('fr-FR',{weekday:'long',day:'numeric',month:'long',year:'numeric'});
  const timeStr     = matchDate.toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});
  const isEdit      = !!pro.id;

  // Match termine : le pronostic n'est plus modifiable.
  //
  // Le serveur le refusait deja — `upsertPronostic` leve « Impossible de creer
  // un pronostic pour un match termine » — mais l'ecran laissait croire le
  // contraire : tous les champs restaient actifs, et « Publier maintenant »
  // echouait avec un message parlant de creation. On saisissait, on validait,
  // et rien n'etait enregistre.
  //
  // Deux actions restent legitimes et ne passent pas par cette ecriture : la
  // depublication (route dediee) et la correction du resultat.
  const _termine = String(match.status || '').toUpperCase() === 'FINISHED';
  // Même heuristique que la liste (pronostics.ejs) : le statut LIVE en base
  // peut avoir jusqu'à 2 minutes de retard (fréquence du cron de sync).
  const _diffMin    = Math.floor((matchDate.getTime() - Date.now()) / 60000);
  const isLive      = match.status === 'LIVE' || (_diffMin < 0 && _diffMin > -120);
%>

<header class="workspace-header">
  <div class="workspace-heading">
    <p class="workspace-eyebrow">Desk pronostics</p>
    <a href="/admin/pronostics" class="view-tab">← Retour aux matchs</a>
    <h1><%= isEdit ? '✏️ Modifier' : '+ Créer' %> un pronostic</h1>
    <p class="workspace-description"><%= match.homeTeam %> — <%= match.awayTeam %> · <%= match.league %> · <%= dateStr %> à <%= timeStr %></p>
  </div>
  <div class="workspace-actions">
  <% if(isEdit && pro.is_published) { %>
  <span class="badge badge-ok"><svg class="ic" aria-hidden="true"><use href="#ic-check"/></svg> <%= uiText("Publié") %></span>
  <% } else if(isEdit) { %>
  <span class="badge badge-warn"><svg class="ic" aria-hidden="true"><use href="#ic-edit"/></svg> <%= uiText("Brouillon") %></span>
  <% } %>
  </div>
</header>

<% if(error){ %><div class="alert alert-error"><%= error %></div><% } %>

<%
  const _prog      = (typeof programmation !== 'undefined') ? programmation : null;
  const _progEchec = (typeof programmationEchec !== 'undefined') ? programmationEchec : null;
  const _heure     = (typeof heureLocale === 'function') ? heureLocale : (iso => iso);
  const _valeurProg = (typeof valeurProgrammation !== 'undefined') ? valeurProgrammation : '';
%>
<% if (typeof query !== 'undefined' && query.programmation === 'annulee') { %>
  <div class="alert alert-success">Programmation annulée : le pronostic reste en brouillon.</div>
<% } %>
<% if (_prog) { %>
  <%# Bandeau d'état, pas un message d'action : il reste dans la page. %>
  <div class="alert alert-warning" data-toast="skip"><div>
    <strong>Publication programmée le <%= _heure(_prog.prevueLe) %></strong> (heure de Ouagadougou)<%= _prog.creeePar ? ', par ' + _prog.creeePar : '' %>.
    Les membres seront prévenus à ce moment-là. Enregistrer des modifications en brouillon ne change pas l'heure.
  </div>
  <form method="POST" action="/admin/pronostics/programmations/<%= _prog.id %>/annuler" class="pf-prog-annuler">
    <input type="hidden" name="match_id" value="<%= match.id %>">
    <button type="submit" class="btn btn-outline btn-sm">Annuler la programmation</button>
  </form></div>
<% } else if (_progEchec) { %>
  <div class="alert alert-error" data-toast="skip"><div>
    <strong>La publication programmée le <%= _heure(_progEchec.prevueLe) %> n'a pas eu lieu.</strong>
    <%= _progEchec.compteRendu %>
  </div></div>
<% } %>

<style>
/* La colonne gauche s'étire sur toute la hauteur de la ligne (align-items par
   défaut) : c'est ce qui permet au bloc `.pf-side` de rester collé pendant que
   la colonne de droite, beaucoup plus longue, défile. Sans cela le récap et
   les boutons disparaissaient dès le premier scroll. */
.pf-main-grid { display:grid; grid-template-columns:340px 1fr; gap:1rem; }
.pf-side      { position:sticky; top:16px; }
.prono-mobile-summary { display:none; flex-direction:column; gap:4px; padding:12px; margin-bottom:12px; border:1px solid var(--border); border-radius:10px; background:var(--surface); }
.prono-mobile-summary span { font-size:13px; color:var(--text-m); }
.prono-actions { display:flex; flex-wrap:wrap; gap:10px; position:sticky; bottom:0; padding:14px; border:1px solid var(--border-s); border-radius:12px; background:var(--surface); z-index:40; margin-top:16px; }
.prono-actions .btn { min-height:44px; }
@media(max-width:900px) { .prono-actions { position:fixed; left:12px; right:12px; bottom:calc(90px + env(safe-area-inset-bottom)); box-shadow:var(--shadow-lg); } .prono-actions .btn { flex:1; white-space:normal; } }
/* Une seule rangée sur mobile.
   Mesuré à 390 × 844 en modifiant un pronostic publié : la barre faisait 133 px
   sur deux rangées — « Enregistrer les modifications » et « Sauvegarder
   brouillon » cassaient chacun sur deux lignes, et « Dépublier » occupait seul
   la seconde. Avec la navigation du bas, 26 % de l'écran était masqué en
   permanence, pendant toute la saisie.
   Les libellés courts ne remplacent les longs que sur ce format : l'action
   reste nommée, seul le complément tombe. */
.lbl-court { display:none; }
/* Publication programmée : hors de la barre d'actions, qui doit tenir sur une
   rangée au téléphone. Placée après elle dans le formulaire : le premier
   bouton reste « Publier », celui que déclenche la touche Entrée. */
.pf-programmer        { margin-top:16px; padding:14px; }
.pf-programmer-titre  { display:block; font-size:.72rem; font-weight:700; color:var(--text-m); text-transform:uppercase; letter-spacing:.05em; margin-bottom:.5rem; }
.pf-programmer-ligne  { display:flex; gap:.5rem; flex-wrap:wrap; align-items:center; }
.pf-programmer-ligne input[type=datetime-local] { width:auto; min-height:44px; }
.pf-programmer-aide   { margin:.5rem 0 0; font-size:.75rem; color:var(--text-dim); line-height:1.55; }
.pf-prog-annuler      { margin:0 0 0 auto; flex-shrink:0; }
@media(max-width:900px) {
  /* Une rangée seulement quand la barre ne porte que des boutons. Sur un match
     terminé elle porte une note et « Dépublier » : forcés côte à côte, le
     bouton était écrasé en un filet et son libellé débordait — vu en test. */
  .prono-actions:not(.termine)      { flex-wrap:nowrap; }
  .prono-actions:not(.termine) .btn { white-space:nowrap; min-width:0; }
  .prono-actions.termine .note-termine { flex:1 1 100%; }
  .lbl-long                 { display:none; }
  .lbl-court                { display:inline; }

  /* La réserve sous le contenu, et non plus sous le formulaire.
     Elle était posée sur `#pro-form` (150 px) alors que les boutons de
     résultat viennent *après* lui : on obtenait un vide au milieu de la page,
     et « Retirer du bilan », tout en bas, restait sous la barre fixe même en
     défilant jusqu'au bout — mesuré, `elementFromPoint` renvoyait la barre.
     La hauteur de la barre varie (une rangée de boutons, ou une note sur un
     match terminé) : le script qui suit la mesure. 90 px = son décalage
     au-dessus de la navigation du bas. */
  .main { padding-bottom:calc(var(--barre-actions, 150px) + 90px + 16px + env(safe-area-inset-bottom)); }
}
/* Deux colonnes internes pour les champs courts (label / confiance) : le
   formulaire tenait sur une seule colonne et laissait ~40 % de la largeur vide. */
.pf-two       { display:grid; grid-template-columns:1fr 1fr; gap:1rem; align-items:start; }

/* Sous 1180 px la barre latérale du panel (260 px) + la colonne d'infos (340 px)
   ne laissaient que ~350 px au formulaire — plus étroit que la version d'origine.
   On empile alors : le formulaire récupère toute la largeur et garde ses deux
   colonnes internes. */
@media(max-width:1180px){
  .pf-main-grid { grid-template-columns:1fr; }
  .pf-side      { position:static; }
  .pf-main-grid > :first-child { order: 2; }
  .pf-main-grid > :last-child { order: 1; }
  .prono-mobile-summary { display:flex !important; }
  .pf-side .match-preview { padding:.5rem; }
  .pf-side .mp-team img, .pf-side .mp-team .initial { width:36px; height:36px; }
}
@media(max-width:760px){ .pf-two { grid-template-columns:1fr; gap:0; } }
</style>

<%# Un échec de dépublication doit se voir. L'opération échouait côté serveur
    et la redirection ramenait ici sans rien dire : le pronostic restait publié,
    l'écran ne le contestait pas, et l'administrateur croyait l'avoir retiré. %>
<% if(typeof query !== 'undefined' && query.depublish_error) { %>
<div class="alert alert-error" style="margin-bottom:1rem">
  <svg class="ic" aria-hidden="true"><use href="#ic-x"/></svg>
  Dépublication impossible : <%= query.depublish_error %>
</div>
<% } %>

<form method="POST" action="/admin/pronostics/edit/<%= match.id %>" id="pro-form">
<fieldset class="translation-preview" lang="en" <%= _termine ? 'disabled' : '' %>><legend>English translation</legend><p><%= uiText("Champs facultatifs : sans traduction, le texte français est conservé.") %></p>
<div class="form-group"><label for="i18n-prediction_label_en">Custom prediction label</label><textarea class="input" id="i18n-prediction_label_en" name="prediction_label_en" rows="3" maxlength="500"><%= (pro).prediction_label_en || '' %></textarea></div>
<div class="form-group"><label for="i18n-analyst_note_en">Analyst note</label><textarea class="input" id="i18n-analyst_note_en" name="analyst_note_en" rows="3" maxlength="50000"><%= (pro).analyst_note_en || '' %></textarea></div>
</fieldset>

<div class="prono-mobile-summary"><strong><%= match.homeTeam %> — <%= match.awayTeam %></strong><span><%= match.league %> · <%= dateStr %> · <%= timeStr %></span></div>
<div class="pf-main-grid">

  <!-- ── Colonne gauche : match info + récap + actions (collante) ─────────────── -->
  <div>
   <div class="pf-side">
    <div class="card cr-panel">
      <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.85rem">
        <% if(match.leagueLogo){ %><img src="<%= match.leagueLogo %>" style="width:18px;height:18px;object-fit:contain" onerror="this.style.display='none'" alt=""><% } %>
        <span class="badge badge-info" style="font-size:.7rem"><%= match.league %></span>
        <% if(isLive){ %>
        <span class="badge" style="font-size:.7rem;background:color-mix(in srgb,var(--error) 15%,transparent);color:var(--on-danger)"><svg class="ic ic-sm" aria-hidden="true" style="color:var(--on-danger)"><use href="#ic-dot"/></svg> <%= uiText("EN DIRECT") %></span>
        <% } %>
      </div>

      <% if(isLive){ %>
      <div style="font-size:.72rem;color:var(--text-dim);margin-bottom:.6rem;padding:.5rem .6rem;background:color-mix(in srgb,var(--error) 6%,transparent);border:1px solid color-mix(in srgb,var(--error) 20%,transparent);border-radius:8px">
        <svg class="ic" aria-hidden="true"><use href="#ic-alert"/></svg> Match en cours — les cotes pré-match peuvent être suspendues ou obsolètes chez certains bookmakers.
      </div>
      <% } %>

      <div class="match-preview">
        <div class="mp-team">
          <% if(match.homeTeamLogo){ %>
          <img src="<%= match.homeTeamLogo %>" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" alt="">
          <div class="initial" style="display:none"><%= homeInitial %></div>
          <% } else { %>
          <div class="initial"><%= homeInitial %></div>
          <% } %>
          <div class="tname"><%= match.homeTeam %></div>
        </div>
        <div class="mp-sep">VS</div>
        <div class="mp-team">
          <% if(match.awayTeamLogo){ %>
          <img src="<%= match.awayTeamLogo %>" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" alt="">
          <div class="initial" style="display:none"><%= awayInitial %></div>
          <% } else { %>
          <div class="initial"><%= awayInitial %></div>
          <% } %>
          <div class="tname"><%= match.awayTeam %></div>
        </div>
      </div>

      <div class="mp-meta">
        <div style="font-weight:700;margin-bottom:.25rem"><%= dateStr %></div>
        <div style="color:var(--text-dim);font-size:.82rem">⏰ Coup d'envoi à <strong><%= timeStr %></strong></div>
        <!-- L'UUID n'a d'utilité qu'en cas de ticket support : replié par défaut. -->
        <details style="margin-top:.5rem">
          <summary style="font-size:.7rem;color:var(--text-dim);cursor:pointer;list-style:none;user-select:none"><svg class="ic" aria-hidden="true"><use href="#ic-search"/></svg> Référence technique</summary>
          <div style="font-size:.66rem;color:var(--text-dim);font-family:monospace;margin-top:.35rem;word-break:break-all"><%= match.id %></div>
        </details>
      </div>
    </div>

    <% if(isEdit) { %>
    <div class="card cr-panel" style="margin-top:.75rem;padding:.85rem 1rem">
      <div style="font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;color:var(--text-dim);font-weight:700;margin-bottom:.6rem"><%= uiText("Historique") %></div>
      <% if(pro.createdAt){ %><div style="font-size:.78rem;color:var(--text-m)"><svg class="ic" aria-hidden="true"><use href="#ic-edit"/></svg> Créé le <%= new Date(pro.createdAt).toLocaleDateString('fr-FR',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}) %></div><% } %>
      <% if(pro.updatedAt){ %><div style="font-size:.78rem;color:var(--text-m);margin-top:.3rem"><svg class="ic" aria-hidden="true"><use href="#ic-refresh"/></svg> Modifié le <%= new Date(pro.updatedAt).toLocaleDateString('fr-FR',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}) %></div><% } %>
      <% if(pro.publishedAt){ %><div style="font-size:.78rem;color:var(--on-success);margin-top:.3rem"><svg class="ic" aria-hidden="true"><use href="#ic-rocket"/></svg> Publié le <%= new Date(pro.publishedAt).toLocaleDateString('fr-FR',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}) %></div><% } %>
    </div>
    <% } %>

    <!-- ── Ce que l'abonné verra (mis à jour en direct par updateRecap()) ────── -->
    <div class="card cr-panel" style="margin-top:.75rem;padding:.85rem 1rem">
      <div style="font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;color:var(--text-dim);font-weight:700;margin-bottom:.6rem">
        Ce que l'abonné verra
      </div>
      <div id="recap-label" style="font-size:.88rem;font-weight:700;line-height:1.35;word-break:break-word">—</div>
      <div style="display:flex;gap:1.25rem;margin-top:.55rem">
        <div>
          <div style="font-size:.66rem;color:var(--text-dim);text-transform:uppercase;letter-spacing:.04em"><%= uiText("Cote") %></div>
          <div id="recap-odd" style="font-size:1.05rem;font-weight:800">—</div>
        </div>
        <div>
          <div style="font-size:.66rem;color:var(--text-dim);text-transform:uppercase;letter-spacing:.04em"><%= uiText("Confiance") %></div>
          <div id="recap-conf" style="font-size:1.05rem;font-weight:800">—</div>
        </div>
        <div>
          <div style="font-size:.66rem;color:var(--text-dim);text-transform:uppercase;letter-spacing:.04em">Accès</div>
          <div id="recap-access" style="font-size:.88rem;font-weight:700;margin-top:.15rem"><%= uiText("Tous") %></div>
        </div>
      </div>


    </div>
   </div>
  </div>

  <!-- ── Colonne droite : formulaire ──────────────────────────────────────────── -->
  <div class="card cr-panel">

      <%# Un `fieldset` desactive neutralise d'un coup tous les controles qu'il
          contient — champs, listes, boutons. Le faire champ par champ aurait
          laisse passer le prochain ajout : c'est la structure qui garantit la
          regle, pas la vigilance.

          Il enveloppe la seule colonne des champs modifiables. La depublication
          et la correction du resultat sont ailleurs, et restent actives. %>
      <fieldset <%= _termine ? 'disabled' : '' %>
                style="border:0;padding:0;margin:0;min-width:0">

      <% if(_termine) { %>
      <div class="alert" style="margin-bottom:1.1rem;background:color-mix(in srgb,var(--warning) 10%,transparent);border:1px solid color-mix(in srgb,var(--warning) 30%,transparent);color:var(--text-p)">
        <svg class="ic" aria-hidden="true"><use href="#ic-alert"/></svg>
        <div>
          <strong>Ce match est terminé — le pronostic est verrouillé.</strong>
          <div style="font-size:.78rem;color:var(--text-m);line-height:1.55;margin-top:.2rem">
            Le résultat est joué : réécrire la prédiction après coup fausserait
            le bilan public. Pour le retirer des statistiques, utilisez
            « ↺ Retirer du bilan » dans la section Résultat, plus bas — le pronostic
            et l'historique de vos utilisateurs restent intacts.
          </div>
        </div>
      </div>
      <% } %>

      <!-- Type de pronostic -->
      <div class="form-group" style="margin-bottom:1.1rem">
        <label id="lbl-type">Type de pronostic</label>
        <div class="type-pills" id="type-pills" role="group" aria-labelledby="lbl-type">
          <% const types = [
            {v:'win1',  l:'🏠 Victoire dom.'},
            {v:'draw',  l:'🤝 Match nul'},
            {v:'win2',  l:'✈️ Victoire ext.'},
            {v:'btts',  l:'⚽⚽ BTTS'},
            {v:'over25',l:'📈 +2.5 buts'},
            {v:'under25',l:'📉 -2.5 buts'},
            {v:'over35',l:'📈 +3.5 buts'},
            {v:'under35',l:'📉 -3.5 buts'},
          ]; %>
          <% types.forEach(t => { %>
          <div class="type-pill <%= (pro.prediction_type||'win1')===t.v?'active':'' %>"
               data-val="<%= t.v %>" role="button" tabindex="0"
               aria-pressed="<%= (pro.prediction_type||'win1')===t.v ? 'true':'false' %>"
               onclick="setType('<%= t.v %>')"
               onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();setType('<%= t.v %>')}"><%= t.l %><span class="pill-odd" id="odd-<%= t.v %>"></span></div>
          <% }) %>
        </div>
        <input type="hidden" name="prediction_type" id="type-input" value="<%= pro.prediction_type||'win1' %>">
        <input type="hidden" name="market_name" id="market-name-input" value="<%= pro.market_name||'' %>">
        <input type="hidden" name="market_value" id="market-value-input" value="<%= pro.market_value||'' %>">
        <%# Noms d'équipe repris tels quels dans le journal d'activité : sans eux,
            il affichait « Match #09fa3d5a-a0c7-4011-a5f1… », un identifiant que
            personne ne peut relier à une rencontre en le lisant. %>
        <input type="hidden" name="home_team" value="<%= match.homeTeam %>">
        <input type="hidden" name="away_team" value="<%= match.awayTeam %>">
        <p style="font-size:.72rem;color:var(--text-dim);margin-top:.4rem">
          <svg class="ic" aria-hidden="true"><use href="#ic-bulb"/></svg> Les cotes 1xBet se chargent automatiquement à l'ouverture : la cote réelle s'affiche sur chaque option,
          et les marchés complets apparaissent plus bas.
        </p>

        <div class="custom-pick-banner" id="custom-pick-banner"
             style="<%= pro.prediction_type==='other' ? 'display:flex' : '' %>">
          <svg class="ic" aria-hidden="true"><use href="#ic-target"/></svg> Marché personnalisé : <strong id="custom-pick-text"></strong>
          <button type="button" onclick="clearCustomPick()" aria-label="Retirer le marché personnalisé"><svg class="ic" aria-hidden="true"><use href="#ic-x"/></svg></button>
        </div>

        <!-- Replié par défaut : les cotes se chargent désormais toutes seules, et
             31 marchés dépliés d'office repousseraient le reste du formulaire
             hors de l'écran. On l'ouvre quand on cherche un marché précis. -->
        <details class="markets-wrap" style="margin-top:.9rem;display:none" id="all-markets-section">
          <summary>
            <span>Tous les marchés 1xBet</span>
            <span style="font-size:.7rem;color:var(--text-dim);font-weight:600" id="markets-count"></span>
          </summary>
          <div id="markets-accordion" style="padding:.6rem .5rem 0"></div>
        </details>

        <!-- Marchés que l'API ne fournit pas : la cote se recopie depuis 1xBet,
             le résultat se règle avec le score (backend/src/marches/). -->
        <details class="markets-wrap marches-plus" id="marches-plus">
          <summary><span><%= uiText("Autres marchés 1xBet (cote à saisir)") %></span></summary>
          <div class="marches-plus-corps">
            <p class="marches-plus-aide"><%= uiText("Marchés absents de l’API : recopie la cote affichée par 1xBet. Le résultat se calcule tout seul avec le score du match.") %></p>
            <div>
              <label for="mp-marche"><%= uiText("Marché") %></label>
              <select class="input" id="mp-marche"><option value=""><%= uiText("Choisir un marché") %></option></select>
            </div>
            <div class="marches-plus-options" id="mp-options"></div>
            <p class="marches-plus-aide" id="mp-note" hidden></p>
            <div>
              <label for="mp-cote"><%= uiText("Cote 1xBet") %></label>
              <input class="input" type="number" id="mp-cote" step="0.001" min="1.01" inputmode="decimal" placeholder="1.80">
            </div>
            <p class="marches-plus-apercu" id="mp-apercu" aria-live="polite"></p>
            <p class="marches-plus-erreur" id="mp-erreur" role="alert" hidden></p>
            <button type="button" class="btn btn-outline" id="mp-utiliser"><%= uiText("Utiliser ce marché") %></button>
          </div>
        </details>
      </div>

      <!-- Cotes -->
      <div class="form-group" style="margin-bottom:1.1rem">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.5rem;gap:.5rem;flex-wrap:wrap">
          <label style="margin:0" id="lbl-odds"><%= uiText("Cotes") %></label>
          <button type="button" id="btn-fetch-odds" onclick="fetchOdds()"
            style="display:flex;align-items:center;gap:.4rem;padding:.3rem .75rem;font-size:.78rem;
                   background:rgba(var(--primary-rgb),.12);border:1px solid var(--primary);
                   color:var(--primary-texte);border-radius:8px;cursor:pointer;font-weight:600;transition:all .15s">
            <span id="odds-btn-icon"><svg class="ic" aria-hidden="true"><use href="#ic-zap"/></svg></span> <span id="odds-btn-text">Charger les cotes 1xBet</span>
