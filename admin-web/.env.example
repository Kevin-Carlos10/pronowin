ADMIN_PORT=4000
API_URL=http://localhost:3000/api/v1

# ── Compte de service (tâches de fond) ───────────────────────────────────────
# Sans lui : pas de KPI temps réel sur le tableau de bord, les bans temporaires
# expirés ne rendent pas l'accès au compte, et les sous-admins reçoivent un
# jeton d'API vide — toutes leurs pages de données restent alors vides.
# Doit correspondre à un compte admin EXISTANT et ACTIF côté API.
ADMIN_SERVICE_EMAIL=admin@exemple.com
ADMIN_SERVICE_PASSWORD=
# Repli utilisé si le compte ci-dessus n'est pas renseigné.
ADMIN_API_TOKEN=
