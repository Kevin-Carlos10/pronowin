# Application
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ── Version checker ───────────────────────────────────────────────────────────
APP_MIN_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
APP_FORCE_UPDATE=false
APP_UPDATE_MESSAGE=Une nouvelle version de PronoWin est disponible.

# Base de données PostgreSQL
DATABASE_URL="postgresql://pronowin_user:PASSWORD@localhost:5432/pronowin_db"

# JWT
JWT_SECRET=CHANGE_THIS_SECRET_KEY_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_THIS_REFRESH_SECRET_KEY
JWT_REFRESH_EXPIRES_IN=30d

# WhatsApp OTP (Meta Cloud API)
# Obtenir sur: https://developers.facebook.com → Mon application → WhatsApp → Configuration
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_TEMPLATE_NAME=pronowin_otp
WHATSAPP_TEMPLATE_LANG=fr

# Paiement CinetPay (Mobile Money)
CINETPAY_API_KEY=your_cinetpay_api_key
CINETPAY_SITE_ID=your_site_id

# Stripe (Carte bancaire)
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY

# 1xBet Affiliation
XBET_AFFILIATE_ID=your_affiliate_id
XBET_API_KEY=your_api_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ─── Achat intégré (IAP) ──────────────────────────────────────────────────────
# URL publique du backend — sert à construire les URLs de webhook.
# Apple et Google n'appellent jamais localhost.
PUBLIC_BASE_URL=https://api.pronowin.app

# Apple — App Store Connect › Users and Access › Integrations › In-App Purchase
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_BUNDLE_ID=com.pronowin.app
# Contenu du fichier .p8, sauts de ligne échappés en \n
APPLE_IAP_PRIVATE_KEY=

# Google — compte de service avec le rôle « Afficher les données financières »
ANDROID_PACKAGE_NAME=com.pronowin.app
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=

# Accepter les reçus Sandbox. Automatique hors production ; à ne JAMAIS mettre
# à true en production (un compte de test Apple offrirait un Premium gratuit).
IAP_ACCEPT_SANDBOX=false

# Tarif des builds store (+50 % pour absorber la commission Apple/Google).
# Sert uniquement aux écrans d'accroche : le prix facturé est celui saisi dans
# App Store Connect / Play Console.
PREMIUM_PRICE_USD_STORE_MONTHLY=15
PREMIUM_PRICE_USD_STORE_ANNUAL=135

# Delai de validation annonce a l'utilisateur, source unique.
# L'ecran mobile l'affiche tel quel — il en existait quatre copies ecrites en
# dur qui restaient sur l'ancienne valeur quand on raccourcissait le delai.
REVIEW_DELAY_DIRECT=30 minutes ouvrables
REVIEW_DELAY_CODE=2 heures ouvrables

# ── Connexion Google ──────────────────────────────────────────────────────────
# Identifiant OAuth **Web** du projet Firebase. Le mobile doit passer la meme
# valeur en --dart-define=GOOGLE_SERVER_CLIENT_ID.
GOOGLE_CLIENT_IDS=votre-client-web.apps.googleusercontent.com
