generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String              @id @default(uuid())
  phoneNumber           String?             @unique @map("phone_number")
  email                 String?             @unique
  passwordHash          String?             @map("password_hash")
  pseudo                String
  avatarUrl             String?             @map("avatar_url")
  // Nullable et sans défaut : l'ancien `@default("BF")` enregistrait tout le
  // monde comme burkinabè, y compris les utilisateurs qui n'avaient jamais
  // renseigné leur pays — une valeur fausse, indiscernable d'un vrai choix, et
  // qui faussait aussi les statistiques admin. « Non renseigné » se dit null.
  countryCode           String?             @map("country_code")
  subscriptionPlan      SubscriptionPlan    @default(free) @map("subscription_plan")
  subscriptionExpiresAt DateTime?           @map("subscription_expires_at")
  referralCode          String              @unique @map("referral_code")
  referredBy            String?             @map("referred_by")
  referralEarnings      Float               @default(0) @map("referral_earnings")
  isActive              Boolean             @default(true) @map("is_active")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  lastLoginAt           DateTime?           @map("last_login_at")
  lastSeenAt            DateTime?           @map("last_seen_at")
  fcmToken              String?             @map("fcm_token")
  // Préférences de notification par catégorie : { match, promo, referral, premium }.
  // Les topics FCM ne suffisaient pas — les notifs personnelles (parrainage,
  // premium) partent par token, donc se désabonner d'un topic ne les coupait
  // pas. Une clé absente vaut « activé » (modèle opt-out).
  notificationPrefs     Json?               @map("notification_prefs")
  xbetId                String?             @map("xbet_id")
  birthDate             DateTime?           @map("birth_date")
  firstName             String?             @map("first_name")
  lastName              String?             @map("last_name")
  acceptedTermsAt       DateTime?           @map("accepted_terms_at")
  termsVersion          Int                 @default(1) @map("terms_version")
  phoneVerified         Boolean             @default(false) @map("phone_verified")
  emailVerified         Boolean             @default(false) @map("email_verified")
  deletedAt             DateTime?           @map("deleted_at")
  streakDays            Int                 @default(0) @map("streak_days")
  streakLastDate        DateTime?           @map("streak_last_date")
  xpTotal               Int                 @default(0) @map("xp_total")
  iapPurchases          IapPurchase[]
  notifications         Notification[]
  otpCodes              OtpCode[]
  referredUsers         Referral[]          @relation("ReferredRelation")
  referrals             Referral[]          @relation("ReferrerRelation")
  refreshTokens         RefreshToken[]
  proofSubmissions      SubscriptionProof[]
  subscriptions         Subscription[]
  transactions          Transaction[]
  tutorialProgress      TutorialProgress[]
  bankroll              UserBankroll?
  favoriteMatches       UserFavoriteMatch[]
  comments              Comment[]
  pronosticVotes        PronosticVote[]

  @@index([createdAt])
  @@map("users")
}

model UserBankroll {
  id             String        @id @default(uuid())
  userId         String        @unique @map("user_id")
  totalBudget    Float         @map("total_budget")
  currentBalance Float         @map("current_balance")
  currency       String        @default("XOF")
  lastResetAt    DateTime?     @map("last_reset_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  bets           BankrollBet[]
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_bankrolls")
}

model BankrollBet {
  id              String       @id @default(uuid())
  bankrollId      String       @map("bankroll_id")
  pronosticId     String       @map("pronostic_id")
  stakedAmount    Float        @map("staked_amount")
  suggestedAmount Float        @map("suggested_amount")
  oddsUsed        Float        @map("odds_used")
  potentialGain   Float        @map("potential_gain")
  result          String?
  profit          Float?
  settledAt       DateTime?    @map("settled_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  bankroll        UserBankroll @relation(fields: [bankrollId], references: [id], onDelete: Cascade)
  pronostic       Pronostic    @relation(fields: [pronosticId], references: [id], onDelete: Cascade)

  @@unique([bankrollId, pronosticId])
  @@index([pronosticId])
  @@index([result, createdAt])
  @@map("bankroll_bets")
}

model UserFavoriteMatch {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  matchId   String   @map("match_id")
  createdAt DateTime @default(now()) @map("created_at")
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
  @@map("user_favorite_matches")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  body      String
  type      String   @default("system")
  deepLink  String?  @map("deep_link")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model OtpCode {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  phoneNumber String   @map("phone_number")
  code        String
  expiresAt   DateTime @map("expires_at")
  used        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  user        User?    @relation(fields: [userId], references: [id])

  @@map("otp_codes")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  used      Boolean  @default(false) @map("used")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Admin {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String      @map("password_hash")
  name         String
  role         AdminRole   @default(analyst)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  lastLoginAt  DateTime?   @map("last_login_at")
  pronostics   Pronostic[]

  @@map("admins")
}

model Match {
  id             String              @id @default(uuid())
  externalId     Int                 @map("external_id")
  source         MatchSource         @default(FOOTBALL_DATA)
  league         String
  leagueCode     String              @map("league_code")
  leagueLogo     String?             @map("league_logo")
  homeTeam       String              @map("home_team")
  homeTeamFull   String?             @map("home_team_full")
  homeTeamLogo   String?             @map("home_team_logo")
  awayTeam       String              @map("away_team")
  awayTeamFull   String?             @map("away_team_full")
  awayTeamLogo   String?             @map("away_team_logo")
  matchDate      DateTime            @map("match_date")
  status         MatchStatus         @default(SCHEDULED)
  homeScore      Int?                @map("home_score")
  awayScore      Int?                @map("away_score")
  homeScoreHT    Int?                @map("home_score_ht")
  awayScoreHT    Int?                @map("away_score_ht")
  homeFormPoints Int                 @default(0) @map("home_form_points")
  awayFormPoints Int                 @default(0) @map("away_form_points")
  fetchedAt      DateTime            @default(now()) @map("fetched_at")
  alertSent      Boolean             @default(false) @map("alert_sent")
  // Copie dénormalisée de pronostic.isPublished — un orderBy Prisma à travers
  // une relation 1-1 optionnelle ne gère pas correctement le placement des
  // NULL (matchs sans pronostic), ce qui empêchait de trier "prono d'abord"
  // au niveau de la requête (donc de la pagination). Tenue à jour dans
  // upsertPronostic()/togglePublish() (pronostics.service.ts).
  hasPublishedPronostic Boolean      @default(false) @map("has_published_pronostic")
  // Rang dénormalisé du statut (LIVE=0, SCHEDULED=1, FINISHED=2, autre=3) —
  // même limite Prisma que hasPublishedPronostic : trier par heure seule
  // laissait les matchs LIVE hors des premières pages de pagination. Tenu à
  // jour dans matchStatusPriority() (api_football.service.ts), utilisé à
  // chaque écriture de `status` (découverte admin + syncMatchScores).
  statusPriority Int                 @default(1) @map("status_priority")
  pronostic      Pronostic?
  favoritedBy    UserFavoriteMatch[]

  @@unique([externalId, source])
  @@index([matchDate])
  @@index([status])
  @@index([hasPublishedPronostic])
  @@index([statusPriority])
  @@map("matches")
}

/// Liste blanche des compétitions autorisées à apparaître dans le flux
/// public "Tous les matchs" — un match dont la ligue n'est pas ici (ou y est
/// avec isVisible=false) reste exclu de getAllMatches/getDaySummary, sauf
/// s'il a lui-même un pronostic publié (décision éditoriale déjà prise par
/// l'admin en le publiant). N'affecte pas la découverte admin, qui doit
/// pouvoir trouver n'importe quel match pour y créer un pronostic.
model LeagueVisibility {
  leagueCode String   @id @map("league_code")
  league     String
  isVisible  Boolean  @default(false) @map("is_visible")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([isVisible])
  @@map("league_visibility")
}

/// Fournisseur d'origine d'un match — les deux API ont leur propre
/// numérotation, externalId seul ne suffit pas à les distinguer.
enum MatchSource {
  FOOTBALL_DATA
  API_FOOTBALL
}

model Pronostic {
  id              String         @id @default(uuid())
  matchId         String         @unique @map("match_id")
  analystId       String         @map("analyst_id")
  predictionType  PredictionType @map("prediction_type")
  predictionLabel String         @map("prediction_label")
  // Marché/valeur bruts 1xBet quand le pronostic ne correspond à aucun des 8
  // types connus (predictionType = 'other') — ex. "Asian Handicap" / "Home +0".
  // Le résultat WIN/LOSS de ces pronostics doit être forcé manuellement.
  marketName      String?        @map("market_name")
  marketValue     String?        @map("market_value")
  oddsHome        Float          @default(0) @map("odds_home")
  oddsDraw        Float          @default(0) @map("odds_draw")
  oddsAway        Float          @default(0) @map("odds_away")
  oddsRecommended Float          @map("odds_recommended")
  confidenceScore Int            @map("confidence_score")
  analystNote     String?        @map("analyst_note")
  isPremium       Boolean        @default(false) @map("is_premium")
  isPublished     Boolean        @default(false) @map("is_published")
  isDailyFree     Boolean        @default(false) @map("is_daily_free")
  result          String?
  publishedAt     DateTime?      @map("published_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  aiExplanation   String?        @map("ai_explanation")
  aiProbability   Float?         @map("ai_probability")
  bankrollBets    BankrollBet[]
  comments        Comment[]
  votes           PronosticVote[]
  analyst         Admin          @relation(fields: [analystId], references: [id])
  match           Match          @relation(fields: [matchId], references: [id])

  @@map("pronostics")
}

model Transaction {
  id            String            @id @default(uuid())
  userId        String            @map("user_id")
  type          TransactionType
  amount        Float
  currency      String            @default("XOF")
  paymentMethod String            @map("payment_method")
  status        TransactionStatus @default(pending)
  metadata      Json?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  adminNote     String?           @map("admin_note")
  processedAt   DateTime?         @map("processed_at")
  processedBy   String?           @map("processed_by")
  senderPhone   String?           @map("sender_phone")
  xbetId        String?           @map("xbet_id")
  user          User              @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId, createdAt(sort: Desc)])
  @@map("transactions")
}

model Subscription {
  id            String             @id @default(uuid())
  userId        String             @map("user_id")
  plan          SubscriptionPlan
  amountPaid    Float              @map("amount_paid")
  paymentMethod String             @map("payment_method")
  promoCodeUsed String?            @map("promo_code_used")
  startDate     DateTime           @map("start_date")
  endDate       DateTime           @map("end_date")
  autoRenew     Boolean            @default(false) @map("auto_renew")
  createdAt     DateTime           @default(now()) @map("created_at")
  proof         SubscriptionProof?
  user          User               @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}

enum IapStore {
  apple
  google
}

/// Achats via l'App Store / Google Play.
///
/// La source de vérité reste le store : on ne fait que projeter son état sur
/// `User.subscriptionExpiresAt`. `transactionId` est unique — c'est ce qui rend
/// la vérification idempotente, le mobile pouvant rejouer le même reçu
/// (restauration, relance après un crash, notification serveur en doublon).
model IapPurchase {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  store                 IapStore
  productId             String   @map("product_id")
  /// Identifiant de LA transaction (un renouvellement en crée une nouvelle).
  transactionId         String   @unique @map("transaction_id")
  /// Identifiant de l'ABONNEMENT, stable à travers les renouvellements.
  /// Apple : originalTransactionId. Google : le purchaseToken d'origine.
  originalTransactionId String   @map("original_transaction_id")
  expiresAt             DateTime @map("expires_at")
  /// Reflète l'état renvoyé par le store : active, expired, canceled, refunded…
  status                String   @default("active")
  /// « Sandbox » ou « Production » — un reçu de test ne doit jamais créditer
  /// un compte en production.
  environment           String   @default("Production")
  /// Réponse brute du store, conservée pour pouvoir rejouer un diagnostic.
  payload               Json?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt(sort: Desc)])
  @@index([originalTransactionId])
  @@map("iap_purchases")
}

model SubscriptionProof {
  id                   String                @id @default(uuid())
  userId               String                @map("user_id")
  subscriptionId       String?               @unique @map("subscription_id")
  type                 SubscriptionProofType
  screenshotUrl        String                @map("screenshot_url")
  paymentScreenshotUrl String?               @map("payment_screenshot_url")
  xbetId               String?               @map("xbet_id")
  platform             String?               @map("platform")
  planId               String?               @map("plan_id")
  amount               Float?
  senderPhone          String?               @map("sender_phone")
  status               ProofStatus           @default(pending)
  adminNote            String?               @map("admin_note")
  reviewedBy           String?               @map("reviewed_by")
  reviewedAt           DateTime?             @map("reviewed_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  subscription         Subscription?         @relation(fields: [subscriptionId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@map("subscription_proofs")
}

model Referral {
  id               String   @id @default(uuid())
  referrerId       String   @map("referrer_id")
  referredId       String   @map("referred_id")
  level            Int      @default(1)
  commissionAmount Float    @default(0) @map("commission_amount")
  isPaid           Boolean  @default(false) @map("is_paid")
  createdAt        DateTime @default(now()) @map("created_at")
  referred         User     @relation("ReferredRelation", fields: [referredId], references: [id])
  referrer         User     @relation("ReferrerRelation", fields: [referrerId], references: [id])

  @@unique([referrerId, referredId])
  @@index([referredId])
  @@map("referrals")
}

model Tutorial {
  id              String             @id
  title           String
  description     String
  level           String             @default("beginner")
  category        String
  thumbnailUrl    String?            @map("thumbnail_url")
  videoUrl        String?            @map("video_url")
  durationSeconds Int                @default(0) @map("duration_seconds")
  isPremium       Boolean            @default(false) @map("is_premium")
  hasVideo        Boolean            @default(false) @map("has_video")
  viewCount       Int                @default(0) @map("view_count")
  rating          Float              @default(0)
  authorName      String?            @map("author_name")
  publishedAt     DateTime?          @map("published_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  articleContent  String?            @map("article_content")
  progress        TutorialProgress[]

  @@map("tutorials")
}

model TutorialProgress {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  tutorialId     String    @map("tutorial_id")
  watchedSeconds Int       @default(0) @map("watched_seconds")
  isCompleted    Boolean   @default(false) @map("is_completed")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  tutorial       Tutorial  @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tutorialId])
  @@map("tutorial_progress")
}

enum SubscriptionPlan {
  free
  premium
}

enum TransactionType {
  deposit
  withdrawal
}

enum TransactionStatus {
  pending
  processing
  completed
  rejected
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  SUSPENDED
}

enum PredictionType {
  win1
  draw
  win2
  btts
  over25
  under25
  over35
  under35
  // Marché 1xBet quelconque hors des 7 ci-dessus (handicap asiatique, mi-temps,
  // score exact, etc.) — voir Pronostic.marketName/marketValue pour le détail.
  other
}

enum SubscriptionProofType {
  payment_screenshot
  xbet_account_screenshot
}

enum ProofStatus {
  pending
  approved
  rejected
}

enum AdminRole {
  super_admin
  analyst
}

model Comment {
  id          String    @id @default(uuid())
  pronosticId String    @map("pronostic_id")
  userId      String    @map("user_id")
  content     String
  isExpert    Boolean   @default(false) @map("is_expert")
  parentId    String?   @map("parent_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  pronostic   Pronostic @relation(fields: [pronosticId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      Comment?  @relation("replies", fields: [parentId], references: [id])
  replies     Comment[] @relation("replies")

  @@index([pronosticId, createdAt])
  @@index([userId])
  @@map("comments")
}

model PronosticVote {
  id          String    @id @default(uuid())
  pronosticId String    @map("pronostic_id")
  userId      String    @map("user_id")
  type        String    // "AGREE" | "DISAGREE"
  createdAt   DateTime  @default(now()) @map("created_at")

  pronostic   Pronostic @relation(fields: [pronosticId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pronosticId, userId])
  @@map("pronostic_votes")
}
