# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# Données d'exécution de l'admin-web (journal d'audit, réglages en cours).
# Ce sont des états, pas du code : les suivre génère un conflit à chaque
# déploiement. sub_admins.json était déjà ignoré pour la même raison.
admin-web/data/audit_log.json
admin-web/data/settings.json
# Sessions ouvertes du panneau : empreintes d'identifiants et jeton d'API de
# l'administrateur principal. Jamais dans le dépôt.
admin-web/data/sessions.json
admin-web/data/*.tmp

# ── Sauvegardes locales avant modification destructive ───────────────────────
# Copies datées prises avant un changement risqué. Ce sont des doublons du code
# déjà présent : les versionner ferait cohabiter deux exemplaires d'un même
# fichier, et on finirait par éditer le mauvais.
sauvegarde_*/
