<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<!-- ── Identité de l'app ──────────────────────────────────────────────── -->
		<key>CFBundleDisplayName</key>
		<string>PronoWin</string>
		<key>CFBundleName</key>
		<string>PronoWin</string>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<!-- Les langues de l'interface (lib/l10n). Sans cette liste, iOS tient
		     l'app pour monolingue : l'App Store n'annonce pas l'anglais, et les
		     éléments fournis par le système restent dans la langue de base. -->
		<key>CFBundleLocalizations</key>
		<array>
			<string>fr</string>
			<string>en</string>
		</array>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<!-- ── Schéma URL custom pour deep links (pronowin://app/pronostics/ID) ── -->
		<!-- Universal Links (https://pronowin.app/...) sont gérés via Runner.entitlements -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>com.pronowin.app</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>pronowin</string>
				</array>
			</dict>
			<!-- ── Retour de la connexion Google ────────────────────────────────
			     Le SDK Google ouvre Safari pour le choix du compte, puis renvoie
			     vers ce schéma pour rendre la main à l'app. Sans lui, l'utilisateur
			     choisit son compte et reste bloqué dans le navigateur.

			     La valeur est le REVERSED_CLIENT_ID de GoogleService-Info.plist —
			     l'identifiant iOS écrit à l'envers. Elle change si l'app Apple est
			     recréée dans Firebase : les deux fichiers doivent alors être
			     remis en phase.

			     Entrée distincte de celle du dessus : `pronowin` sert aux deep
			     links de l'app, ce schéma-ci appartient au SDK Google. Les
			     fusionner rendrait impossible de savoir lequel supprimer le jour
			     où l'un des deux disparaît. -->
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>com.googleusercontent.apps</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.googleusercontent.apps.207728984029-vl7ofjlv4olnri2qdok875s28763801b</string>
				</array>
			</dict>
		</array>
		<!-- ── App Transport Security ────────────────────────────────────────────
	     En prod, supprimer NSAllowsArbitraryLoads et ne garder que
	     l'exception pour le domaine de production si nécessaire.
	     En dev, autorise le serveur local HTTP. -->
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSAllowsArbitraryLoads</key>
			<false/>
			<!-- Exception pour le serveur de développement local -->
			<key>NSExceptionDomains</key>
			<dict>
				<key>192.168.11.111</key>
				<dict>
					<key>NSExceptionAllowsInsecureHTTPLoads</key>
					<true/>
					<key>NSIncludesSubdomains</key>
					<false/>
				</dict>
				<key>localhost</key>
				<dict>
					<key>NSExceptionAllowsInsecureHTTPLoads</key>
					<true/>
				</dict>
			</dict>
		</dict>
		<!-- ── Permissions ───────────────────────────────────────────────────── -->
		<!-- Biométrie (Face ID / Touch ID) -->
		<key>NSFaceIDUsageDescription</key>
		<string>PronoWin utilise Face ID pour sécuriser l'accès à votre compte.</string>
		<!-- Galerie photos (upload preuve de paiement) -->
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Sélectionnez une capture d'écran de votre paiement pour activer le Premium.</string>
		<key>NSCameraUsageDescription</key>
		<string>Prenez une photo de votre confirmation de paiement pour activer le Premium.</string>
		<!-- ── Orientation : portrait uniquement ─────────────────────────────── -->
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<!-- iPhone seulement (TARGETED_DEVICE_FAMILY = 1) : l'app est dessinée pour un
		     téléphone en portrait. Déclarer l'iPad imposait les quatre orientations
		     (multitâche) et Apple refusait l'envoi (erreur 90474). Sur iPad, elle
		     s'ouvre en mode iPhone. -->
		<!-- ── UI ────────────────────────────────────────────────────────────── -->
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UIStatusBarHidden</key>
		<false/>
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<false/>
		<!-- ── Background modes : notifications push ─────────────────────────── -->
		<!-- Export : HTTPS et empreintes uniquement, algorithmes du système —
		     exemptés. Sans cette clé, chaque build attend une réponse manuelle
		     dans App Store Connect avant d'être testable. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
			<string>fetch</string>
		</array>
		<!-- ── Flutter / Firebase ────────────────────────────────────────────── -->
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict/>
		</dict>
	</dict>
</plist>
